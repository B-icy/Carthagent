// Development container for Carthagent. Mirrors the CI toolchain in
// .github/workflows/ci.yml: Node.js 24, Python 3.11 with Pillow 11.3.0 for
// `npm run test:python`, and Bun 1.4.2 for `npm run test:native-navigation`.
{
  "name": "Carthagent",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "BUN_VERSION": "1.4.2"
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11",
      "installTools": false
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "containerEnv": {
    // The passive release check doubles as the anonymous install ping;
    // development containers must not register as installs.
    "CARTHAGENT_NO_UPDATE_CHECK": "1"
  },
  "postCreateCommand": "npm ci && python3 -m pip install --user Pillow==11.3.0",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Carthagent dashboard (npm start, CARTHAGENT_PORT)",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "ms-python.python"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "prettier.requireConfig": true,
        "eslint.useFlatConfig": true,
        "eslint.validate": ["javascript", "typescript", "typescriptreact"],
        "files.eol": "\n",
        "[python]": {
          "editor.formatOnSave": false
        },
        "[markdown]": {
          "editor.formatOnSave": false
        },
        "[json]": {
          "editor.formatOnSave": false
        },
        "[jsonc]": {
          "editor.formatOnSave": false
        }
      }
    }
  },
  "remoteUser": "node"
}
