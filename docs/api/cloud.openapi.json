    "/v1/account/sessions/{sessionId}": {
      "delete": {
        "operationId": "revokeAccountSession",
        "tags": [
          "account"
        ],
        "summary": "Revoke one CLI session of the account",
        "security": [
          {
            "bearerAuth": [
              "account:read"
            ]
          }
        ],
        "x-carthagent-auth": "bearer:account:read",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "revoked",
                    "sessionId"
                  ],
                  "properties": {
                    "revoked": {
                      "const": true
                    },
                    "sessionId": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "`invalid_token` (malformed or badly signed) or `revoked_token` (session revoked).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "`insufficient_scope`: the access token lacks the required scope.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "`session_not_found`: unknown, foreign or already revoked session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "`expired_token`.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/billing/checkout": {
      "post": {
        "operationId": "createCheckout",
        "tags": [
          "billing"
        ],
        "summary": "Create a Stripe Checkout session for a subscription",
        "security": [
          {
            "bearerAuth": [
              "account:read"
            ]
          }
        ],
        "x-carthagent-auth": "bearer:account:read",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "successUrl": {
                    "type": "string",
                    "format": "uri"
                  },
                  "cancelUrl": {
                    "type": "string",
                    "format": "uri"
                  },
                  "priceId": {
                    "type": "string",
                    "description": "Stripe price ID or plan name; defaults to the configured price."
                  },
                  "planId": {
                    "type": "string",
                    "description": "Alias for priceId."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Checkout session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StripeSession"
                }
              }
            }
          },
          "400": {
            "description": "`billing_not_configured`, an unknown price, or a token failure (`invalid_token`, `expired_token`, `revoked_token`, `insufficient_scope`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/billing/portal": {
      "post": {
        "operationId": "createBillingPortal",
        "tags": [
          "billing"
        ],
        "summary": "Create a Stripe customer portal session",
        "security": [
          {
            "bearerAuth": [
              "account:read"
            ]
          }
        ],
        "x-carthagent-auth": "bearer:account:read",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "returnUrl": {
                    "type": "string",
                    "format": "uri"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Portal session.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StripeSession"
                }
              }
            }
          },
          "400": {
            "description": "`billing_not_configured`, `stripe_customer_not_found`, or a token failure.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/webhooks/stripe": {
      "post": {
        "operationId": "stripeWebhook",
        "tags": [
          "billing"
        ],
        "summary": "Receive a signed Stripe event",
        "description": "The raw body is verified against the `stripe-signature` header (5 minute tolerance) before processing. Events are idempotent by Stripe event ID.",
        "security": [],
        "x-carthagent-auth": "stripe-signature",
        "parameters": [
          {
            "name": "stripe-signature",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "description": "Stripe event, verified as raw bytes (256 KB limit)."
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Event processed, or a duplicate was ignored.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "duplicate"
                  ],
                  "properties": {
                    "duplicate": {
                      "type": "boolean"
                    },
                    "processed": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing or invalid signature, or a malformed event.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "HS256 JWT",
        "description": "Access token from /v1/device/token or /v1/token/refresh. Scopes are carried in the `scope` claim: `models:read`, `gateway:invoke`, `account:read`. Sessions can be revoked server-side."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string",
            "description": "Error code, for example `invalid_grant`."
          }
        }
      },
      "GatewayError": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "message",
              "type",
              "code"
            ],
            "properties": {
              "message": {
                "type": "string"
              },
              "type": {
                "type": "string"
              },
              "code": {
                "type": "string"
              }
            }
          }
        }
      },
      "DeviceAuthorization": {
        "type": "object",
        "required": [
          "deviceCode",
          "userCode",
          "verificationUri",
          "verificationUriComplete",
          "expiresIn",
          "interval"
        ],
        "properties": {
          "deviceCode": {
            "type": "string",
            "description": "Secret polled by the CLI (`ctgd_` prefix)."
          },
          "userCode": {
            "type": "string",
            "description": "Code the user confirms in the browser (`XXXXX-XXXXX`)."
          },
          "verificationUri": {
            "type": "string",
            "format": "uri"
          },
          "verificationUriComplete": {
            "type": "string",
            "format": "uri"
          },
          "expiresIn": {
            "type": "integer",
            "description": "Seconds."
          },
          "interval": {
            "type": "integer",
            "description": "Minimum polling interval in seconds."
          }
        }
      },
      "TokenResponse": {
        "type": "object",
        "required": [
          "accessToken",
          "tokenType",
          "expiresIn",
          "refreshToken",
          "scope"
        ],
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "tokenType": {
            "const": "Bearer"
          },
          "expiresIn": {
            "type": "integer"
          },
          "refreshToken": {
            "type": "string",
            "description": "Rotating refresh token (`ctgr_` prefix)."
          },
          "scope": {
            "type": "string",
            "description": "Space-separated scopes."
          }
        }
      },
      "ModelList": {
        "type": "object",
        "required": [
          "object",
          "data"
        ],
        "properties": {
          "object": {
            "const": "list"
          },
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "object",
                "created",
                "owned_by"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "object": {
                  "const": "model"
                },
                "created": {
                  "type": "integer"
                },
                "owned_by": {
                  "const": "carthagent"
                }
              }
            }
          }
        }
      },
      "GatewayRequest": {
        "type": "object",
        "required": [
          "model"
        ],
        "properties": {
          "model": {
            "type": "string",
            "description": "Gateway model alias from /v1/models."
          }
        },
        "additionalProperties": true
      },
      "Balance": {
        "type": "object",
        "required": [
          "currency",
          "availableNanoUsd"
        ],
        "properties": {
          "currency": {
            "const": "USD"
          },
          "availableNanoUsd": {
            "type": "integer"
          }
        }
      },
      "Grant": {
        "type": "object",
        "required": [
          "id",
          "originalNanoUsd",
          "remainingNanoUsd",
          "expiresAt",
          "source",
          "createdAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "originalNanoUsd": {
            "type": "integer"
          },
          "remainingNanoUsd": {
            "type": "integer"
          },
          "expiresAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          }
        }
      },
      "Session": {
        "type": "object",
        "required": [
          "id",
          "scopes",
          "client_name",
          "expires_at",
          "created_at",
          "last_used_at",
          "revoked_at"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "scopes": {
            "type": "string"
          },
          "client_name": {
            "type": "string"
          },
          "expires_at": {
            "type": "integer"
          },
          "created_at": {
            "type": "string"
          },
          "last_used_at": {
            "type": "string"
          },
          "revoked_at": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Subscription": {
        "type": "object",
        "description": "Subscription row, or `{account_id, status: \"none\"}` when the account has none.",
        "required": [
          "account_id",
          "status"
        ],
        "properties": {
          "account_id": {
            "type": "string"
          },
          "stripe_customer_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "stripe_subscription_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "stripe_price_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string"
          },
          "current_period_start": {
            "type": [
              "integer",
              "null"
            ]
          },
          "current_period_end": {
            "type": [
              "integer",
              "null"
            ]
          },
          "updated_at": {
            "type": "string"
          }
        }
      },
      "Account": {
        "type": "object",
        "required": [
          "accountId",
          "email",
          "balance",
          "grants",
          "subscription",
          "sessions"
        ],
        "properties": {
          "accountId": {
            "type": "string"
          },
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "balance": {
            "$ref": "#/components/schemas/Balance"
          },
          "grants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Grant"
            }
          },
          "subscription": {
            "$ref": "#/components/schemas/Subscription"
          },
          "sessions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Session"
            }
          }
        }
      },
      "UsageEntry": {
        "type": "object",
        "required": [
          "createdAt",
          "alias",
          "inputTokens",
          "outputTokens",
          "status",
          "chargeNanoUsd",
          "gatewayRequestId",
          "gatewayAttemptId"
        ],
        "properties": {
          "createdAt": {
            "type": "string"
          },
          "alias": {
            "type": [
              "string",
              "null"
            ]
          },
          "inputTokens": {
            "type": [
              "integer",
              "null"
            ]
          },
          "outputTokens": {
            "type": [
              "integer",
              "null"
            ]
          },
          "status": {
            "type": [
              "string",
              "null"
            ]
          },
          "chargeNanoUsd": {
            "type": "integer"
          },
          "gatewayRequestId": {
            "type": [
              "string",
              "null"
            ]
          },
          "gatewayAttemptId": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "StripeSession": {
        "type": "object",
        "required": [
          "url",
          "id"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "id": {
            "type": "string"
          }
        }
      }
    }
  }
}
