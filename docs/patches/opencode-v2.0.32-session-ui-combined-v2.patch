+    expect(SplitBorder.customBorderChars).toEqual({
+      topLeft: "+", bottomLeft: "+", vertical: "|", topRight: "+", bottomRight: "+",
+      horizontal: "-", bottomT: "+", topT: "+", cross: "+", leftT: "+", rightT: "+",
+    })
+
+    process.env.CTG_TUI_GLYPHS = "unicode"
+    // Border characters are resolved at render time, so explicit Unicode remains intact.
+    expect(SplitBorder.customBorderChars).toEqual({ ...EmptyBorder, vertical: "┃" })
+
+    const entry = fileURLToPath(new URL("../src/component/spinner-frames.ts", import.meta.url))
+    for (const [mode, expected] of [
+      ["ascii", ["-", "\\", "|", "/"]],
+      ["unicode", ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"]],
