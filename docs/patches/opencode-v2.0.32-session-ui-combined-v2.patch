+    expect(glyphMode()).toBe("ascii")
+    expect(chromeGlyph("✓")).toBe("+")
+    expect(chromeGlyph("✗")).toBe("x")
+    expect(chromeGlyph("◈")).toBe("@")
+    expect(chromeGlyph("┃")).toBe("|")
+    expect(chromeGlyph("·")).toBe(".")
+    expect(chromeGlyph("−")).toBe("-")
+    expect(chromeGlyph("—")).toBe("-")
+    expect(chromeLabel("Searching…")).toBe("Searching...")
+    expect(chromeLabel("literal user title…")).toBe("literal user title…")
+    for (const label of [
+      "Run a command…", "Ask anything…", "Searching…", "Search worktrees…",
+      "Search sessions and projects…", "Connecting …", "Searching sessions…", "Loading sessions…",
+      "Writing debug snapshot…", "Checking for updates…", "Loading skills…", "Gathering your stats…",
+      "Restarting service…", "Connection lost…", "Receiving code…", "Waiting for code…",
+      "Waiting for output…", "Loading worktrees…", "Refreshing sessions and projects…", "Creating worktree…",
+      "Loading server information…", "Starting command…", "Waiting for command to finish…",
+      "Starting authorization…", "Waiting for authorization…", "Opening link…", "Finishing startup…",
+      "Loading plugins…", "Loading image…", "Loading session history…", "Writing command…",
+      "Fetching from the web…", "Delegating…", "Preparing edit…", "Forking session…", "Resolving diff…",
+      "Loading branches…", "Choose…", "Loading diff…", "processing…", "Working…", "Search sessions…",
+      "Loading output…", "Searching content…", "Reading file…", "Preparing write…", "Finding files…",
+      "Searching web…", "Asking questions…", "Loading skill…", "Waiting for permission event…", "Waiting…",
+      "No matching files…",
+    ]) expect(chromeLabel(label)).not.toContain("…")
+    expect(chromeGlyph("model text ✓ stays intact")).toBe("model text ✓ stays intact")
+    for (const glyph of ["→", "←", "↳", "↻", "⟳", "✱", "◈", "⚙", "✓", "✗", "×", "•", "●", "▪", "■", "◉", "△", "›", "┃", "│", "…", "↑", "↓", "├", "└", "─"])
+      expect(chromeGlyph(glyph)).toMatch(/^[\x00-\x7f]+$/)
+  })
+
+  test("selects ASCII spinner and border chrome without changing Unicode defaults", async () => {
