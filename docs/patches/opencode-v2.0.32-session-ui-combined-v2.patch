+import { expect, test } from "bun:test"
+import { PRODUCT_NAME, productTerminalTitle } from "../src/product"
+import { logo, go } from "../src/logo"
+import { ASCII_LOGO } from "../src/ui/glyphs"
+
+test("Carthagent owns home, session, plugin and compact terminal titles", () => {
+  expect(PRODUCT_NAME).toBe("Carthagent")
+  expect(productTerminalTitle()).toBe("Carthagent")
+  expect(productTerminalTitle("Fix Ship login")).toBe("CTG | Fix Ship login")
+  expect(productTerminalTitle("workspace")).toBe("CTG | workspace")
+  const prior = process.env.CTG_TUI_GLYPHS
+  try {
+    process.env.CTG_TUI_GLYPHS = "ascii"
+    expect(productTerminalTitle("x".repeat(60))).toBe(`CTG | ${"x".repeat(37)}...`)
+  } finally {
+    if (prior === undefined) delete process.env.CTG_TUI_GLYPHS
+    else process.env.CTG_TUI_GLYPHS = prior
+  }
+})
+
+test("Carthagent wordmark supports wide, stacked and compact layouts", () => {
+  expect(logo.left).toHaveLength(4)
+  expect(logo.right).toHaveLength(4)
+  expect(logo.left.slice(1).every(line => line.length > 0)).toBe(true)
+  expect(logo.right.slice(1).every(line => line.length > 0)).toBe(true)
+  expect(go.right.slice(1)).toContain("CTG")
+})
+
+
+test("ASCII and compact startup wordmarks do not retain upstream branding", () => {
+  expect((ASCII_LOGO.left[1] + ASCII_LOGO.right[1]).replaceAll(" ", "")).toBe("CARTHAGENT")
+  expect(ASCII_LOGO.compact[1].trim()).toBe("CTG")
+})
