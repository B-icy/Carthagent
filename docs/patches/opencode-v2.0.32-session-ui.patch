 import type { CliRenderer } from "@opentui/core"
 
-export function destroyRenderer(renderer: Pick<CliRenderer, "isDestroyed" | "setTerminalTitle" | "destroy">) {
-  renderer.setTerminalTitle("")
-  if (renderer.isDestroyed) return
-  renderer.destroy()
+type Write = (data: string) => unknown
+type TitleRenderer = Pick<CliRenderer, "isDestroyed" | "setTerminalTitle" | "destroy">
+
+const SAVE_TITLE = "\x1b[22;0t"
+const RESTORE_TITLE = "\x1b[23;0t"
+const saved = new WeakSet<object>()
+const restored = new WeakSet<object>()
+
+export function saveTerminalTitle(write: Write = (data) => process.stdout.write(data)) {
+  write(SAVE_TITLE)
+}
+
+export function trackSavedTerminalTitle(renderer: TitleRenderer) {
+  saved.add(renderer)
+}
+
+export function restoreUnacquiredTerminalTitle(write: Write = (data) => process.stdout.write(data)) {
+  write(RESTORE_TITLE)
+}
+
+export function destroyRenderer(renderer: TitleRenderer, write: Write = (data) => process.stdout.write(data)) {
+  if (restored.has(renderer)) return
+  restored.add(renderer)
+  try {
+    renderer.setTerminalTitle("")
+    if (!renderer.isDestroyed) renderer.destroy()
+  } finally {
+    if (saved.has(renderer)) restoreUnacquiredTerminalTitle(write)
+  }
+}
+
+export function destroyUnacquiredRenderer(write: Write = (data) => process.stdout.write(data)) {
+  restoreUnacquiredTerminalTitle(write)
 }
