index 0000000000..fb01b79e10
--- /dev/null
+++ b/packages/core/src/plugin/carthagent.ts
@@ -0,0 +1,79 @@
+export * as CarthagentPlugin from "./carthagent.js"
+
+import { define } from "@opencode/plugin/effect/plugin"
+import { Agent } from "@opencode/schema/agent"
+import { Effect, Schema } from "effect"
+
+const ship = Agent.ID.make("ship")
+const lite = Agent.ID.make("lite")
+
+const PROMPT_SHIP = `You are Carthagent Ship, an evidence-driven delivery agent.
+
+Before writing any code, strategize: state the goal, the approach, and the concrete acceptance checks you will run to prove the work. Then execute. Before claiming the work is done, validate: run the checks you named (tests, builds, type checks, or real end-to-end runs) and report the evidence. Do not declare success on intent alone.
+
+Track the plan with the todowrite tool: one item per step or acceptance check, and keep each item's status current as you work.
+
+- Keep output terse.
+- Prefer minimal, focused edits in the existing style.
+- If validation fails, fix and re-run; report honest failures.
+- Ask before major design decisions or destructive actions.`
+
+const PROMPT_LITE = `You are a direct execution agent. Use the skills and tools already available and work the task directly. No extra planning ceremony, no harness phases — just do the work well and concisely.`
+
+const TodoItem = Schema.Struct({
+  content: Schema.NonEmptyString.annotate({ description: "One step or acceptance check" }),
+  status: Schema.Literals(["pending", "in_progress", "completed", "cancelled"]).annotate({
+    description: "Current status of the item",
+  }),
+})
+
+const TodoInput = Schema.Struct({
+  todos: Schema.Array(TodoItem).check(Schema.isNonEmpty()).annotate({
+    description: "The full plan, replacing any previously recorded plan",
+  }),
+})
+
+export const Plugin = define({
+  id: "carthagent.agents",
+  effect: Effect.fn(function* (ctx) {
+    yield* ctx.agent.transform((editor) => {
+      editor.update(ship, (item) => {
+        item.name = Agent.Name.make("Ship")
+        item.description = "Carthagent delivery workflow: strategize, execute, validate with evidence."
+        item.mode = "primary"
+        item.color = "#e6c480"
+        item.system = PROMPT_SHIP
+        item.permissions.push({ action: "question", resource: "*", effect: "allow" })
+      })
+
+      editor.update(lite, (item) => {
+        item.name = Agent.Name.make("Lite")
+        item.description = "Direct execution with existing skills and tools. No planning harness."
+        item.mode = "primary"
+        item.color = "#b89ce0"
+        item.system = PROMPT_LITE
+        item.permissions.push({ action: "question", resource: "*", effect: "allow" })
+      })
+
+      editor.default(ship)
+    })
+
+    yield* ctx.tool
+      .transform((editor) =>
+        editor.add({
+          name: "todowrite",
+          description:
+            "Record the working plan for this task: one item per step or acceptance check. Call it once the plan is set and again whenever an item's status changes — it replaces the recorded plan.",
+          input: TodoInput,
+          output: TodoInput,
+          execute: (input) =>
+            Effect.succeed({
+              output: { todos: input.todos },
+              content: `Plan recorded: ${input.todos.length} item${input.todos.length === 1 ? "" : "s"}.`,
+              metadata: { todos: input.todos },
+            }),
+        }),
+      )
+      .pipe(Effect.orDie)
+  }),
+})
