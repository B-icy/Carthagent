diff --git a/packages/tui/src/routes/session/plan-view.tsx b/packages/tui/src/routes/session/plan-view.tsx
new file mode 100644
index 0000000000..607261da8a
--- /dev/null
+++ b/packages/tui/src/routes/session/plan-view.tsx
@@ -0,0 +1,138 @@
+import { For, Show, createMemo, createSignal } from "solid-js"
+import { useTheme } from "../../context/theme"
+import { Locale } from "../../util/locale"
+import type { SessionMessageInfo } from "@opencode/client"
+
+export const [planGraphVisible, setPlanGraphVisible] = createSignal(false)
+
+export function togglePlanGraph() {
+  setPlanGraphVisible((visible) => !visible)
+}
+
+type PlanItem = { content: string; status: string }
+
+function planItems(messages: SessionMessageInfo[]): PlanItem[] {
+  for (const message of [...messages].reverse()) {
+    if (message.type !== "assistant") continue
+    for (const part of [...message.content].reverse()) {
+      if (part.type !== "tool") continue
+      const todos = planTodos(part)
+      if (todos) return todos
+    }
+  }
+  return []
+}
+
+// The plan can be recorded directly (part named todowrite) or through the
+// codemode `execute` wrapper, which lists each sub-call in metadata.toolCalls.
+function planTodos(part: { name: string; state: unknown }): PlanItem[] | undefined {
+  if (part.name === "todowrite") return parseTodos(partInput(part.state)?.todos)
+  if (part.name !== "execute") return undefined
+  const calls = partMetadata(part.state)?.toolCalls
+  if (!Array.isArray(calls)) return undefined
+  for (const call of [...calls].reverse()) {
+    if (!call || typeof call !== "object") continue
+    const entry = call as { tool?: unknown; input?: unknown }
+    if (entry.tool !== "todowrite" || !entry.input || typeof entry.input !== "object") continue
+    const todos = parseTodos((entry.input as { todos?: unknown }).todos)
+    if (todos) return todos
+  }
+  return undefined
+}
+
+function partInput(state: unknown) {
+  if (!state || typeof state !== "object" || !("input" in state)) return undefined
+  const input = (state as { input?: unknown }).input
+  return input && typeof input === "object" ? (input as { todos?: unknown }) : undefined
+}
+
+function partMetadata(state: unknown) {
+  if (!state || typeof state !== "object" || !("metadata" in state)) return undefined
+  const metadata = (state as { metadata?: unknown }).metadata
+  return metadata && typeof metadata === "object" && !Array.isArray(metadata)
+    ? (metadata as { toolCalls?: unknown })
+    : undefined
+}
+
+function parseTodos(todos: unknown): PlanItem[] | undefined {
+  if (!Array.isArray(todos)) return undefined
+  return todos.flatMap((todo) => {
+    if (!todo || typeof todo !== "object") return []
+    const item = todo as { content?: unknown; status?: unknown }
+    if (typeof item.content !== "string" || !item.content.trim()) return []
+    return [{ content: item.content.trim(), status: typeof item.status === "string" ? item.status : "pending" }]
+  })
+}
+
+const STATUS_ORDER = ["completed", "in_progress", "pending", "cancelled"]
+
+export function PlanView(props: { messages: () => SessionMessageInfo[] }) {
+  const theme = useTheme()
+  const items = createMemo(() => planItems(props.messages()))
+
+  const nodeColor = (status: string) =>
+    status === "completed"
+      ? theme.text.feedback.success.base
+      : status === "in_progress"
+        ? theme.text.action.secondary.base
+        : status === "cancelled"
+          ? theme.text.muted
+          : theme.text.base
+
+  const glyph = (status: string) =>
+    status === "completed" ? "■" : status === "in_progress" ? "◐" : status === "cancelled" ? "×" : "□"
+
+  const counts = createMemo(() => {
+    const tally = new Map<string, number>()
+    for (const item of items()) tally.set(item.status, (tally.get(item.status) ?? 0) + 1)
+    return STATUS_ORDER.filter((status) => tally.has(status)).map(
+      (status) => `${tally.get(status)} ${status.replace("_", " ")}`,
+    )
+  })
+
+  return (
+    <box flexGrow={1} minHeight={0} paddingTop={1} paddingLeft={1} flexDirection="column">
+      <box flexDirection="row" gap={1} flexShrink={0}>
+        <text fg={theme.text.base} attributes={1}>
+          SHIP PLAN
+        </text>
+        <Show when={counts().length > 0}>
+          <text fg={theme.text.muted}>{counts().join(" · ")}</text>
+        </Show>
+      </box>
+      <Show
+        when={items().length > 0}
+        fallback={
+          <box paddingTop={1} flexShrink={0}>
+            <text fg={theme.text.muted}>No plan yet. Ship records its plan here as it works.</text>
+          </box>
+        }
+      >
+        <For each={items()}>
+          {(item, index) => (
+            <>
+              <Show when={index() > 0}>
+                <box paddingLeft={1} flexShrink={0}>
+                  <text fg={theme.border.base}>│</text>
+                </box>
+              </Show>
+              <box flexDirection="row" gap={1} flexShrink={0}>
+                <text fg={nodeColor(item.status)}>{glyph(item.status)}</text>
+                <text fg={nodeColor(item.status)} wrapMode="word">
+                  {item.content}
+                </text>
+                <Show when={item.status !== "pending" && item.status !== "completed"}>
+                  <text fg={theme.text.muted}>{Locale.titlecase(item.status.replace("_", " "))}</text>
+                </Show>
+              </box>
+            </>
+          )}
+        </For>
+      </Show>
+      <box flexGrow={1} minHeight={0} />
+      <box flexShrink={0}>
+        <text fg={theme.text.muted}>ctrl+x p or /graph returns to chat</text>
+      </box>
+    </box>
+  )
+}
