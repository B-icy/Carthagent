+export function TranscriptProvider(props: ParentProps) {
+  const value = createTranscriptHost(useData())
+  return <Transcript.Provider value={value}>{props.children}</Transcript.Provider>
+}
+
+export function createTranscriptHost(data: ReturnType<typeof useData>) {
+  const [persisted, persist] = useStorage().store<Record<string, { before?: string }>>("transcript-presentation", {
+    initial: {},
+  })
+  return {
+    before: (sessionID: string) => persisted[sessionID]?.before,
+    clear(sessionID: string) {
+      const before = data.session.message.list(sessionID).at(-1)?.id
+      return {
+        before,
+        persist: () =>
+          persist((draft) => {
+            if (before) draft[sessionID] = { before }
+            else delete draft[sessionID]
+          }),
+      }
+    },
+  }
+}
+
+export function useTranscript() {
+  const value = useContext(Transcript)
+  if (!value) throw new Error("TranscriptProvider is missing")
+  return value
+}
