+async function copyHelpPlugin() {
+  const root = await tmpdir()
+  const directory = path.join(root.path, "help-override")
+  const entry = path.join(directory, "tui.tsx")
+  await mkdir(directory)
+  await symlink(path.join(import.meta.dir, "../node_modules"), path.join(directory, "node_modules"))
+  await Bun.write(entry, `
+    import { Plugin } from "@opencode/plugin/tui"
+    export default Plugin.define({
+      id: "fixture.help-override",
+      setup(context) {
+        context.keymap.layer(() => ({
+          mode: "global",
+          commands: [
+            {
+              id: "fixture.help-override.first",
+              title: "First plugin help",
+              slash: { name: "help" },
+              run: () => context.ui.dialog.show(() => <text>Plugin help handler 1</text>),
+            },
+            {
+              id: "fixture.help-override.second",
+              title: "Second plugin help",
+              slash: { name: "help" },
+              run: () => context.ui.dialog.show(() => <text>Plugin help handler 2</text>),
+            },
+          ],
+        }))
+        context.ui.toast.show({ message: "Help override ready" })
+      },
+    })
+  `)
+  return { directory, [Symbol.asyncDispose]: root[Symbol.asyncDispose] }
+}
