+import { createNavigationState } from "../src/context/navigation"
+import { takeDraft } from "../src/component/prompt/draft-stash"
+
+test("owned navigation registrations validate, replace safely, and cannot select another owner's pane", () => {
+  const persisted: unknown[] = []
+  let reveals = 0
+  const state = createNavigationState({ persist: (value) => persisted.push(value), reveal: () => { reveals++ } })
+  const pane = { name: "voyages", title: "Voyages", render: () => null }
+  for (const name of ["projects", "Projects", "", "a b"]) expect(() => state.register("one", { ...pane, name })).toThrow()
+  for (const title of ["", "  ", "bad\nlabel"]) expect(() => state.register("one", { ...pane, title })).toThrow()
+  const old = state.register("one", pane)
+  expect(state.select("two", "voyages")).toBe(false)
+  expect(reveals).toBe(0)
+  expect(state.select("one", "voyages")).toBe(true)
+  const replacement = state.register("one", pane)
+  old()
+  expect(state.current()?.owner).toBe("one")
+  expect(state.panes()).toHaveLength(1)
+  replacement()
+  replacement()
+  expect(state.current()).toBeUndefined()
+  expect(state.panes()).toHaveLength(0)
+  expect(persisted.at(-1)).toBeUndefined()
+})
+
+test("real app mode switching retains the session, draft, Projects scroll and folder collapse without session mutations", async () => {
+  await using plugin = await copyPlugin()
+  takeDraft("ses_navigation_0")
+  await using setup = await fixture(plugin.directory, true)
+  await ready(setup)
+  await setup.waitFor(() => descendants(node(setup, "navigation-projects")).some((item) => item instanceof TextRenderable && item.plainText === "Collapsed fixture"))
+  const prompt = setup.renderer.currentFocusedEditor
+  expect(prompt).toBeInstanceOf(TextareaRenderable)
+  if (!(prompt instanceof TextareaRenderable)) throw new Error("Missing prompt")
+  await setup.mockInput.typeText("navigation draft sentinel")
+  const projects = node(setup, "navigation-projects")
+  const collapsed = descendants(projects).find((item) => item instanceof TextRenderable && item.plainText === "Collapsed fixture")
+  if (!collapsed?.parent) throw new Error("Missing collapsed native folder")
+  const folderHeader = collapsed.parent
+  expect(descendants(folderHeader).some((item) => item instanceof TextRenderable && item.plainText === "▸")).toBe(true)
+  expect(descendants(projects).some((item) => item instanceof TextRenderable && item.plainText === "Navigation session 24")).toBe(false)
+  const scroll = descendants(projects).find((item) => item instanceof ScrollBoxRenderable)
+  if (!(scroll instanceof ScrollBoxRenderable)) throw new Error("Missing Projects scroll")
+  scroll.scrollTo(20)
+  await setup.flush()
+  const top = scroll.scrollTop
+  expect(top).toBeGreaterThan(0)
+  const session = node(setup, "session-pane")
+  setup.mockInput.pressKey("v", { meta: true })
+  await setup.waitForFrame((frame) => frame.includes("Voyage selection 0"))
+  expect(node(setup, "session-pane")).toBe(session)
+  expect(setup.renderer.currentFocusedEditor).toBe(prompt)
+  expect(prompt.plainText).toBe("navigation draft sentinel")
+  expect(setup.captureCharFrame()).toContain("30:false:true:false:")
+  setup.mockInput.pressKey("p", { meta: true })
+  await setup.waitForFrame((frame) => frame.includes("Projects") && !frame.includes("Voyage selection 0"))
+  expect(node(setup, "navigation-projects")).toBe(projects)
+  expect(scroll.scrollTop).toBe(top)
+  expect(prompt.plainText).toBe("navigation draft sentinel")
+
+  // The fixture includes a persisted collapsed native folder; toggling modes must not expand it.
+  expect(descendants(projects)).toContain(folderHeader)
+  setup.mockInput.pressKey("F6")
+  await setup.waitForFrame((frame) => frame.includes("Voyage selection"))
+  setup.mockInput.pressKey("p", { meta: true })
+  await setup.waitForFrame((frame) => !frame.includes("Voyage selection"))
+  expect(scroll.scrollTop).toBe(top)
+  expect(descendants(projects)).toContain(folderHeader)
+  expect(descendants(folderHeader).some((item) => item instanceof TextRenderable && item.plainText === "▸")).toBe(true)
+  expect(node(setup, "session-pane")).toBe(session)
+  expect(prompt.plainText).toBe("navigation draft sentinel")
+  expect(setup.mutations).toEqual([])
+})
+
+test("zero-session home, plugin detail, explicit focus, Escape and dialog mode are isolated", async () => {
+  await using plugin = await copyPlugin()
+  await using setup = await fixture(plugin.directory)
+  await ready(setup)
+  const prompt = setup.renderer.currentFocusedEditor
+  setup.mockInput.pressKey("F6")
