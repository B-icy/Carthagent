+/** @jsxImportSource @opentui/solid */
+import { expect, test } from "bun:test"
+import { testRender } from "@opentui/solid"
+import { createSignal } from "solid-js"
+import type { SessionMessageInfo } from "@opencode/client"
+import { PlanView, planGraphVisible, togglePlanGraph } from "../../src/routes/session/plan-view"
+import { ConfigProvider } from "../../src/config"
+import { createTuiResolvedConfig } from "../fixture/tui-runtime"
+import { ThemeProvider } from "../../src/context/theme"
+import { emptyThemeSource } from "../fixture/fixture"
+import { TestTuiContexts } from "../fixture/tui-environment"
+
+function message(name: string, items: Array<{ content: string; status: string }>): SessionMessageInfo {
+  return {
+    id: "msg-plan",
+    type: "assistant",
+    agent: "ship",
+    model: { providerID: "fixture", id: "fixture" },
+    time: { created: 1 },
+    content: [
+      {
+        type: "tool",
+        id: "tool-plan",
+        name,
+        time: { created: 1 },
+        state: {
+          status: "completed",
+          input: {},
+          content: [{ type: "text", text: "Plan recorded" }],
+          metadata: {
+            deliveryPlan: {
+              runId: "fixture-plan",
+              revision: 1,
+              items: items.map((item, index) => ({ id: String(index), ...item })),
+            },
+          },
+        },
+      },
+    ],
+  }
+}
+
+test.each([
+  ["carthagent_delivery_plan", "unicode"],
+  ["execute", "unicode"],
+  ["execute", "ascii"],
+])("plan view updates from %s in %s mode without remounting", async (name, mode) => {
+  const previousMode = process.env.CTG_TUI_GLYPHS
+  process.env.CTG_TUI_GLYPHS = mode
+  const [messages, update] = createSignal<SessionMessageInfo[]>([])
+  const app = await testRender(
+    () => (
+      <TestTuiContexts>
+        <ConfigProvider config={createTuiResolvedConfig()}>
+          <ThemeProvider mode="dark" source={emptyThemeSource}>
+            <PlanView messages={messages} />
+          </ThemeProvider>
+        </ConfigProvider>
+      </TestTuiContexts>
+    ),
+    { width: 90, height: 15 },
+  )
+  try {
+    await app.waitForFrame((frame) => frame.includes("No plan yet"))
+    update([
+      message(name, [
+        { content: "Check λ input", status: "active" },
+        { content: "Run checks", status: "pending" },
+      ]),
+    ])
+    await app.waitForFrame((frame) => frame.includes("Check λ input") && frame.includes("1 in progress"))
+    update([
+      message(name, [
+        { content: "Check λ input", status: "done" },
+        { content: "Run checks", status: "done" },
+      ]),
+    ])
+    await app.waitForFrame((frame) => frame.includes("2 completed"))
+    expect(app.captureCharFrame()).not.toContain("in progress")
+    if (mode === "ascii") expect(app.captureCharFrame()).not.toMatch(/[■◐□│]/)
+  } finally {
+    app.renderer.destroy()
+    if (previousMode === undefined) delete process.env.CTG_TUI_GLYPHS
+    else process.env.CTG_TUI_GLYPHS = previousMode
+  }
+})
+
+test("plan graph toggles back to the transcript", () => {
+  expect(planGraphVisible()).toBe(false)
+  togglePlanGraph()
+  expect(planGraphVisible()).toBe(true)
+  togglePlanGraph()
+  expect(planGraphVisible()).toBe(false)
+})
