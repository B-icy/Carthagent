+import { OptimizedBuffer, RGBA, Renderable, type RenderContext, type RenderableOptions } from "@opentui/core"
+import { extend } from "@opentui/solid"
+import { useConfig } from "../config"
+import { useTheme } from "../context/theme"
+
+// Carthaginian quadrireme at dusk, drawn on a pixel grid at two pixels per cell.
+const SHIP = [
+  "..............................m...............................",
+  ".................mmmmmmmmmmmmmmmmmmmmmmmmmmmmm................",
+  "..................sssssssssssssssssssssssssss.................",
+  "...hhh............Sssssssssssssssssssssssssss.................",
+  "..h...h...........Ppppppppppppppppppppppppppp.................",
+  "..h....h..........Sssssssssssssssssssssssssss.................",
+  "...dd..h..........Sssssssssssssssssssssssssss.................",
+  ".......h..........Ppppppppppppppppppppppppppp.................",
+  ".......hh.........Sssssssssssssssssssssssssss.................",
+  "........h..........SSSSSSSSSSSSSSSSSSSSSSSSS...........H......",
+  "........hh..................m.........................HH......",
+  ".........h..................m........................HHH......",
+  ".........hHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHHH......",
+  "..........HHHgHHHgHHHgHHHgHHHgHHHgHHHgHHHgHHHgHHHgHHeHH.......",
+  "...........hhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhh.......",
+  "............dddddddddddddddddddddddddddddddddddddddddddrrrrr..",
+  ".............ddddddddddddddddddddddddddddddddddddddddRR.......",
+]
+const SHIP_WIDTH = SHIP[0].length
+const WATERLINE = 15
+const ROWS = 16
+const HEIGHT = ROWS * 2
+const HORIZON = 17
+const SURFACE = 25
+const ENTRANCE = 2600
+const STROKE = 1500
+const FRAME = 70
+const EDGE = 12
+
+export function seascapeTime(elapsed: number, entrance = true) {
+  const arrival = entrance ? ENTRANCE : 0
+  return elapsed <= arrival ? elapsed : arrival + (elapsed - arrival) / 3
+}
+
+const hex = RGBA.fromHex
+const SHIP_COLORS: Record<string, RGBA> = {
+  H: hex("#e6c480"),
+  h: hex("#c9a259"),
+  d: hex("#8a6a36"),
+  g: hex("#fff0c8"),
+  s: hex("#f3e6c4"),
+  S: hex("#d6c39a"),
+  p: hex("#8a5cc2"),
+  P: hex("#6d4799"),
+  m: hex("#a8864a"),
+  e: hex("#160e20"),
+  r: hex("#c08a3e"),
+  R: hex("#8a5a2a"),
+}
+const SAIL = new Set(["s", "S", "p", "P"])
+const SKY_HORIZON = hex("#4a2d55")
+const SKY_WARM = hex("#8a4c5c")
+const SUN = hex("#f4d48e")
+const SUN_RIM = hex("#d9965a")
+const STAR = hex("#d9bf86")
+const STAR_DIM = hex("#5a4560")
+const WATER_TOP = hex("#3d2a56")
+const WATER_DEEP = hex("#1e1430")
+const CREST_FAR = hex("#5d4a86")
+const CREST_NEAR = hex("#8775b0")
+const GLINT = hex("#e6c480")
+const GLINT_DIM = hex("#9c7448")
+const FOAM = hex("#d8cdea")
+const OAR = hex("#b08e52")
+const OAR_DIM = hex("#96773f")
+
+const REFLECTED = Object.fromEntries(
+  Object.entries(SHIP_COLORS).map(([code, color]) => [code, mix(color, WATER_TOP, 0.78)]),
+)
+
+type SeascapeOptions = RenderableOptions<SeascapeRenderable> & {
+  backdrop?: RGBA
+  animated?: boolean
+  entrance?: boolean
+}
+
+class SeascapeRenderable extends Renderable {
+  private _backdrop = hex("#160e20")
+  private _animated = true
+  private _entrance = true
+  private start = performance.now()
+  private timer: ReturnType<typeof setInterval> | undefined
+  private sky: RGBA[] = []
+  private water: RGBA[] = []
+
+  constructor(ctx: RenderContext, options: SeascapeOptions) {
+    super(ctx, { ...options, height: ROWS })
+    if (options.backdrop) this._backdrop = options.backdrop
+    if (options.entrance === false) this._entrance = false
+    this.palette()
+    this.animated = options.animated ?? true
+  }
+
+  set backdrop(value: RGBA) {
+    if (value.equals(this._backdrop)) return
+    this._backdrop = value
+    this.palette()
+    this.requestRender()
+  }
+
+  set entrance(value: boolean) {
+    this._entrance = value
+  }
+
+  set animated(value: boolean) {
+    this._animated = value
+    if (this.timer) clearInterval(this.timer)
+    this.timer = value ? setInterval(() => this.requestRender(), FRAME) : undefined
+    this.requestRender()
+  }
+
+  private palette() {
+    this.sky = Array.from({ length: HORIZON }, (_, y) => {
+      const t = y / (HORIZON - 1)
+      if (t < 0.7) return mix(this._backdrop, SKY_HORIZON, t / 0.7)
+      return mix(SKY_HORIZON, SKY_WARM, (t - 0.7) / 0.3)
+    })
+    this.water = Array.from({ length: HEIGHT - HORIZON }, (_, y) =>
+      mix(WATER_TOP, mix(WATER_DEEP, this._backdrop, 0.5), y / (HEIGHT - HORIZON - 1)),
+    )
+  }
+
+  protected override renderSelf(buffer: OptimizedBuffer) {
+    const width = this.width
+    if (width <= 0) return
+    const t = this._animated ? seascapeTime(performance.now() - this.start, this._entrance) : ENTRANCE + 4000
+    const pixels: RGBA[] = new Array(width * HEIGHT)
+    const set = (x: number, y: number, color: RGBA) => {
+      if (x < 0 || x >= width || y < 0 || y >= HEIGHT) return
+      pixels[y * width + x] = color
+    }
+    const get = (x: number, y: number) => pixels[y * width + x]
+
+    const center = Math.round((width - SHIP_WIDTH) / 2)
+    const progress = this._entrance ? Math.min(1, t / ENTRANCE) : 1
+    const ease = 1 - (1 - progress) ** 3
+    const drift = progress === 1 ? Math.round(Math.sin((t - ENTRANCE) / 2400) * 1.4) : 0
+    const shipX = Math.round(-SHIP_WIDTH + (center + SHIP_WIDTH) * ease) + drift
+    const bob = Math.round(Math.sin(t / 700) * 0.7)
+    const top = SURFACE - WATERLINE + bob
+    const sunX = Math.min(width - 8, Math.max(Math.round(width * 0.8), center + SHIP_WIDTH + 10))
+    const sunR = 5
+
+    // Sky, stars and the setting sun.
+    Array.from({ length: HORIZON }, (_, y) =>
+      Array.from({ length: width }, (_, x) => {
+        const distance = Math.hypot(x - sunX, (y - HORIZON) * 2)
+        const glow = Math.max(0, 1 - distance / 28)
+        set(x, y, glow > 0 ? mix(this.sky[y], SKY_WARM, glow * 0.55) : this.sky[y])
+        if (y < HORIZON - 8 && hash(x, y) > 0.993)
+          set(x, y, hash(x, y + Math.floor(t / 900)) > 0.35 ? STAR : STAR_DIM)
+        if (Math.hypot(x - sunX, (y - HORIZON + 0.5) * 1.1) <= sunR)
+          set(x, y, Math.hypot(x - sunX, (y - HORIZON + 0.5) * 1.1) > sunR - 1.1 ? SUN_RIM : SUN)
+      }),
+    )
+
+    // Water: perspective wave crests, plus the sun's glint path.
+    Array.from({ length: HEIGHT - HORIZON }, (_, row) => {
+      const y = HORIZON + row
+      const depth = row / (HEIGHT - HORIZON - 1)
+      Array.from({ length: width }, (_, x) => {
+        const wave =
+          Math.sin(x * (0.36 - 0.22 * depth) + hash(0, row) * 40 - t * (0.0005 + 0.0015 * depth)) *
+          (0.65 + 0.35 * Math.sin(x * 0.07 + row * 3.1 + t * 0.0003))
+        set(x, y, wave > 0.74 - 0.08 * depth ? (depth > 0.45 ? CREST_NEAR : CREST_FAR) : this.water[row])
+        const spread = 2 + depth * 13
+        const offset = Math.abs(x - sunX)
+        if (offset < spread && hash(Math.floor(x / 3), y + Math.floor(t / 260)) > 0.45 + (offset / spread) * 0.5)
+          set(x, y, offset < spread * 0.45 ? GLINT : GLINT_DIM)
+      })
+    })
+
+    // Wake trailing from the stern, and foam at the ram.
+    Array.from({ length: 34 }, (_, i) => {
+      const x = shipX + 12 - i
+      const fade = 0.3 + i / 40
+      ;[SURFACE + Math.round(i * 0.12), SURFACE + 1 + Math.round(i * 0.22)].forEach((y, arm) => {
+        if (y < HEIGHT && hash(x, y * 3 + arm + Math.floor(t / 120)) > fade) set(x, y, mix(FOAM, this.water[y - HORIZON], i / 34))
+      })
+    })
+    Array.from({ length: 4 }, (_, i) => {
+      if (hash(i, Math.floor(t / 110)) > 0.4) set(shipX + SHIP_WIDTH - 3 + i, SURFACE + 1 + bob, FOAM)
+    })
+
+    // Broken reflection beneath the hull.
+    Array.from({ length: 6 }, (_, k) => {
+      const source = WATERLINE - 2 - k
+      const y = SURFACE + 2 + k + bob
+      const wobble = Math.round(Math.sin(t / 280 + k * 1.3))
+      Array.from(SHIP[source]).forEach((code, x) => {
+        if (code === "." || hash(x, k + Math.floor(t / 200)) < 0.35 + k * 0.12) return
+        set(shipX + x + wobble, y, REFLECTED[code])
+      })
+    })
+
+    // Oars: two tiers sweeping in a shared rhythm.
+    const phase = (t % STROKE) / STROKE
+    const sweep = Math.round(Math.cos(phase * Math.PI * 2) * 3.5)
+    const dipped = phase < 0.5
+    ;[
+      { row: 14, start: 13, color: OAR },
+      { row: 15, start: 15, color: OAR_DIM },
+    ].forEach((tier) =>
+      Array.from({ length: 10 }, (_, k) => {
+        const fromX = shipX + tier.start + k * 4
+        const fromY = top + tier.row
+        const toX = fromX + sweep
+        const toY = SURFACE + (dipped ? 5 : 3) + (tier.row - 14)
+        const steps = Math.max(Math.abs(toX - fromX), Math.abs(toY - fromY), 1)
+        Array.from({ length: steps + 1 }, (_, s) =>
+          set(Math.round(fromX + ((toX - fromX) * s) / steps), Math.round(fromY + ((toY - fromY) * s) / steps), tier.color),
+        )
+        if (dipped && phase < 0.12) set(toX - 1, toY - 1, FOAM)
+      }),
+    )
+
+    // Hull and sail, with the sail breathing in the wind.
+    const billow = 1 + Math.sin(t / 1900)
+    SHIP.forEach((line, row) => {
+      const codes = Array.from(line)
+      codes.forEach((code, x) => code !== "." && set(shipX + x, top + row, SHIP_COLORS[code]))
+      const last = codes.findLastIndex((code) => SAIL.has(code))
+      if (last < 0) return
+      const extra = Math.round(billow * Math.sin((Math.PI * (row - 2)) / 7))
+      Array.from({ length: Math.max(0, extra) }, (_, i) => set(shipX + last + 1 + i, top + row, SHIP_COLORS[codes[last]]))
+    })
+
+    // Fade the scene into the terminal at both edges.
+    Array.from({ length: HEIGHT }, (_, y) =>
+      Array.from({ length: width }, (_, x) => {
+        const edge = Math.min(x, width - 1 - x)
+        if (edge >= EDGE) return
+        set(x, y, mix(get(x, y), this._backdrop, 1 - edge / EDGE))
+      }),
+    )
+
+    Array.from({ length: ROWS }, (_, row) =>
+      Array.from({ length: width }, (_, x) =>
+        buffer.setCell(this.screenX + x, this.screenY + row, "▀", get(x, row * 2), get(x, row * 2 + 1)),
+      ),
+    )
+  }
+
+  override destroy() {
+    if (this.timer) clearInterval(this.timer)
+    this.timer = undefined
+    super.destroy()
+  }
+}
+
+extend({ seascape: SeascapeRenderable })
+
+declare module "@opentui/solid" {
+  interface OpenTUIComponents {
+    seascape: typeof SeascapeRenderable
+  }
+}
+
+let entered = false
+
+export const SEASCAPE_ROWS = ROWS
+
+export function Seascape() {
+  const config = useConfig().data
+  const theme = useTheme()
+  const entrance = !entered
+  entered = true
+  return (
+    <seascape
+      width="100%"
+      flexShrink={0}
+      backdrop={theme.background.base}
+      animated={config.animations ?? true}
+      entrance={entrance}
+    />
+  )
+}
+
+function mix(a: RGBA, b: RGBA, t: number) {
+  return RGBA.fromValues(a.r + (b.r - a.r) * t, a.g + (b.g - a.g) * t, a.b + (b.b - a.b) * t, 1)
+}
+
+function hash(x: number, y: number) {
+  const value = Math.sin(x * 12.9898 + y * 78.233) * 43758.5453
+  return value - Math.floor(value)
+}
