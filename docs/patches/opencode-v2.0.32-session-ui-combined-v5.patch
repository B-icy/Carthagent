+      shell.create({ shell: "/bin/sh", command: "sleep 0.03", cwd }),
+    ], { concurrency: "unbounded" })
+    const before = observed.filter((event) => event.phase === "before")
+    const after = observed.filter((event) => event.phase === "after")
+    expect(before).toHaveLength(6)
+    expect(after).toHaveLength(6)
+    expect(before).toContainEqual({ phase: "before", command: "sleep 0.03", cwd, sessionID: first, origin: "tool", callID: "call-a" })
+    expect(before).toContainEqual({ phase: "before", command: "sleep 0.03", cwd, sessionID: second, origin: "tool", callID: "call-a" })
+    expect(before).toContainEqual({ phase: "before", command: "sleep 0.03", cwd: otherCwd.path, sessionID: first, origin: "tool", callID: "call-b" })
+    expect(before).toContainEqual({ phase: "before", command: "sleep 0.03", cwd, sessionID: first, origin: "manual", callID: "manual:test" })
