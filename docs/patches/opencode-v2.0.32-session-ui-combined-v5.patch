+import { ScrollBoxRenderable, type MouseEvent } from "@opentui/core"
+import { extend } from "@opentui/solid"
+
+export class TranscriptScrollBoxRenderable extends ScrollBoxRenderable {
+  private selectionRow: number | undefined
+
+  protected override onMouseEvent(event: MouseEvent) {
+    if (event.type === "down") this.selectionRow = event.y
+    // Edge proximity alone must not turn a horizontal text selection into a vertical drag.
+    if (event.type === "drag" && event.isDragging && event.y === this.selectionRow) {
+      this.stopAutoScroll()
+      return
+    }
+    super.onMouseEvent(event)
+    if (event.type === "up" || event.type === "drag-end") this.selectionRow = undefined
+  }
+}
+
+declare module "@opentui/solid" {
+  interface OpenTUIComponents {
+    transcript_scrollbox: typeof TranscriptScrollBoxRenderable
+  }
+}
+
+extend({ transcript_scrollbox: TranscriptScrollBoxRenderable })
