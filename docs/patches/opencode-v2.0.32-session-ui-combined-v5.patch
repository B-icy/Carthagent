+    expect(after).toContainEqual(expect.objectContaining({ sessionID: first, origin: "tool", callID: "call-a" }))
+    expect(after).toContainEqual(expect.objectContaining({ sessionID: second, origin: "tool", callID: "call-a" }))
+    expect(after).toContainEqual(expect.objectContaining({ sessionID: first, origin: "tool", callID: "call-b" }))
+    expect(after).toContainEqual(expect.objectContaining({ sessionID: first, origin: "manual", callID: "manual:test" }))
+    expect(after).toContainEqual(expect.objectContaining({ sessionID: undefined, origin: undefined, callID: undefined }))
+    for (const info of created) {
+      expect(after).toContainEqual(expect.objectContaining({
