+  const ui = await mount({ width: 30, directory })
+  try {
+    await ui.app.waitForFrame((frame) => frame.includes("final-leaf/"))
+    const path = ui.row("…")
+    expect(path).toBeGreaterThanOrEqual(0)
+    expect(ui.rail()[path].trimEnd().endsWith("final-leaf")).toBe(true)
+    expect(ui.app.captureCharFrame()).not.toContain(directory)
+    await ui.app.mockMouse.moveTo(4, path)
+    await ui.app.waitForFrame((frame) => frame.includes(directory))
+    await ui.app.mockMouse.moveTo(60, 20)
+    await ui.app.waitForFrame((frame) => !frame.includes(directory))
+    await ui.app.mockMouse.click(4, path)
