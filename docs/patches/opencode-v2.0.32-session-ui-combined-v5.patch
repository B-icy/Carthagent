diff --git a/packages/tui/src/component/dialog-folder-browser.tsx b/packages/tui/src/component/dialog-folder-browser.tsx
new file mode 100644
index 0000000..6d0675d
--- /dev/null
+++ b/packages/tui/src/component/dialog-folder-browser.tsx
@@ -0,0 +1,258 @@
+import { InputRenderable, ScrollBoxRenderable, TextAttributes } from "@opentui/core"
+import { useTerminalDimensions } from "@opentui/solid"
+import { createEffect, createSignal, For, onCleanup, onMount, Show } from "solid-js"
+import type { OpenCodeClient } from "@opencode/client"
+import { useConfig } from "../config"
+import { createFolderBrowser } from "../context/folder-browser"
+import { Keymap } from "../context/keymap"
+import { useTheme } from "../context/theme"
+import { DialogHeader, DialogLayout, useDialog } from "../ui/dialog"
+import { chromeEllipsis, chromeGlyph, chromeLabel } from "../ui/glyphs"
+import { Locale } from "../util/locale"
+
+export function DialogFolderBrowser(props: {
+  file: Pick<OpenCodeClient["file"], "list">
+  /** Location the file-list API is anchored to; listed entries resolve against the returned location. */
+  anchor: string
+  home: string
+  start?: string
+  title?: string
+  onConfirm: (directory: string) => void
+  /** Embeds the browser in another dialog: Escape calls this and confirming leaves the dialog open for the caller. */
+  onCancel?: () => void
+}) {
+  const dialog = useDialog()
+  const dimensions = useTerminalDimensions()
+  const theme = useTheme().surface("dialog")
+  const config = useConfig().data
+  const browser = createFolderBrowser({
+    file: props.file,
+    location: () => ({ directory: props.anchor }),
+    home: props.home,
+  })
+  const [field, setField] = createSignal<"filter" | "path">("filter")
+  const [confirming, setConfirming] = createSignal(false)
+  let filterInput: InputRenderable | undefined
+  let pathInput: InputRenderable | undefined
+  let scroll: ScrollBoxRenderable | undefined
+  let closed = false
+  onCleanup(() => {
+    closed = true
+    browser.cancel()
+  })
+
+  const listHeight = () => Math.max(2, Math.min(12, dimensions().height - 14))
+  const width = () => Math.max(20, Math.min(dimensions().width - 2, 88) - 8)
+
+  const focusField = (next: "filter" | "path") => {
+    setField(next)
+    const target = next === "filter" ? filterInput : pathInput
+    if (target && !target.isDestroyed) target.focus()
+  }
+
+  async function confirm() {
+    if (confirming() || !browser.state.directory || browser.state.pending) return
+    const directory = browser.state.directory
+    setConfirming(true)
+    // Revalidate so a folder removed after it was listed cannot be accepted.
+    const valid = await browser.refresh()
+    setConfirming(false)
+    if (!valid || closed || browser.state.directory !== directory) return
+    if (!props.onCancel) dialog.clear()
+    props.onConfirm(directory)
+  }
+
+  const submit = () => {
+    if (field() === "path") return void browser.submit()
+    void browser.enter()
+  }
+
+  Keymap.createLayer(() => ({
+    mode: "modal",
+    // Browser navigation must win over the managed input layer and background session-tab bindings.
+    priority: 1,
+    commands: [
+      { bind: "return", title: "Open folder", group: "Folder browser", run: submit },
+      { bind: "up", title: "Previous folder", group: "Folder browser", run: () => browser.move(-1) },
+      { bind: "down", title: "Next folder", group: "Folder browser", run: () => browser.move(1) },
+      {
+        bind: "tab,shift+tab",
+        title: "Switch path and filter",
+        group: "Folder browser",
+        run: () => focusField(field() === "filter" ? "path" : "filter"),
+      },
+      { bind: "alt+left", title: "Back", group: "Folder browser", run: () => void browser.back() },
+      { bind: "alt+right", title: "Forward", group: "Folder browser", run: () => void browser.forward() },
+      { bind: "alt+up", title: "Parent folder", group: "Folder browser", run: () => void browser.up() },
+      { bind: "alt+h", title: "Home folder", group: "Folder browser", run: () => void browser.home() },
+      { bind: "ctrl+s", title: "Select this folder", group: "Folder browser", run: () => void confirm() },
+      ...(props.onCancel ? [{ bind: "escape", title: "Back", group: "Folder browser", run: props.onCancel }] : []),
+    ],
+  }))
+
+  createEffect(() => {
+    const value = browser.state.input
+    if (pathInput && !pathInput.isDestroyed && pathInput.value !== value) pathInput.value = value
+  })
+  createEffect(() => {
+    const value = browser.state.filter
+    if (filterInput && !filterInput.isDestroyed && filterInput.value !== value) filterInput.value = value
+  })
+  createEffect(() => {
+    const index = browser.state.selected
+    if (!scroll || scroll.isDestroyed) return
+    const target = scroll.getChildren()[index]
+    if (!target) return
+    const y = target.y - scroll.y
+    if (y >= scroll.height) scroll.scrollBy(y - scroll.height + 1)
+    if (y < 0) scroll.scrollBy(y)
+  })
+
+  onMount(() => {
+    dialog.setSize("large")
+    dialog.setCentered(true)
+    void browser.open(props.start ?? props.anchor)
+    setTimeout(() => {
+      if (closed) return
+      focusField("filter")
+    }, 1)
+  })
+
+  const status = () => {
+    if (confirming()) return { text: chromeLabel("Checking folder…"), error: false }
+    if (browser.state.pending)
+      return {
+        text: `${chromeLabel("Loading")} ${Locale.truncateLeft(browser.state.pending, width() - 10)}`,
+        error: false,
+      }
+    if (browser.state.error) return { text: browser.state.error.message, error: true }
+    if (!browser.state.directory) return { text: "No folder open", error: false }
+    if (browser.state.entries.length === 0)
+      return { text: "No subfolders here; ctrl+s selects this folder", error: false }
+    if (browser.visible().length === 0) return { text: `No folders match "${browser.state.filter}"`, error: false }
+    const count = browser.visible().length
+    return { text: `${count} folder${count === 1 ? "" : "s"}`, error: false }
+  }
+
+  const button = (label: string, enabled: () => boolean, run: () => void) => (
+    <text
+      flexShrink={0}
+      fg={enabled() ? theme.text.action.secondary.base : theme.text.action.primary.disabled}
+      selectable={false}
+      wrapMode="none"
+      onMouseUp={(event) => {
+        event.stopPropagation()
+        if (enabled()) run()
+      }}
+    >
+      {label}
+    </text>
+  )
+
+  const inputRow = (label: string, name: "filter" | "path") => (
+    <box flexDirection="row" height={1} gap={1}>
+      <text flexShrink={0} width={6} fg={field() === name ? theme.text.base : theme.text.muted} wrapMode="none">
+        {label}
+      </text>
+      <input
+        flexGrow={1}
+        placeholder={name === "path" ? "/path, ~/folder, or relative path" : "Filter this folder"}
+        placeholderColor={theme.text.muted}
+        textColor={theme.text.formfield.base}
+        focusedTextColor={theme.text.formfield.focused}
+        focusedBackgroundColor={theme.background.formfield.focused}
+        cursorColor={theme.text.formfield.focused}
+        cursorStyle={config.cursor}
+        onInput={(value) => (name === "path" ? browser.setInput(value) : browser.setFilter(value))}
+        onMouseDown={() => setField(name)}
+        ref={(element: InputRenderable) => {
+          if (name === "path") pathInput = element
+          else filterInput = element
+        }}
+      />
+    </box>
+  )
+
+  return (
+    <DialogLayout
+      header={<DialogHeader title={props.title ?? "Browse folders"} />}
+      footer={{
+        actions: {
+          secondary: [
+            { title: "open", key: "enter", onTrigger: submit },
+            { title: "path/filter", key: "tab", onTrigger: () => focusField(field() === "filter" ? "path" : "filter") },
+          ],
+          primary: [
+            {
+              title: "select folder",
+              key: "ctrl+s",
+              disabled: !browser.state.directory || !!browser.state.pending || confirming(),
+              onTrigger: () => void confirm(),
+            },
+          ],
+        },
+      }}
+    >
+      <box flexDirection="column">
+        <box flexDirection="row" height={1} gap={2}>
+          {button(`${chromeGlyph("←")} Back`, browser.canBack, () => void browser.back())}
+          {button(`${chromeGlyph("→")} Forward`, browser.canForward, () => void browser.forward())}
+          {button(`${chromeGlyph("↑")} Up`, browser.canUp, () => void browser.up())}
+          {button(
+            "~ Home",
+            () => true,
+            () => void browser.home(),
+          )}
+          <box flexGrow={1} />
+          <text flexShrink={1} fg={theme.text.muted} wrapMode="none" overflow="hidden">
+            {`alt+${chromeGlyph("←")}${chromeGlyph("→")}${chromeGlyph("↑")} alt+h`}
+          </text>
+        </box>
+        <text fg={theme.text.muted} wrapMode="none" overflow="hidden">
+          {"In     " +
+            (browser.state.directory
+              ? Locale.truncateLeft(browser.state.directory, width() - 7, chromeEllipsis())
+              : chromeGlyph("—"))}
+        </text>
+        {inputRow("Path", "path")}
+        {inputRow("Filter", "filter")}
+        <text fg={status().error ? theme.text.feedback.error.base : theme.text.muted} wrapMode="word">
+          {status().text}
+        </text>
+        <scrollbox
+          height={listHeight()}
+          ref={(element: ScrollBoxRenderable) => (scroll = element)}
+          scrollbarOptions={{ visible: false }}
+        >
+          <For each={browser.visible()}>
+            {(entry, index) => {
+              const active = () => index() === browser.state.selected
+              return (
+                <box
+                  height={1}
+                  flexDirection="row"
+                  paddingLeft={1}
+                  backgroundColor={active() ? theme.background.action.primary.focused : undefined}
+                  onMouseUp={(event) => {
+                    event.stopPropagation()
+                    if (active()) return void browser.enter()
+                    browser.select(index())
+                  }}
+                >
+                  <text
+                    fg={active() ? theme.text.action.primary.focused : theme.text.base}
+                    attributes={active() ? TextAttributes.BOLD : undefined}
+                    wrapMode="none"
+                    selectable={false}
+                  >
+                    {Locale.truncate(entry.name + "/", width() - 2, chromeEllipsis())}
+                  </text>
+                </box>
+              )
+            }}
+          </For>
+        </scrollbox>
+      </box>
+    </DialogLayout>
+  )
+}
