diff --git a/packages/tui/src/component/navigation-rail.tsx b/packages/tui/src/component/navigation-rail.tsx
new file mode 100644
index 0000000..2f108a3
--- /dev/null
+++ b/packages/tui/src/component/navigation-rail.tsx
@@ -0,0 +1,92 @@
+import { createComponent, For, onCleanup, type JSX } from "solid-js"
+import { useNavigation } from "../context/navigation"
+import { InteractivityProvider } from "../context/interactivity"
+import { useTheme } from "../context/theme"
+import { PluginBoundary } from "../plugin/render"
+import { SESSION_TABS_COMPACT_BREAKPOINT } from "../ui/layout"
+
+export function NavigationRail(props: {
+  width: number
+  height: number
+  visible: boolean
+  sessionID?: string
+  projects: JSX.Element
+}) {
+  const navigation = useNavigation()
+  const theme = useTheme()
+  const compact = () => props.width < SESSION_TABS_COMPACT_BREAKPOINT
+  const headerHeight = () => compact() ? navigation.panes().length + 2 : 2
+  onCleanup(() => navigation.target(undefined))
+  const button = (title: string, selected: () => boolean, run: () => void) => (
+    <box
+      height={1}
+      flexShrink={0}
+      paddingX={1}
+      backgroundColor={selected() ? theme.background.action.primary.selected : undefined}
+      onMouseUp={(event) => {
+        if (event.button !== 0) return
+        event.stopPropagation()
+        // Mode selection is not keyboard focus and never activates a row.
+        navigation.blur()
+        run()
+      }}
+    >
+      <text fg={selected() ? theme.text.action.primary.base : theme.text.action.secondary.base} selectable={false} wrapMode="none" truncate>
+        {compact() ? title.slice(0, 1) : title}
+      </text>
+    </box>
+  )
+  return (
+    <box id="navigation-rail" width={props.width} height={props.height} flexShrink={0} visible={props.visible} backgroundColor={theme.background.raised.base}>
+      <box height={headerHeight()} flexShrink={0}>
+        <box flexDirection={compact() ? "column" : "row"}>
+          {button("Projects", () => !navigation.current(), navigation.projects)}
+          <For each={navigation.panes()}>
+            {(pane) => button(pane.title, () => navigation.current() === pane, () => navigation.select(pane.owner, pane.name))}
+          </For>
+        </box>
+        <text
+          id="navigation-focus"
+          fg={theme.text.action.secondary.base}
+          selectable={false}
+          onMouseUp={(event) => { if (event.button === 0) navigation.focus() }}
+        >{compact() ? " > " : " Focus pane"}</text>
+      </box>
+      <box
+        id="navigation-body"
+        ref={navigation.target}
+        focusable
+        width={props.width}
+        height={Math.max(0, props.height - headerHeight())}
+        position="relative"
+        onMouseDown={navigation.capture}
+      >
+        <box id="navigation-projects" width={props.width} height="100%" visible={!navigation.current()}>
+          <InteractivityProvider enabled={props.visible && !navigation.current()}>{props.projects}</InteractivityProvider>
+        </box>
+        <For each={navigation.panes()}>
+          {(pane) => {
+            const active = () => props.visible && navigation.current() === pane
+            return (
+              <box width={props.width} height="100%" visible={navigation.current() === pane}>
+                <InteractivityProvider enabled={active()}>
+                  <PluginBoundary id={pane.owner} where={`navigation ${pane.name}`}>
+                    {createComponent(pane.render, {
+                      get width() { return props.width },
+                      get compact() { return compact() },
+                      get active() { return active() },
+                      get focused() { return active() && navigation.focused() },
+                      get sessionID() { return props.sessionID },
+                      focus: navigation.focus,
+                      blur: navigation.blur,
+                    })}
+                  </PluginBoundary>
+                </InteractivityProvider>
+              </box>
+            )
+          }}
+        </For>
+      </box>
+    </box>
+  )
+}
