+import { expect, test } from "bun:test"
+import { TextRenderable } from "@opentui/core"
+import { createTestRenderer, ManualClock } from "@opentui/core/testing"
+import { TranscriptScrollBoxRenderable } from "../../src/component/transcript-scrollbox"
+
+async function fixture() {
+  const clock = new ManualClock()
+  const app = await createTestRenderer({ width: 40, height: 12, useThread: false, clock })
+  app.renderer.pause()
+  const scroll = new TranscriptScrollBoxRenderable(app.renderer, {
+    width: 40, height: 5, position: "absolute", top: 1,
+    stickyScroll: true, stickyStart: "bottom",
+  })
+  scroll.add(new TextRenderable(app.renderer, {
+    content: Array.from({ length: 30 }, (_, index) => `row-${String(index).padStart(2, "0")} SNIP tail`).join("\n"),
+  }))
+  app.renderer.root.add(scroll)
+  const frame = async (millis = 0) => {
+    clock.setTime(clock.now() + millis)
+    await app.waitFor(() => !app.renderer.getSchedulerState().isRendering)
+    await app.renderOnce()
+  }
+  await frame()
+  await frame()
+  return { ...app, scroll, frame, [Symbol.dispose]: () => app.renderer.destroy() }
+}
+
+test.each([1, 5])("same-row selection at edge row %i does not scroll or expand its range", async (row) => {
+  using app = await fixture()
+  app.scroll.scrollTop = 15
+  await app.frame()
+  const before = app.scroll.scrollTop
+  expect(before).toBeGreaterThan(0)
+  await app.mockMouse.pressDown(7, row)
+  await app.mockMouse.emitMouseEvent("drag", 10, row)
+  await app.frame(200)
+  await app.mockMouse.release(10, row)
+  expect(app.scroll.scrollTop).toBe(before)
+  expect(app.renderer.getSelection()?.getSelectedText()).toBe("SNIP")
+})
+
+test("vertical drag toward the viewport edge still auto-scrolls", async () => {
+  using app = await fixture()
+  const before = app.scroll.scrollTop
+  await app.mockMouse.pressDown(7, 3)
+  await app.mockMouse.emitMouseEvent("drag", 10, 1)
+  await app.frame(200)
+  expect(app.scroll.scrollTop).toBeLessThan(before)
+  await app.mockMouse.release(10, 1)
+  const stopped = app.scroll.scrollTop
+  await app.frame(200)
+  expect(app.scroll.scrollTop).toBe(stopped)
+})
+
+test("wheel scrolling remains available after a horizontal selection", async () => {
+  using app = await fixture()
+  const before = app.scroll.scrollTop
+  await app.mockMouse.pressDown(7, 1)
+  await app.mockMouse.emitMouseEvent("drag", 10, 1)
+  await app.mockMouse.release(10, 1)
+  await app.mockMouse.scroll(10, 2, "up")
+  expect(app.scroll.scrollTop).toBeLessThan(before)
+})
