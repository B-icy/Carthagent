diff --git a/packages/tui/src/context/navigation.tsx b/packages/tui/src/context/navigation.tsx
new file mode 100644
index 0000000..3e531af
--- /dev/null
+++ b/packages/tui/src/context/navigation.tsx
@@ -0,0 +1,174 @@
+import type { NavigationPane } from "@opencode/plugin/tui/context"
+import type { BoxRenderable, Renderable } from "@opentui/core"
+import { useRenderer } from "@opentui/solid"
+import { createContext, createEffect, createMemo, createSignal, onCleanup, useContext, type ParentProps } from "solid-js"
+import { Keymap } from "./keymap"
+import { useSessionTabs } from "./session-tabs"
+import { useStorage } from "./storage"
+import { useTuiLifecycle } from "./runtime"
+import { useDialog } from "../ui/dialog"
+
+export type NavigationSelection = { owner: string; name: string } | undefined
+export type RegisteredNavigationPane = NavigationPane & { readonly owner: string }
+
+/** Client-only mode selection. It deliberately has no router or session client. */
+export function createNavigationState(options: {
+  initial?: NavigationSelection
+  persist: (selection: NavigationSelection) => void
+  reveal: () => void
+}) {
+  const [panes, setPanes] = createSignal<readonly RegisteredNavigationPane[]>([])
+  const [selection, setSelection] = createSignal(options.initial)
+  const current = createMemo(() => panes().find((pane) => pane.owner === selection()?.owner && pane.name === selection()?.name))
+  const select = (selection: NavigationSelection) => {
+    setSelection(selection)
+    options.persist(selection)
+    options.reveal()
+  }
+  return {
+    panes,
+    current,
+    restore: setSelection,
+    projects: () => select(undefined),
+    select(owner: string, name: string) {
+      if (!panes().some((pane) => pane.owner === owner && pane.name === name)) return false
+      select({ owner, name })
+      return true
+    },
+    next() {
+      const next = panes()[panes().indexOf(current()!) + 1]
+      select(next ? { owner: next.owner, name: next.name } : undefined)
+    },
+    register(owner: string, pane: NavigationPane) {
+      if (typeof pane.name !== "string" || !/^[a-zA-Z0-9][a-zA-Z0-9._-]*$/.test(pane.name) || pane.name.toLowerCase() === "projects")
+        throw new Error("Invalid navigation pane name (projects is reserved)")
+      if (typeof pane.title !== "string" || !pane.title.trim() || pane.title.length > 80 || /[\x00-\x1f\x7f]/.test(pane.title))
+        throw new Error("Invalid navigation pane title")
+      if (typeof pane.render !== "function") throw new Error("Navigation pane render is required")
+      const entry = { ...pane, title: pane.title.trim(), owner }
+      setPanes((panes) => [...panes.filter((item) => item.owner !== owner || item.name !== pane.name), entry])
+      return () => {
+        // A stale generation must not remove its replacement or reset that replacement's selection.
+        if (!panes().includes(entry)) return
+        if (selection()?.owner === owner && selection()?.name === pane.name) {
+          setSelection(undefined)
+          options.persist(undefined)
+        }
+        setPanes((panes) => panes.filter((item) => item !== entry))
+      }
+    },
+  }
+}
+
+const Context = createContext<ReturnType<typeof createNavigationHost>>()
+
+function createNavigationHost() {
+  const storage = useStorage()
+  const tabs = useSessionTabs()
+  const keymap = Keymap.use()
+  const renderer = useRenderer()
+  const dialog = useDialog()
+  const [stored, persist] = storage.store<{ selected?: { owner: string; name: string } }>("navigation", { initial: {} })
+  const [saving, setSaving] = createSignal(false)
+  let disposed = false
+  let pending = Promise.resolve()
+  const state = createNavigationState({
+    initial: stored.selected,
+    persist: (selected) => {
+      if (disposed) return
+      setSaving(true)
+      const operation = pending.then(() => persist((draft) => { draft.selected = selected }))
+        .catch((error) => console.error("Failed to persist navigation mode", error))
+      pending = operation
+      void operation.then(() => { if (pending === operation) setSaving(false) })
+    },
+    reveal: () => { if (tabs.hidden()) tabs.toggleSidebar() },
+  })
+  // Intermediate acknowledgements must not override a newer local selection.
+  createEffect(() => { if (!saving()) state.restore(stored.selected) })
+  useTuiLifecycle().add(() => pending)
+  const [visible, setVisible] = createSignal(false)
+  const [engaged, setEngaged] = createSignal(false)
+  let target: BoxRenderable | undefined
+  let previous: Renderable | null | undefined
+  let release: (() => void) | undefined
+  let focusRevision = 0
+  let restoreTimer: ReturnType<typeof setTimeout> | undefined
+  const blur = (preservePageFocus = false) => {
+    if (!engaged()) return
+    release?.()
+    release = undefined
+    setEngaged(false)
+    // Dialogs restore their remembered focus on a 1ms timer. Restore the page
+    // after that handoff so a delayed dialog callback cannot refocus the rail.
+    const remembered = previous
+    previous = undefined
+    const revision = ++focusRevision
+    const current = renderer.currentFocusedRenderable
+    // Only a page click can transfer focus before its mouse event bubbles here.
+    if (preservePageFocus && current && !current.isDestroyed && current !== target && !(target && contains(target, current))) return
+    current?.blur()
+    const restore = () => {
+      if (disposed || revision !== focusRevision || engaged() || dialog.stack.length || keymap.mode.current() !== "base" || !remembered || remembered.isDestroyed) return
+      remembered.focus()
+    }
+    queueMicrotask(restore)
+    clearTimeout(restoreTimer)
+    restoreTimer = setTimeout(restore, 1)
+  }
+  const focused = () => engaged() && visible() && keymap.mode.current() === "navigation" && dialog.stack.length === 0
+  const focus = () => {
+    if (!visible() || dialog.stack.length || (keymap.mode.current() !== "base" && keymap.mode.current() !== "navigation")) return
+    focusRevision++
+    clearTimeout(restoreTimer)
+    if (!engaged()) {
+      // A rail click can natively focus the rail before onMouseUp runs.
+      // Its onMouseDown capture keeps the page control as the return target.
+      const current = renderer.currentFocusedRenderable
+      if (current && current !== target && !(target && contains(target, current))) previous = current
+      current?.blur()
+      release = keymap.mode.push("navigation")
+      setEngaged(true)
+    }
+    // The active contribution may have focused its own control synchronously.
+    queueMicrotask(() => {
+      if (disposed || !focused()) return
+      const current = renderer.currentFocusedRenderable
+      if (current && target?.getChildren().some((child) => child === current || contains(child, current))) return
+      target?.focus()
+    })
+  }
+  createEffect(() => { if (!visible()) blur() })
+  createEffect(() => { if (focused()) focus() })
+  onCleanup(() => {
+    disposed = true
+    focusRevision++
+    clearTimeout(restoreTimer)
+    release?.()
+  })
+  Keymap.createLayer(() => ({
+    mode: "navigation",
+    priority: 100,
+    commands: [{ bind: "escape", title: "Return to page", run: () => blur() }],
+  }))
+  const capture = () => {
+    if (engaged() || dialog.stack.length || keymap.mode.current() !== "base") return
+    const current = renderer.currentFocusedRenderable
+    if (current && current !== target && !(target && contains(target, current))) previous = current
