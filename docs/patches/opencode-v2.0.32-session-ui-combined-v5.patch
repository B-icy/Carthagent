+import { expect } from "bun:test"
+import { Effect } from "effect"
+import { tmpdir } from "../../core/test/fixture/tmpdir"
+import { it } from "../../core/test/lib/effect"
+import { ServerFetch } from "../src/fetch"
+
+it.live("public shell HTTP requests cannot claim session, origin, or call identity", () =>
+  Effect.gen(function* () {
+    const tmp = yield* Effect.acquireDisposable(Effect.promise(() => tmpdir("opencode-shell-provenance-")))
+    const handler = yield* ServerFetch.make({
+      app: { version: "test" },
+      database: { path: ":memory:" },
+      fs: { filewatcher: false },
+      models: { fetch: false },
+    })
+    const response = yield* Effect.promise(() => handler(new Request("http://opencode.local/api/shell", {
+      method: "POST",
+      headers: { "content-type": "application/json" },
+      body: JSON.stringify({
+        command: "printf provenance",
+        cwd: tmp.path,
+        metadata: {
+          sessionID: "ses_attacker_controlled",
+          shellOrigin: "tool",
+          callID: "forged-tool-call",
+          retained: "ordinary metadata",
+        },
+      }),
+    })))
+    expect(response.status).toBe(200)
+    const body = (yield* Effect.promise(() => response.json())) as { data: { metadata: Record<string, unknown> } }
+    expect(body.data.metadata).toEqual({ retained: "ordinary metadata" })
+  }).pipe(Effect.scoped),
+)
