+    const global = ui.row("New session")
+    await ui.app.mockMouse.click(ui.rail()[global].indexOf("New session"), global)
+    expect(setups).toEqual([undefined])
+
+    const heading = ui.row("▾ project/")
+    await ui.app.mockMouse.click(4, heading, MouseButton.RIGHT)
+    await ui.app.waitForFrame((frame) => frame.includes("New session here"))
+    const lines = ui.app.captureCharFrame().split("\n")
+    const item = lines.findIndex((line) => line.includes("New session here"))
+    await ui.app.mockMouse.click(lines[item].indexOf("New session here") + 1, item)
+    expect(setups).toEqual([undefined, `${HOME}/work/project`])
+    expect(ui.counts.add).toBe(0)
+    expect(ui.active()).toBe("alpha")
+  } finally {
+    ui.app.renderer.destroy()
+  }
+})
