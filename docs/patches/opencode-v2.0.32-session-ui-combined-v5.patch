+/** @jsxImportSource @opentui/solid */
+import { MouseButton } from "@opentui/core"
+import { testRender } from "@opentui/solid"
+import { expect, test } from "bun:test"
+import { createSignal } from "solid-js"
+import { ConfigProvider } from "../../src/config"
+import { EMPTY_SESSION_TAB_STATUS, SessionTabs, type SessionTabsController } from "../../src/component/session-tabs"
+import type { SessionTab } from "../../src/context/session-tabs-model"
+import { Keymap } from "../../src/context/keymap"
+import { ThemeProvider } from "../../src/context/theme"
+import { SESSION_TABS_COMPACT_WIDTH } from "../../src/ui/layout"
+import { DialogProvider } from "../../src/ui/dialog"
+import { ToastProvider } from "../../src/ui/toast"
+import { emptyThemeSource } from "../fixture/fixture"
+import { TestTuiContexts } from "../fixture/tui-environment"
+import { createTuiResolvedConfig } from "../fixture/tui-runtime"
+
+const HOME = "/tmp/opencode/home"
+
+async function mount(options: {
+  width: number
+  directory?: string
+  tabs?: SessionTab[]
+  active?: string
+  setup?: (directory?: string) => void
+}) {
+  const counts = { browse: 0, add: 0, model: 0, search: 0, group: 0 }
+  const [active, setActive] = createSignal(options.active ?? "alpha")
+  const [items] = createSignal<SessionTab[]>(
+    options.tabs ?? [
+      { sessionID: "alpha", title: "Alpha work" },
+      { sessionID: "beta", title: "Beta work" },
+      { sessionID: "gamma", title: "Grouped idea" },
+    ],
+  )
+  const controller = {
+    tabs: items,
+    current: active,
+    add: () => counts.add++,
+    search: () => counts.search++,
+    browse: () => counts.browse++,
+    selectModel: () => counts.model++,
+    setup: options.setup,
+    model: () => "DeepSeek V4.1 Flash",
+    directory: () => options.directory ?? `${HOME}/work/project`,
+    select: setActive,
+    close() {},
+    move() {},
+    folders: () => [
+      { id: `dir:${HOME}/work/project`, kind: "directory", directory: `${HOME}/work/project` } as const,
+      { id: "manual:ideas", kind: "manual", name: "Ideas" } as const,
+    ],
+    folderFor: (sessionID: string) => (sessionID === "gamma" ? "manual:ideas" : `dir:${HOME}/work/project`),
+    createFolder: () => counts.group++,
+    setFolderCollapsed() {},
+    status: (sessionID: string) =>
+      sessionID === "beta" ? { ...EMPTY_SESSION_TAB_STATUS, busy: true } : EMPTY_SESSION_TAB_STATUS,
+  } satisfies SessionTabsController
+  const app = await testRender(
+    () => (
+      <TestTuiContexts paths={{ home: HOME }}>
+        <ConfigProvider config={createTuiResolvedConfig({ tabs: { indicators: "status" } })}>
+          <Keymap.Provider>
+            <ThemeProvider mode="dark" source={emptyThemeSource}>
+              <ToastProvider>
+                <DialogProvider>
+                  <box width="100%" height="100%" flexDirection="row">
+                    <SessionTabs controller={controller} orientation="vertical" animations={false} width={options.width} />
+                    <text>transcript</text>
+                  </box>
+                </DialogProvider>
+              </ToastProvider>
+            </ThemeProvider>
+          </Keymap.Provider>
+        </ConfigProvider>
+      </TestTuiContexts>
+    ),
+    { width: 100, height: 30 },
+  )
+  app.renderer.start()
+  const rail = () => app.captureCharFrame().split("\n").map((line) => line.slice(0, options.width))
+  const row = (text: string) => rail().findIndex((line) => line.includes(text))
+  return { app, counts, active, rail, row }
+}
+
+test("wide rail orders current folder, actions, model and sessions as a clear hierarchy", async () => {
+  const ui = await mount({ width: 30 })
+  try {
+    await ui.app.waitForFrame((frame) => frame.includes("Alpha work") && frame.includes("New session"))
+    const folder = ui.row("project/")
+    const path = ui.row("~/work/project")
+    const actions = ui.row("Browse")
+    const model = ui.row("DeepSeek V4.1 Flash")
+    const sessions = ui.row("Sessions")
+    const firstGroup = ui.row("▾ project/")
+    expect(folder).toBeGreaterThanOrEqual(0)
+    expect([folder, path, actions, model, sessions, firstGroup]).toEqual(
+      [folder, path, actions, model, sessions, firstGroup].toSorted((a, b) => a - b),
+    )
+    expect(new Set([folder, path, actions, model, sessions]).size).toBe(5)
+    expect(firstGroup).toBeGreaterThan(sessions)
+    expect(ui.rail()[actions]).toContain("New session")
+    expect(ui.rail()[sessions]).toContain("⌕")
+    expect(ui.rail()[sessions]).toContain("+ Group")
+    expect(ui.app.captureCharFrame()).not.toContain("+ Folder")
+    expect(ui.rail().filter((line) => line.includes("New session")).length).toBe(1)
+  } finally {
+    ui.app.renderer.destroy()
+  }
+})
+
+test("folder actions are mouse targets that never change the active session", async () => {
+  const ui = await mount({ width: 30 })
+  try {
+    await ui.app.waitForFrame((frame) => frame.includes("Alpha work"))
+    const click = async (text: string) => {
+      const row = ui.row(text)
+      await ui.app.mockMouse.click(ui.rail()[row].indexOf(text), row)
+    }
+    await click("Browse")
+    await click("New session")
+    await click("DeepSeek V4.1 Flash")
+    await click("⌕")
+    expect(ui.counts).toMatchObject({ browse: 1, add: 1, model: 1, search: 1 })
+    await click("+ Group")
+    await ui.app.waitForFrame((frame) => frame.includes("New group"))
+    expect(ui.active()).toBe("alpha")
+  } finally {
+    ui.app.renderer.destroy()
+  }
+})
+
+test("filesystem folders and virtual groups are labelled differently", async () => {
+  const ui = await mount({ width: 30 })
+  try {
+    await ui.app.waitForFrame((frame) => frame.includes("Grouped idea"))
+    expect(ui.row("▾ project/")).toBeGreaterThan(0)
+    const group = ui.rail()[ui.row("Ideas")]
+    expect(group).toContain("# Ideas")
+    expect(group).not.toContain("Ideas/")
+  } finally {
+    ui.app.renderer.destroy()
+  }
+})
+
+test("active session keeps a marker distinct from hover focus and busy status", async () => {
+  const ui = await mount({ width: 30 })
+  try {
+    await ui.app.waitForFrame((frame) => frame.includes("Beta work"))
+    const marker = () => ui.rail().flatMap((line, index) => (line.startsWith("▎") ? [index] : []))
+    const alpha = ui.row("Alpha work")
+    const beta = ui.row("Beta work")
+    expect(marker()).toContain(alpha)
+    expect(marker()).not.toContain(beta)
+    await ui.app.mockMouse.moveTo(10, beta)
+    await ui.app.renderOnce()
+    expect(marker()).toContain(alpha)
+    expect(marker()).not.toContain(beta)
+    expect(ui.active()).toBe("alpha")
+  } finally {
+    ui.app.renderer.destroy()
+  }
+})
