+/** @jsxImportSource @opentui/solid */
+import { InputRenderable } from "@opentui/core"
+import { testRender } from "@opentui/solid"
+import { expect, test } from "bun:test"
+import { mkdir, readdir, rm, stat, writeFile } from "node:fs/promises"
+import path from "node:path"
+import { onMount } from "solid-js"
+import { ConfigProvider } from "../../src/config"
+import { DialogFolderBrowser } from "../../src/component/dialog-folder-browser"
+import { Keymap } from "../../src/context/keymap"
+import { ThemeProvider } from "../../src/context/theme"
+import { DialogProvider, useDialog } from "../../src/ui/dialog"
+import { ToastProvider } from "../../src/ui/toast"
+import { emptyThemeSource, tmpdir } from "../fixture/fixture"
+import { TestTuiContexts } from "../fixture/tui-environment"
+import { createTuiResolvedConfig } from "../fixture/tui-runtime"
+
+type File = Parameters<typeof DialogFolderBrowser>[0]["file"]
+
+// One-level listing of the real filesystem, returned relative to the anchor like the server's file.list.
+function diskFile(calls: string[]) {
+  return {
+    list: async (input) => {
+      const anchor = String(input?.location?.directory)
+      const target = path.resolve(anchor, String(input?.path ?? "."))
+      calls.push(target)
+      const info = await stat(target).catch(() => undefined)
+      if (!info?.isDirectory())
+        throw Object.assign(new Error(`Directory not found: ${target}`), { _tag: "FileNotFoundError" })
+      const entries = await readdir(target, { withFileTypes: true })
+      return {
+        location: { directory: anchor, project: { id: "proj_test", directory: anchor, canonical: anchor } },
+        data: entries
+          .map((entry) => ({
+            path: path.relative(anchor, path.join(target, entry.name)) + (entry.isDirectory() ? "/" : ""),
+            type: entry.isDirectory() ? ("directory" as const) : ("file" as const),
+          }))
+          .sort((a, b) => (a.type === b.type ? a.path.localeCompare(b.path) : a.type === "directory" ? -1 : 1)),
+      }
+    },
+  } as File
+}
+
+async function wait(fn: () => boolean, label: string, timeout = 3000) {
+  const start = Date.now()
+  while (!fn()) {
+    if (Date.now() - start > timeout) throw new Error(`timed out waiting for ${label}`)
+    await Bun.sleep(10)
+  }
+}
+
+async function mount(input: { root: string; anchor: string; start?: string; width?: number; height?: number }) {
+  const calls: string[] = []
+  const confirmed: string[] = []
+  const caller = { input: undefined as InputRenderable | undefined, open: () => {} }
+  function Caller() {
+    const dialog = useDialog()
+    caller.open = () =>
+      dialog.replace(() => (
+        <DialogFolderBrowser
+          file={diskFile(calls)}
+          anchor={input.anchor}
+          home={input.root}
+          start={input.start}
+          onConfirm={(directory) => confirmed.push(directory)}
+        />
+      ))
+    onMount(() => setTimeout(() => caller.input?.focus(), 1))
+    return <input value="draft text" ref={(element: InputRenderable) => (caller.input = element)} />
+  }
+  const app = await testRender(
+    () => (
+      <TestTuiContexts paths={{ home: input.root, state: path.join(input.root, ".state") }}>
+        <ConfigProvider config={createTuiResolvedConfig({})}>
+          <Keymap.Provider>
+            <ThemeProvider mode="dark" source={emptyThemeSource}>
+              <ToastProvider>
+                <DialogProvider>
+                  <Caller />
+                </DialogProvider>
+              </ToastProvider>
+            </ThemeProvider>
+          </Keymap.Provider>
+        </ConfigProvider>
+      </TestTuiContexts>
+    ),
+    { width: input.width ?? 120, height: input.height ?? 36, kittyKeyboard: true },
+  )
+  app.renderer.start()
+  await wait(() => app.renderer.currentFocusedRenderable === caller.input, "caller focus")
+  caller.open()
+  const frame = () => app.captureCharFrame()
+  const focusedPlaceholder = () => {
+    const focused = app.renderer.currentFocusedRenderable
+    return focused instanceof InputRenderable && focused !== caller.input ? focused.placeholder : undefined
+  }
+  return { app, calls, confirmed, caller, frame, focusedPlaceholder }
+}
+
+async function tree(root: string) {
+  const work = path.join(root, "work")
+  await mkdir(path.join(work, "alpha", "inner"), { recursive: true })
+  await mkdir(path.join(work, "beta"), { recursive: true })
+  await mkdir(path.join(root, "sibling plain"), { recursive: true })
+  await mkdir(path.join(root, "café ünï"), { recursive: true })
+  await writeFile(path.join(work, "notes.md"), "x")
+  return work
+}
+
+test("keyboard browses child, parent, history, filter and direct paths, then confirms", async () => {
+  await using tmp = await tmpdir()
+  const work = await tree(tmp.path)
+  const ui = await mount({ root: tmp.path, anchor: work })
+  try {
+    await wait(() => ui.frame().includes("alpha/") && ui.frame().includes("beta/"), "initial listing")
+    expect(ui.frame()).not.toContain("notes.md")
+    await wait(() => ui.focusedPlaceholder() === "Filter this folder", "filter focus")
+
+    await ui.app.mockInput.typeText("bet")
+    await wait(() => !ui.frame().includes("alpha/") && ui.frame().includes("beta/"), "filtered listing")
+    expect(ui.caller.input?.value).toBe("draft text")
+    const requests = ui.calls.length
+    ui.app.mockInput.pressKey("u", { ctrl: true })
+    await wait(() => ui.frame().includes("alpha/"), "cleared filter")
+    expect(ui.calls.length).toBe(requests)
+
+    ui.app.mockInput.pressEnter()
+    await wait(() => ui.frame().includes("inner/"), "entered alpha")
+    expect(ui.frame()).toContain("work/alpha")
+
+    ui.app.mockInput.pressArrow("up", { meta: true })
+    await wait(() => ui.frame().includes("beta/"), "parent")
+    ui.app.mockInput.pressArrow("up", { meta: true })
+    await wait(() => ui.frame().includes("sibling plain/") && ui.frame().includes("café ünï/"), "outside launch cwd")
+
+    ui.app.mockInput.pressArrow("left", { meta: true })
+    await wait(() => ui.frame().includes("beta/"), "back to work")
+    ui.app.mockInput.pressArrow("left", { meta: true })
+    await wait(() => ui.frame().includes("inner/"), "back to alpha")
+    ui.app.mockInput.pressArrow("right", { meta: true })
+    await wait(() => ui.frame().includes("beta/"), "forward to work")
+
+    ui.app.mockInput.pressTab()
+    await wait(() => ui.focusedPlaceholder()?.startsWith("/path") === true, "path focus")
+    ui.app.mockInput.pressKey("u", { ctrl: true })
+    await ui.app.mockInput.typeText("~/café ünï")
+    ui.app.mockInput.pressEnter()
+    await wait(() => ui.frame().includes("No subfolders here"), "unicode empty folder")
+    expect(ui.frame()).toContain("café ünï")
+    expect(ui.caller.input?.value).toBe("draft text")
+
+    ui.app.mockInput.pressKey("s", { ctrl: true })
+    await wait(() => ui.confirmed.length === 1, "confirmation")
+    expect(ui.confirmed).toEqual([path.join(tmp.path, "café ünï")])
+    await wait(() => ui.app.renderer.currentFocusedRenderable === ui.caller.input, "caller focus restored")
+    await wait(() => !ui.frame().includes("Browse folders"), "browser closed")
+  } finally {
+    ui.app.renderer.destroy()
+  }
+})
+
+test("mouse uses navigation controls, opens entries and selects the folder", async () => {
+  await using tmp = await tmpdir()
+  const work = await tree(tmp.path)
+  const ui = await mount({ root: tmp.path, anchor: work, width: 90, height: 28 })
+  const at = (label: string) => {
+    const rows = ui.frame().split("\n")
+    const row = rows.findIndex((line) => line.includes(label))
+    return { x: rows[row].indexOf(label) + 1, y: row }
+  }
+  try {
+    await wait(() => ui.frame().includes("beta/"), "listing")
+    let point = at("Up")
+    await ui.app.mockMouse.click(point.x, point.y)
+    await wait(() => ui.frame().includes("sibling plain/"), "parent via mouse")
+
+    point = at("Back")
+    await ui.app.mockMouse.click(point.x, point.y)
+    await wait(() => ui.frame().includes("beta/"), "back via mouse")
+
+    point = at("beta/")
+    await ui.app.mockMouse.click(point.x, point.y)
+    ui.app.renderer.clearSelection()
+    await ui.app.mockMouse.click(point.x + 2, point.y)
+    await wait(() => ui.frame().includes("No subfolders here"), "opened beta via mouse")
+
+    point = at("select folder")
+    await ui.app.mockMouse.click(point.x, point.y)
+    await wait(() => ui.confirmed.length === 1, "mouse confirmation")
+    expect(ui.confirmed).toEqual([path.join(work, "beta")])
+    await wait(() => ui.app.renderer.currentFocusedRenderable === ui.caller.input, "caller focus restored")
+  } finally {
+    ui.app.renderer.destroy()
+  }
+})
+
+test("invalid, file and removed targets keep the last valid folder and cancel commits nothing", async () => {
+  await using tmp = await tmpdir()
+  const work = await tree(tmp.path)
+  const ui = await mount({ root: tmp.path, anchor: work, width: 80, height: 20 })
+  try {
+    await wait(() => ui.frame().includes("beta/"), "listing")
+    await wait(() => ui.focusedPlaceholder() === "Filter this folder", "filter focus")
+    ui.app.mockInput.pressTab()
+    await wait(() => ui.focusedPlaceholder()?.startsWith("/path") === true, "path focus")
+    ui.app.mockInput.pressKey("u", { ctrl: true })
+    await ui.app.mockInput.typeText(path.join(work, "notes.md"))
+    ui.app.mockInput.pressEnter()
+    await wait(() => ui.frame().includes("not a directory"), "file error")
+    expect(ui.frame()).toContain("beta/")
+
+    ui.app.mockInput.pressKey("u", { ctrl: true })
+    await ui.app.mockInput.typeText("beta")
+    ui.app.mockInput.pressEnter()
+    await wait(() => ui.frame().includes("No subfolders here"), "beta")
+    await rm(path.join(work, "beta"), { recursive: true })
+    ui.app.mockInput.pressKey("s", { ctrl: true })
+    await wait(() => ui.frame().includes("not found"), "removed folder error")
+    expect(ui.confirmed).toEqual([])
+
+    ui.app.mockInput.pressEscape()
+    await wait(() => ui.app.renderer.currentFocusedRenderable === ui.caller.input, "caller focus restored")
+    expect(ui.confirmed).toEqual([])
+    expect(ui.caller.input?.value).toBe("draft text")
+  } finally {
+    ui.app.renderer.destroy()
+  }
+})
