@@ -0,0 +1,197 @@
+/** Host chrome glyphs. This deliberately does not transform arbitrary text. */
+export type GlyphMode = "auto" | "unicode" | "ascii"
+
+export function glyphMode(value = process.env.CTG_TUI_GLYPHS): GlyphMode {
+  if (value === "ascii" || value === "unicode" || value === "auto") return value
+  return "unicode"
+}
+
+export function asciiGlyphs() {
+  return glyphMode() === "ascii"
+}
+
+/** Replace known OpenCode chrome icons, leaving unknown/user supplied strings unchanged. */
+export function chromeGlyph(value: string) {
+  if (!asciiGlyphs()) return value
+  const replacements: Record<string, string> = {
+    "→": ">",
+    "←": "<",
+    "↳": "`",
+    "↻": "~",
+    "⟳": "~",
+    "✱": "*",
+    "◈": "@",
+    "⚙": "#",
+    "✓": "+",
+    "✗": "x",
+    "×": "x",
+    "•": "*",
+    "●": "*",
+    "▪": "*",
+    "■": "#",
+    "▤": "#",
+    "◐": "*",
+    "□": "o",
+    "◉": "o",
+    "○": "o",
+    "⇆": "<>",
+    "✕": "x",
+    "⦿": "o",
+    "‹": "<",
+    "⌕": "?",
+    "⊙": "*",
+    "⬖": "*",
+    "⎇": "*",
+    "≡": "=",
+    "▸": ">",
+    "▾": "v",
+    "▼": "v",
+    "▶": ">",
+    "⚠": "!",
+    "◇": "o",
+    "▎": "|",
+    "△": "!",
+    "›": ">",
+    "┃": "|",
+    "│": "|",
+    "↑": "^",
+    "↓": "v",
+    "├": "|-",
+    "└": "`-",
+    "─": "-",
+    "…": "...",
+    "·": ".",
+    "−": "-",
+    "—": "-",
+    "’": "'",
+  }
+  return replacements[value] ?? value
+}
+
+/** Static host copy can opt in separately; dynamic/user text is deliberately not normalized. */
+const ASCII_CHROME_LABELS: Record<string, string> = {
+  "Searching…": "Searching...",
+  "Run a command…": "Run a command...",
+  "Ask anything…": "Ask anything...",
+  "Search worktrees…": "Search worktrees...",
+  "Search sessions and projects…": "Search sessions and projects...",
+  "Connecting …": "Connecting ...",
+  "Connecting…": "Connecting...",
+  "Searching sessions…": "Searching sessions...",
+  "Loading sessions…": "Loading sessions...",
+  "Writing debug snapshot…": "Writing debug snapshot...",
+  "Checking for updates…": "Checking for updates...",
+  "Loading skills…": "Loading skills...",
+  "Gathering your stats…": "Gathering your stats...",
+  "Restarting service…": "Restarting service...",
+  "Connection lost…": "Connection lost...",
+  "Receiving code…": "Receiving code...",
+  "Waiting for code…": "Waiting for code...",
+  "Waiting for output…": "Waiting for output...",
+  "Loading worktrees…": "Loading worktrees...",
+  "Refreshing sessions and projects…": "Refreshing sessions and projects...",
+  "Searching sessions and projects…": "Searching sessions and projects...",
+  "Creating worktree…": "Creating worktree...",
+  "Loading server information…": "Loading server information...",
+  "Starting command…": "Starting command...",
+  "Waiting for command to finish…": "Waiting for command to finish...",
+  "Starting authorization…": "Starting authorization...",
+  "Waiting for authorization…": "Waiting for authorization...",
+  "Opening link…": "Opening link...",
+  "Finishing startup…": "Finishing startup...",
+  "Loading plugins…": "Loading plugins...",
+  "Loading image…": "Loading image...",
+  "Loading session history…": "Loading session history...",
+  "Writing command…": "Writing command...",
+  "Fetching from the web…": "Fetching from the web...",
+  "Delegating…": "Delegating...",
+  "Preparing edit…": "Preparing edit...",
+  "Forking session…": "Forking session...",
+  "Installing OpenCode …": "Installing OpenCode ...",
+  "Resolving diff…": "Resolving diff...",
+  "Loading branches…": "Loading branches...",
+  "Choose…": "Choose...",
+  "Loading diff…": "Loading diff...",
+  "processing…": "processing...",
+  "Working…": "Working...",
+  "Search sessions…": "Search sessions...",
+  "Loading output…": "Loading output...",
+  "Searching content…": "Searching content...",
+  "Reading file…": "Reading file...",
+  "Preparing write…": "Preparing write...",
+  "Finding files…": "Finding files...",
+  "Searching web…": "Searching web...",
+  "Asking questions…": "Asking questions...",
+  "Loading skill…": "Loading skill...",
+  "Waiting for permission event…": "Waiting for permission event...",
+  "Waiting…": "Waiting...",
+  "No matching files…": "No matching files...",
+  "Reloading configuration…": "Reloading configuration...",
+  "Unable to read shell output. Retrying…": "Unable to read shell output. Retrying...",
+  "Thinking…": "Thinking...",
+  "Running command…": "Running command...",
+  "Preparing command…": "Preparing command...",
+  "Running code…": "Running code...",
+  "Preparing code…": "Preparing code...",
+  "Report copied — paste it into a new GitHub issue.": "Report copied - paste it into a new GitHub issue.",
+}
+
+export function chromeLabel(value: string) {
+  if (!asciiGlyphs()) return value
+  return ASCII_CHROME_LABELS[value] ?? value
+}
+
+export function terminalTitle(title?: string) {
+  if (!title) return "Carthagent"
+  return `CTG | ${title.length > 40 ? title.slice(0, 37) + chromeEllipsis() : title}`
+}
+
+export function chromeEllipsis() {
+  return asciiGlyphs() ? "..." : "…"
+}
+
+export function chromeStatusSeparator() {
+  return asciiGlyphs() ? "|" : "·"
+}
+
+export const ASCII_SPINNER_FRAMES = ["-", "\\", "|", "/"]
+
+export const ASCII_BORDER_CHARS = {
+  topLeft: "+",
+  bottomLeft: "+",
+  vertical: "|",
+  topRight: "+",
+  bottomRight: "+",
+  horizontal: "-",
+  bottomT: "+",
+  topT: "+",
+  cross: "+",
+  leftT: "+",
+  rightT: "+",
+}
+
+export function chromeBorderChars() {
+  return asciiGlyphs() ? { ...ASCII_BORDER_CHARS } : undefined
+}
+
+export const CHROME_GLYPHS = {
+  action: "→",
+  back: "←",
+  continuation: "↳",
+  reconnect: "↻",
+  search: "✱",
+  web: "◈",
+  tool: "⚙",
+  success: "✓",
+  error: "✗",
+  pending: "•",
+  selection: "▪",
+  permission: "△",
+  border: "┃",
+} as const
+
+export const ASCII_LOGO = {
+  left: ["                        ", " C A R T H A G E N T    ", " C A R T H A G E N T    ", " C A R T H A G E N T    "],
+  right: ["                        ", " C A R T H A G E N T    ", " C A R T H A G E N T    ", " C A R T H A G E N T    "],
