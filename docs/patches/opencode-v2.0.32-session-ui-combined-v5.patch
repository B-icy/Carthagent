+/** @jsxImportSource @opentui/solid */
+import { InputRenderable } from "@opentui/core"
+import { expect, test } from "bun:test"
+import type { ModelInfo } from "@opencode/client"
+import { DialogNewSession, type NewSessionChoice } from "../../src/component/dialog-new-session"
+import { model, renderLocal } from "../fixture/local"
+import { directory, json } from "../fixture/tui-client"
+
+type File = Parameters<typeof DialogNewSession>[0]["file"]
+
+const other = "/tmp/opencode-other"
+const missing = "/tmp/opencode-missing"
+
+function folders(calls: string[]) {
+  return {
+    list: async (input) => {
+      const target = String(input?.path)
+      calls.push(target)
+      if (target === missing)
+        throw Object.assign(new Error(`Directory not found: ${target}`), { _tag: "FileNotFoundError" })
+      return {
+        location: { directory: target, project: { id: "proj", directory: target, canonical: target } },
+        data: [{ path: "child/", type: "directory" as const }],
+      }
+    },
+  } as File
+}
+
+async function wait(fn: () => boolean, label: string, timeout = 3000) {
+  const start = Date.now()
+  while (!fn()) {
+    if (Date.now() - start > timeout) throw new Error(`timed out waiting for ${label}`)
+    await Bun.sleep(10)
+  }
+}
+
+async function mount(input: { start?: string; catalogs?: Record<string, ModelInfo[]> } = {}) {
+  const creates: string[] = []
+  const catalogs = input.catalogs ?? {}
+  const setup = await renderLocal({
+    models: [model("first"), model("second")],
+    fetch: (url, request) => {
+      if (url.pathname === "/api/session" && request.method === "POST") {
+        creates.push(url.pathname)
+        return json({ message: "unexpected" }, { status: 500 })
+      }
+      const dir = url.searchParams.get("location[directory]")
+      if (url.pathname === "/api/model" && dir && catalogs[dir])
+        return json({ location: { directory: dir }, data: catalogs[dir] })
+    },
+  })
+  const calls: string[] = []
+  const started: NewSessionChoice[] = []
+  const frame = () => setup.captureCharFrame()
+  const open = () =>
+    setup.dialog.replace(
+      () => (
+        <DialogNewSession
+          file={folders(calls)}
+          home="/tmp"
+          directory={input.start ?? directory}
+          onStart={(choice) => started.push(choice)}
+        />
+      ),
+      undefined,
+      { size: "large" },
+    )
+  open()
+  return { setup, calls, started, creates, frame, open }
+}
+
+async function rendered(ui: Awaited<ReturnType<typeof mount>>, text: string) {
+  await wait(() => {
+    void ui.setup.renderOnce()
+    return ui.frame().includes(text)
+  }, text)
+}
+
+test("shows the validated folder and actual provider/model and starts with exact choices without creating", async () => {
+  const ui = await mount()
+  await using _ = ui.setup
+  await rendered(ui, "first")
+  await rendered(ui, "Ready")
+  expect(ui.frame()).toContain(directory)
+  expect(ui.frame()).toContain("provider")
+  expect(ui.calls).toEqual([directory])
+  ui.setup.mockInput.pressEnter()
+  await wait(() => ui.started.length === 1, "start")
+  expect(ui.started[0]).toEqual({ directory, model: { providerID: "provider", modelID: "first" } })
+  expect(ui.setup.dialog.stack.length).toBe(0)
+  expect(ui.creates).toEqual([])
+})
+
+test("an invalid folder shows an actionable error and blocks start instead of falling back", async () => {
+  const ui = await mount({ start: missing })
+  await using _ = ui.setup
+  await rendered(ui, "Directory not found")
+  ui.setup.mockInput.pressEnter()
+  await Bun.sleep(50)
+  expect(ui.started).toEqual([])
+  expect(ui.setup.dialog.stack.length).toBe(1)
+})
+
+test("a retained model unavailable at the chosen folder is explicit and blocks start until a valid choice", async () => {
+  const ui = await mount({ start: other, catalogs: { [other]: [model("second")] } })
+  await using _ = ui.setup
+  await rendered(ui, "unavailable")
+  ui.setup.mockInput.pressEnter()
+  await Bun.sleep(50)
+  expect(ui.started).toEqual([])
+
+  ui.setup.mockInput.pressKey("m")
+  await wait(
+    () => ui.setup.renderer.currentFocusedRenderable instanceof InputRenderable,
+    "model picker focus",
+  )
+  await ui.setup.mockInput.typeText("second")
+  await rendered(ui, "second")
+  ui.setup.mockInput.pressEnter()
+  await rendered(ui, "Ready")
+  // The pick is pending setup state; the composer's own model is untouched until start.
+  expect(ui.setup.local.model.current()?.modelID).toBe("first")
+  ui.setup.mockInput.pressEnter()
+  await wait(() => ui.started.length === 1, "start")
+  expect(ui.started[0]).toEqual({ directory: other, model: { providerID: "provider", modelID: "second" } })
+})
+
+test("cancelling nested model and folder pickers returns to setup with prior choices intact", async () => {
+  const ui = await mount()
+  await using _ = ui.setup
+  await rendered(ui, "Ready")
+
+  ui.setup.mockInput.pressKey("m")
+  await wait(() => ui.setup.renderer.currentFocusedRenderable instanceof InputRenderable, "model focus")
+  ui.setup.mockInput.pressEscape()
+  await rendered(ui, "Ready")
+  expect(ui.setup.dialog.stack.length).toBe(1)
+
+  ui.setup.mockInput.pressKey("f")
+  await rendered(ui, "Choose folder for new session")
+  await rendered(ui, "child/")
+  ui.setup.mockInput.pressEnter()
+  await wait(() => ui.calls.includes(`${directory}/child`), "child listing")
+  ui.setup.mockInput.pressEscape()
+  await rendered(ui, "Ready")
+  expect(ui.frame()).not.toContain(`${directory}/child`)
+
+  ui.setup.mockInput.pressEnter()
+  await wait(() => ui.started.length === 1, "start")
+  expect(ui.started[0]).toEqual({ directory, model: { providerID: "provider", modelID: "first" } })
+})
+
+test("confirming a nested folder keeps the explicit model and whole-setup cancel commits nothing", async () => {
+  const ui = await mount()
+  await using _ = ui.setup
+  await rendered(ui, "Ready")
+  ui.setup.mockInput.pressKey("f")
+  await rendered(ui, "child/")
+  ui.setup.mockInput.pressEnter()
+  await wait(() => ui.calls.includes(`${directory}/child`), "child listing")
+  await Bun.sleep(20)
+  ui.setup.mockInput.pressKey("s", { ctrl: true })
+  await rendered(ui, `${directory}/child`)
+  await rendered(ui, "Ready")
+  expect(ui.frame()).toContain("first")
+
+  ui.setup.mockInput.pressEscape()
+  await wait(() => ui.setup.dialog.stack.length === 0, "closed")
+  expect(ui.started).toEqual([])
+  expect(ui.creates).toEqual([])
+  expect(ui.setup.route.data).toEqual({ type: "home" })
+})
