+import { describe, expect, test } from "bun:test"
+import path from "path"
+import { createRoot } from "solid-js"
+import { createFolderBrowser } from "../../src/context/folder-browser"
+import { createApi, createFetch, json } from "../fixture/tui-client"
+
+type Item = { path: string; type: "file" | "directory" }
+type File = Parameters<typeof createFolderBrowser>[0]["file"]
+
+const anchor = { directory: "/anchor" }
+const home = "/home/user"
+
+function listing(directory: string, data: Item[]) {
+  return { location: { directory, project: { id: "proj_test", directory, canonical: directory } }, data }
+}
+
+// Tree of absolute directory -> children; listings are returned relative to the anchor location like the server does.
+function tree(directories: Record<string, Item[]>) {
+  const calls: { location: unknown; path: unknown }[] = []
+  const file = {
+    list: async (input) => {
+      calls.push({ location: input?.location, path: input?.path })
+      const target = String(input?.path)
+      const children = directories[target]
+      if (!children) throw Object.assign(new Error(`Directory not found: ${target}`), { _tag: "FileNotFoundError" })
+      return listing(
+        anchor.directory,
+        children.map((item) => ({
+          ...item,
+          path: path.relative(anchor.directory, path.join(target, item.path)) + (item.type === "directory" ? "/" : ""),
+        })),
+      )
+    },
+  } as File
+  return { file, calls }
