diff --git a/packages/tui/src/component/dialog-new-session.tsx b/packages/tui/src/component/dialog-new-session.tsx
new file mode 100644
index 0000000..86a0a49
--- /dev/null
+++ b/packages/tui/src/component/dialog-new-session.tsx
@@ -0,0 +1,216 @@
+import { TextAttributes } from "@opentui/core"
+import { createMemo, createSignal, Match, onCleanup, onMount, Switch } from "solid-js"
+import type { OpenCodeClient } from "@opencode/client"
+import { useData } from "../context/data"
+import { useLocal } from "../context/local"
+import { useLocation } from "../context/location"
+import { Keymap } from "../context/keymap"
+import { useRoute } from "../context/route"
+import { useTheme } from "../context/theme"
+import type { ModelPreferenceModel } from "../model-preference"
+import { DialogHeader, DialogLayout, useDialog } from "../ui/dialog"
+import { chromeEllipsis, chromeLabel } from "../ui/glyphs"
+import { Locale } from "../util/locale"
+import { useTerminalDimensions } from "@opentui/solid"
+import { DialogFolderBrowser } from "./dialog-folder-browser"
+import { DialogModel } from "./dialog-model"
+
+export type NewSessionChoice = { directory: string; model: ModelPreferenceModel }
+
+/**
+ * Folder/model setup shown before a new session's first prompt. It only collects choices: the session
+ * is created by the normal first-message flow, so opening, confirming or cancelling creates nothing.
+ */
+export function DialogNewSession(props: {
+  file: Pick<OpenCodeClient["file"], "list">
+  home: string
+  directory: string
+  /** Location the folder check is anchored to; defaults to the checked folder itself. */
+  anchor?: string
+  onStart: (choice: NewSessionChoice) => void
+}) {
+  const dialog = useDialog()
+  const data = useData()
+  const local = useLocal()
+  const theme = useTheme().surface("dialog")
+  const dimensions = useTerminalDimensions()
+  // Large dialogs are at most 88 cells wide; subtract the side insets and the label column.
+  const fieldWidth = () => Math.max(10, Math.min(dimensions().width - 2, 88) - 14)
+  const [view, setView] = createSignal<"setup" | "folder" | "model">("setup")
+  const [directory, setDirectory] = createSignal(props.directory)
+  const [model, setModel] = createSignal<ModelPreferenceModel | undefined>(local.model.current())
+  const [check, setCheck] = createSignal<{ directory: string; error?: string; ready?: boolean }>({
+    directory: props.directory,
+  })
+  let generation = 0
+  let controller: AbortController | undefined
+  onCleanup(() => {
+    generation++
+    controller?.abort()
+  })
+
+  async function validate(target: string) {
+    controller?.abort()
+    const attempt = ++generation
+    const signal = (controller = new AbortController()).signal
+    setCheck({ directory: target })
+    const ref = { directory: target }
+    const error = await props.file
+      .list({ location: { directory: props.anchor ?? target }, path: target }, { signal })
+      .then(async () => {
+        if (attempt !== generation) return
+        await data.location.model.sync(ref)
+        await data.location.provider.sync(ref).catch(() => undefined)
+      })
+      .then(
+        () => undefined,
+        (cause: unknown) => (cause instanceof Error ? cause.message : String(cause)),
+      )
+    if (attempt !== generation) return
+    setCheck(error ? { directory: target, error } : { directory: target, ready: true })
+  }
+
+  const catalog = createMemo(() => (check().ready ? (data.location.model.list({ directory: directory() }) ?? []) : []))
+  const info = createMemo(() => {
+    const value = model()
+    return value && catalog().find((item) => item.providerID === value.providerID && item.id === value.modelID)
+  })
+  const provider = createMemo(() => {
+    const value = model()
+    if (!value) return
+    return data.location.provider.list({ directory: directory() })?.find((item) => item.id === value.providerID)?.name
+  })
+  const blocked = createMemo(() => {
+    const current = check()
+    if (current.error) return `Folder unavailable: ${current.error}`
+    if (!current.ready) return chromeLabel("Checking folder…")
+    if (catalog().length === 0) return "No models are available at this folder"
+    if (!model()) return "Choose a model to continue"
+    if (!info()) return "The selected model is unavailable at this folder; choose another"
+  })
+
+  function start() {
+    const value = model()
+    if (view() !== "setup" || blocked() || !value) return
+    dialog.clear()
+    props.onStart({ directory: directory(), model: { providerID: value.providerID, modelID: value.modelID } })
+  }
+
+  Keymap.createLayer(() => ({
+    mode: "modal",
+    enabled: view() === "setup",
+    commands: [
+      { bind: "return", title: "Start new session", group: "New session", run: start },
+      { bind: "f", title: "Change folder", group: "New session", run: () => setView("folder") },
+      { bind: "m", title: "Choose model", group: "New session", run: () => setView("model") },
+    ],
+  }))
+
+  onMount(() => {
+    dialog.setSize("large")
+    void validate(props.directory)
+  })
+
+  const label = (text: string) => (
+    <text flexShrink={0} width={8} fg={theme.text.muted} wrapMode="none">
+      {text}
+    </text>
+  )
+
+  return (
+    <Switch>
+      <Match when={view() === "folder"}>
+        <DialogFolderBrowser
+          file={props.file}
+          anchor={props.anchor ?? directory()}
+          home={props.home}
+          start={directory()}
+          title="Choose folder for new session"
+          onConfirm={(value) => {
+            setView("setup")
+            if (value === directory()) return
+            setDirectory(value)
+            void validate(value)
+          }}
+          onCancel={() => setView("setup")}
+        />
+      </Match>
+      <Match when={view() === "model"}>
+        <DialogModel
+          location={{ directory: directory() }}
+          current={model()}
+          onSelect={(value) => {
+            setModel(value)
+            setView("setup")
+          }}
+          onCancel={() => setView("setup")}
+        />
+      </Match>
+      <Match when={view() === "setup"}>
+        <DialogLayout
+          header={<DialogHeader title="New session" />}
+          footer={{
+            actions: {
+              secondary: [
+                { title: "folder", key: "f", onTrigger: () => setView("folder") },
+                { title: "model", key: "m", onTrigger: () => setView("model") },
+              ],
+              primary: [{ title: "start", key: "enter", disabled: !!blocked(), onTrigger: start }],
+            },
+          }}
+        >
+          <box flexDirection="column" gap={0}>
+            <box flexDirection="row" height={1}>
+              {label("Folder")}
+              <text fg={theme.text.base} wrapMode="none" overflow="hidden">
+                {Locale.truncateLeft(directory(), fieldWidth(), chromeEllipsis())}
+              </text>
+            </box>
+            <box flexDirection="row" height={1}>
+              {label("Model")}
+              <text fg={theme.text.base} wrapMode="none" overflow="hidden">
+                {Locale.truncate(modelLabel(), fieldWidth(), chromeEllipsis())}
+              </text>
+            </box>
+            <box height={1} />
+            <text fg={blocked() ? theme.text.feedback.warning.base : theme.text.muted} wrapMode="word">
+              {blocked() ?? "Ready. The session is created when you send the first message."}
+            </text>
+          </box>
+        </DialogLayout>
+      </Match>
+    </Switch>
+  )
+
+  function modelLabel() {
+    const value = model()
+    if (!value) return "None selected"
+    const name = info()?.name ?? value.modelID
+    const suffix = check().ready && !info() ? " (unavailable)" : ""
+    return `${provider() ?? value.providerID} · ${name} [${value.providerID}/${value.modelID}]${suffix}`
+  }
+}
+
+/**
+ * Applies a confirmed setup to Home: the chosen folder becomes the draft location and the chosen model
+ * becomes that location's new-session model. Existing sessions are left untouched.
+ */
+export function useNewSessionStart() {
+  const route = useRoute()
+  const location = useLocation()
+  const data = useData()
+  const local = useLocal()
+  const atHome = (directory: string) => route.data.type === "home" && route.data.location?.directory === directory
+  return async (choice: NewSessionChoice) => {
+    const ref = { directory: choice.directory }
+    // Home stays mounted across a Home-to-Home navigation, so its unsent text survives; a session's draft is
+    // stashed under that session by its own prompt.
+    route.navigate({ type: "home", location: ref })
+    location.set(ref)
+    await Promise.all([data.location.agent.sync(ref), data.location.model.sync(ref)])
+    // The user may have moved on while the catalog loaded; never apply the choice elsewhere.
+    if (!atHome(choice.directory) || location.ref?.directory !== choice.directory) return false
+    local.model.set(choice.model, { recent: true })
+    return true
+  }
+}
