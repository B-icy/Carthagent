diff --git a/packages/tui/src/context/folder-browser.ts b/packages/tui/src/context/folder-browser.ts
new file mode 100644
index 0000000..c60b599
--- /dev/null
+++ b/packages/tui/src/context/folder-browser.ts
@@ -0,0 +1,156 @@
+import { ClientError, isFileNotFoundError, type OpenCodeClient } from "@opencode/client"
+import path from "path"
+import { createStore } from "solid-js/store"
+
+export type FolderBrowserEntry = { name: string; absolute: string }
+
+type History = "push" | "back" | "forward" | "replace"
+
+export type FolderBrowserError = {
+  path: string
+  kind: "not-found" | "unavailable" | "failed"
+  message: string
+}
+
+export function createFolderBrowser(input: {
+  file: Pick<OpenCodeClient["file"], "list">
+  location: () => { directory: string }
+  home: string
+}) {
+  const [state, setState] = createStore({
+    directory: undefined as string | undefined,
+    entries: [] as FolderBrowserEntry[],
+    history: [] as string[],
+    index: -1,
+    input: "",
+    filter: "",
+    selected: 0,
+    pending: undefined as string | undefined,
+    error: undefined as FolderBrowserError | undefined,
+  })
+  const request = {
+    generation: 0,
+    controller: undefined as AbortController | undefined,
+    failed: undefined as { target: string; history: History; index: number } | undefined,
+  }
+
+  const visible = () => {
+    const query = state.filter.trim().toLowerCase()
+    if (!query) return state.entries
+    return state.entries.filter((entry) => entry.name.toLowerCase().includes(query))
+  }
+
+  // `index` is the history position a traversal lands on; it is captured up front so a retry repeats the same move.
+  async function load(target: string, history: History, index = nextIndex(history)) {
+    request.controller?.abort()
+    const generation = ++request.generation
+    const controller = new AbortController()
+    request.controller = controller
+    setState({ pending: target, error: undefined })
+    const result = await input.file
+      .list({ location: input.location(), path: target }, { signal: controller.signal })
+      .then((value) => ({ value }))
+      .catch((error: unknown) => ({ error }))
+    // A newer load or cancel owns state; aborted and late results must not overwrite it.
+    if (generation !== request.generation) return false
+    request.controller = undefined
+    if ("error" in result) {
+      request.failed = { target, history, index }
+      setState({ pending: undefined, error: describeError(target, result.error) })
+      return false
+    }
+    request.failed = undefined
+    const entries = result.value.data
+      .filter((item) => item.type === "directory")
+      .map((item) => path.resolve(result.value.location.directory, item.path))
+      .filter((absolute) => absolute !== target && path.dirname(absolute) === target)
+      .map((absolute) => ({ name: path.basename(absolute), absolute }))
+    const branch = history === "push" && state.history[state.index] !== target
+    setState({
+      directory: target,
+      entries,
+      history: branch ? [...state.history.slice(0, state.index + 1), target] : state.history,
+      index: branch ? state.index + 1 : index,
+      input: target,
+      filter: "",
+      selected: 0,
+      pending: undefined,
+      error: undefined,
+    })
+    return true
+  }
+
+  function nextIndex(history: History) {
+    if (history === "back") return state.index - 1
+    if (history === "forward") return state.index + 1
+    return state.index
+  }
+
+  // Leading/trailing whitespace is a significant part of filesystem names, so input is never trimmed.
+  function resolve(value: string) {
+    if (value === "~") return path.resolve(input.home)
+    if (value.startsWith("~/")) return path.resolve(input.home, value.slice(2))
+    return path.resolve(state.directory ?? input.location().directory, value || ".")
+  }
+
+  return {
+    state,
+    visible,
+    selection: () => visible()[state.selected],
+    canBack: () => state.index > 0,
+    canForward: () => state.index >= 0 && state.index < state.history.length - 1,
+    canUp: () => state.directory !== undefined && path.dirname(state.directory) !== state.directory,
+    open: (value: string) => load(resolve(value), "push"),
+    submit: () => load(resolve(state.input), "push"),
+    retry: () =>
+      state.error && request.failed
+        ? load(request.failed.target, request.failed.history, request.failed.index)
+        : Promise.resolve(false),
+    refresh: () => (state.directory ? load(state.directory, "replace") : Promise.resolve(false)),
+    home: () => load(path.resolve(input.home), "push"),
+    root: () => load(path.parse(state.directory ?? input.location().directory).root, "push"),
+    up: () => {
+      if (!state.directory || path.dirname(state.directory) === state.directory) return Promise.resolve(false)
+      return load(path.dirname(state.directory), "push")
+    },
+    back: () => (state.index > 0 ? load(state.history[state.index - 1], "back") : Promise.resolve(false)),
+    forward: () =>
+      state.index >= 0 && state.index < state.history.length - 1
+        ? load(state.history[state.index + 1], "forward")
+        : Promise.resolve(false),
+    enter: () => {
+      const entry = visible()[state.selected]
+      return entry ? load(entry.absolute, "push") : Promise.resolve(false)
+    },
+    setInput: (value: string) => setState("input", value),
+    setFilter: (value: string) => setState({ filter: value, selected: 0 }),
+    select: (index: number) => setState("selected", Math.max(0, Math.min(index, visible().length - 1))),
+    move: (delta: number) => {
+      const count = visible().length
+      if (count === 0) return
+      setState("selected", (state.selected + delta + count) % count)
+    },
+    cancel: () => {
+      request.controller?.abort()
+      request.controller = undefined
+      request.generation++
+      setState("pending", undefined)
+    },
+  }
+}
+
+function describeError(target: string, error: unknown): FolderBrowserError {
+  if (isFileNotFoundError(error))
+    return { path: target, kind: "not-found", message: `Folder not found or not a directory: ${target}` }
+  if (error instanceof ClientError && error.reason === "UnexpectedStatus")
+    return {
+      path: target,
+      kind: "unavailable",
+      message: `Cannot open folder ${target}: it may be unreadable (${error.message}). Edit the path or go Back.`,
+    }
+  return {
+    path: target,
+    kind: "failed",
+    message: `Cannot open folder ${target}: ${error instanceof Error ? error.message : String(error)}. Retry, edit the path, or go Back.`,
+  }
+}
