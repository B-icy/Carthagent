+    fetch: async (url, request) => {
+      if (request.method !== "GET" && url.pathname.includes("ses_existing")) mutations.push(url.pathname)
+      if (options.existing && url.pathname === "/api/session" && request.method === "GET")
+        return json({ data: [info(existing)], cursor: {} })
+      if (url.pathname === "/api/session/ses_existing") return json({ data: info(existing) })
+      if (url.pathname === "/api/session/ses_existing/message")
+        return json({
+          data: [{ id: "msg_original", type: "user", text: "Original transcript line", time: { created: 1 } }],
+          cursor: {},
+        })
+      const location = { directory: url.searchParams.get("location[directory]") ?? launch }
+      if (url.pathname === "/api/agent")
+        return json({ location, data: [{ id: "build", mode: "primary", hidden: false, permissions: [] }] })
+      if (url.pathname === "/api/provider") return json({ location, data: [{ id: "demo", name: "Demo" }] })
+      if (url.pathname === "/api/model")
+        return json({
+          location,
+          data: [
+            { id: "alpha", providerID: "demo", name: "Alpha Model", variants: [], time: { released: 2 }, cost: [] },
+            { id: "beta", providerID: "demo", name: "Beta Model", variants: [], time: { released: 1 }, cost: [] },
+          ],
+        })
+      if (url.pathname === "/api/fs/list") {
+        const target = url.searchParams.get("path") ?? location.directory
+        return json({ location: { directory: target }, data: [] })
+      }
+      if (url.pathname === "/api/session" && request.method === "POST") {
+        const record: Created = await request.json()
+        created.push(record)
+        await release.promise
+        return json({ data: info(record) })
+      }
+      if (/^\/api\/session\/[^/]+\/prompt$/.test(url.pathname)) {
+        prompts.push({ sessionID: url.pathname.split("/")[3] ?? "", body: await request.json() })
+        return json({ data: {} })
+      }
+      if (/^\/api\/session\/[^/]+\/(message|inbox|permission)$/.test(url.pathname))
+        return json({ data: [], cursor: {} })
+      if (/^\/api\/session\/[^/]+\/(agent|model)$/.test(url.pathname)) return new Response(null, { status: 204 })
+      if (/^\/api\/session\/[^/]+$/.test(url.pathname)) {
+        const record = created.find((item) => item.id === url.pathname.split("/")[3])
+        if (!record) return json({ message: "not found" }, { status: 404 })
+        return json({ data: info(record) })
+      }
+      return undefined
+    },
+  })
+  return { setup, scratch, chosen, created, prompts, mutations, release }
+}
+
+async function chooseFolder(run: Awaited<ReturnType<typeof start>>, frame: () => string) {
+  const setup = run.setup
+  setup.mockInput.pressKey("f")
+  await until(() => frame().includes("Choose folder for new session"), "folder picker", 5000, frame)
+  await until(() => setup.renderer.currentFocusedRenderable instanceof InputRenderable, "filter focus")
+  setup.mockInput.pressTab()
+  const pathInput = setup.renderer.currentFocusedRenderable as InputRenderable
+  pathInput.value = run.chosen
+  setup.mockInput.pressEnter()
+  // The launch folder is also empty, so the empty-state text alone does not prove the chosen folder has loaded.
+  await until(
+    () =>
+      frame().includes("No subfolders here") &&
+      frame()
+        .split("\n")
+        .some((line) => line.includes(" In ") && line.includes("empty project")),
+    "chosen listing",
+    5000,
+    frame,
+  )
+  setup.mockInput.pressKey("s", { ctrl: true })
+  await until(() => frame().includes("Ready.") && frame().includes("/empty project"), "chosen folder", 5000, frame)
+}
+
+async function until(fn: () => boolean, label: string, timeout = 5000, frame?: () => string) {
+  const begin = Date.now()
+  while (!fn()) {
+    if (Date.now() - begin > timeout) throw new Error(`timed out waiting for ${label}\n${frame?.() ?? ""}`)
+    await Bun.sleep(10)
+  }
+}
+
+test("setup opens and cancels without creating, then the first send creates one session with the chosen folder and model", async () => {
+  const run = await start()
+  await using scratch = run.scratch
+  await using setup = run.setup
+  const frame = () => setup.captureCharFrame()
+  await setup.ready
+  await setup.waitForFrame((value) => value.includes("Alpha Model"))
+  await setup.mockInput.typeText("draft marker")
+  await until(() => frame().includes("draft marker"), "draft")
+
+  setup.mockInput.pressKey("F6")
+  await until(() => frame().includes("Ready."), "setup ready")
+  expect(frame()).toContain(launch)
+  setup.mockInput.pressEscape()
+  await until(() => !frame().includes("Ready."), "setup closed")
+  await until(() => frame().includes("draft marker"), "draft kept")
+  expect(run.created).toEqual([])
+
+  setup.mockInput.pressKey("F6")
+  await until(() => frame().includes("Ready."), "setup reopened")
+  await chooseFolder(run, frame)
+
+  setup.mockInput.pressKey("m")
+  await until(() => setup.renderer.currentFocusedRenderable instanceof InputRenderable, "model focus")
+  await setup.mockInput.typeText("Beta")
+  await until(() => frame().includes("Beta Model"), "beta option")
+  setup.mockInput.pressEnter()
+  await until(() => frame().includes("Ready.") && frame().includes("demo/beta"), "beta chosen", 5000, frame)
+  expect(run.created).toEqual([])
+
+  setup.mockInput.pressEnter()
+  await until(() => !frame().includes("Ready.") && frame().includes("Beta Model"), "home with beta", 5000, frame)
+  await until(() => frame().includes("draft marker"), "draft carried", 5000, frame)
+  expect(run.created).toEqual([])
+
+  setup.mockInput.pressEnter()
+  setup.mockInput.pressEnter()
+  await until(() => run.created.length === 1, "create")
+  setup.mockInput.pressEnter()
+  run.release.resolve()
+  await until(() => run.prompts.length === 1, "prompt")
+  await Bun.sleep(100)
+  expect(run.created).toHaveLength(1)
+  expect(run.created[0]).toMatchObject({
+    location: { directory: run.chosen },
+    agent: "build",
+    model: { providerID: "demo", id: "beta" },
+  })
+  expect(run.prompts).toHaveLength(1)
+  expect(run.prompts[0]?.sessionID).toBe(run.created[0]?.id ?? "")
+  expect(JSON.stringify(run.prompts[0]?.body)).toContain("draft marker")
+})
+
+test("preparing a new session from an existing one leaves its model, transcript and draft untouched", async () => {
+  const run = await start({ existing: true })
+  await using scratch = run.scratch
+  await using setup = run.setup
+  const frame = () => setup.captureCharFrame()
+  await setup.ready
+  await until(() => frame().includes("Original transcript line") && frame().includes("Alpha Model"), "existing", 8000, frame)
+  await setup.mockInput.typeText("existing draft")
+  await until(() => frame().includes("existing draft"), "existing draft")
+
+  setup.mockInput.pressKey("F6")
+  await until(() => frame().includes("Ready."), "setup", 5000, frame)
+  setup.mockInput.pressKey("m")
+  await until(() => setup.renderer.currentFocusedRenderable instanceof InputRenderable, "model focus")
+  await setup.mockInput.typeText("Beta")
+  await until(() => frame().includes("Beta Model"), "beta option")
+  setup.mockInput.pressEnter()
+  await until(() => frame().includes("demo/beta"), "beta chosen", 5000, frame)
+  setup.mockInput.pressEscape()
+  await until(() => !frame().includes("Ready."), "setup cancelled")
+  await until(() => frame().includes("existing draft") && frame().includes("Alpha Model"), "existing kept", 5000, frame)
+  expect(frame()).toContain("Original transcript line")
+  expect(run.created).toEqual([])
+
+  setup.mockInput.pressKey("F6")
+  await until(() => frame().includes("Ready."), "setup again", 5000, frame)
+  await chooseFolder(run, frame)
+  setup.mockInput.pressKey("m")
+  await until(() => setup.renderer.currentFocusedRenderable instanceof InputRenderable, "model focus again")
+  await setup.mockInput.typeText("Beta")
+  await until(() => frame().includes("Beta Model"), "beta option again")
+  setup.mockInput.pressEnter()
+  await until(() => frame().includes("demo/beta"), "beta chosen again", 5000, frame)
+  setup.mockInput.pressEnter()
+  await until(() => !frame().includes("Original transcript line") && frame().includes("Beta Model"), "home", 5000, frame)
+  expect(frame()).not.toContain("existing draft")
+
+  await setup.mockInput.typeText("first new prompt")
+  setup.mockInput.pressEnter()
+  run.release.resolve()
+  await until(() => run.prompts.length === 1, "new prompt", 5000, frame)
+  expect(run.created[0]).toMatchObject({ location: { directory: run.chosen }, model: { providerID: "demo", id: "beta" } })
+  expect(run.prompts[0]?.sessionID).not.toBe("ses_existing")
+
+  await until(() => frame().includes("Original session"), "original tab", 5000, frame)
+  const returned = () => frame().includes("Original transcript line")
+  const begin = Date.now()
+  // The rail can still be settling after the new session appears, so a click may land before rows stop moving.
+  while (!returned() && Date.now() - begin < 5000) {
+    const lines = frame().split("\n")
+    const row = lines.findIndex((line) => line.includes("Original session"))
+    await setup.mockMouse.click(lines[row]!.indexOf("Original session") + 2, row)
+    await Bun.sleep(200)
+  }
+  await until(
+    () => frame().includes("Original transcript line") && frame().includes("existing draft"),
+    "returned",
+    5000,
+    frame,
+  )
+  expect(frame()).toContain("Alpha Model")
+  expect(run.mutations).toEqual([])
+  expect(run.created).toHaveLength(1)
+  expect(run.prompts).toHaveLength(1)
+})
