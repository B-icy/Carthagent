@@ -0,0 +1,80 @@
+import { expect, test } from "bun:test"
+import { InputRenderable, TextareaRenderable } from "@opentui/core"
+import { createTestRenderer } from "@opentui/core/testing"
+import { installCombiningMarkInput } from "../../src/util/combining-input"
+
+installCombiningMarkInput()
+
+const codepoints = (text: string) => [...text].map((char) => char.codePointAt(0)!.toString(16))
+
+async function setup() {
+  const app = await createTestRenderer({ width: 40, height: 4, useThread: false })
+  const textarea = new TextareaRenderable(app.renderer, { width: 30, height: 2 })
+  app.renderer.root.add(textarea)
+  textarea.focus()
+  return { ...app, textarea }
+}
+
+function typeEach(app: Awaited<ReturnType<typeof setup>>, chars: string[]) {
+  for (const char of chars) app.mockInput.pressKey(char)
+}
+
+test("typed combining marks stay on the character they follow", async () => {
+  const app = await setup()
+  typeEach(app, ["x", "e", "\u0301", "Z", " ", "n", "\u0303", " ", "a", "\u030a", "|"])
+  expect(codepoints(app.textarea.plainText)).toEqual(codepoints("xe\u0301Z n\u0303 a\u030a|"))
+  app.renderer.destroy()
+})
+
+test("stacked typed marks and marks after wide characters keep their order", async () => {
+  const app = await setup()
+  typeEach(app, ["e", "\u0301", "\u0303", "日", "\u0300", "Z"])
+  expect(codepoints(app.textarea.plainText)).toEqual(codepoints("e\u0301\u0303日\u0300Z"))
+  app.renderer.destroy()
+})
+
+test("typed marks on a later line and in the middle of text stay in place", async () => {
+  const app = await setup()
+  app.textarea.insertText("ab\ncd")
+  app.textarea.cursorOffset = 4
+  app.mockInput.pressKey("\u0301")
+  app.mockInput.pressKey("Z")
+  expect(codepoints(app.textarea.plainText)).toEqual(codepoints("ab\nc\u0301Zd"))
+  app.renderer.destroy()
+})
+
+test("backspace after a typed mark removes the whole composed character", async () => {
+  const app = await setup()
+  typeEach(app, ["x", "e", "\u0301"])
+  app.mockInput.pressBackspace()
+  app.mockInput.pressKey("Z")
+  expect(app.textarea.plainText).toBe("xZ")
+  app.renderer.destroy()
+})
+
+test("precomposed, CJK, Arabic, emoji and pasted text are unchanged", async () => {
+  const app = await setup()
+  typeEach(app, ["é", "ü", "ñ", "日", "한", "ب", "\u064e", "😀"])
+  await app.mockInput.pasteBracketedText("Pe\u0301|")
+  expect(codepoints(app.textarea.plainText)).toEqual(codepoints("éüñ日한ب\u064e😀Pe\u0301|"))
+  app.renderer.destroy()
+})
+
+test("a prevented key down still blocks a typed mark", async () => {
+  const app = await setup()
+  typeEach(app, ["x", "e"])
+  app.textarea.onKeyDown = (event) => event.preventDefault()
+  app.mockInput.pressKey("\u0301")
+  expect(app.textarea.plainText).toBe("xe")
+  app.renderer.destroy()
+})
+
+test("single-line inputs keep typed marks too", async () => {
+  const app = await createTestRenderer({ width: 40, height: 4, useThread: false })
+  const input = new InputRenderable(app.renderer, { width: 30 })
+  app.renderer.root.add(input)
+  input.focus()
+  for (const char of ["c", "a", "f", "e", "\u0301", "!"]) app.mockInput.pressKey(char)
+  expect(codepoints(input.value)).toEqual(codepoints("cafe\u0301!"))
+  app.renderer.destroy()
+})
