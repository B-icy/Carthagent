@@ -0,0 +1,386 @@
+import { InputRenderable } from "@opentui/core"
+import { expect, test } from "bun:test"
+import { mkdir } from "node:fs/promises"
+import path from "node:path"
+import { takeDraft } from "../../src/component/prompt/draft-stash"
+import { createAppFixture } from "../fixture/app"
+import { tmpdir } from "../fixture/fixture"
+import { json } from "../fixture/tui-client"
+
+type Created = {
+  id?: string
+  location?: { directory: string }
+  agent?: string
+  model?: { providerID: string; id: string }
+}
+
+const launch = "/tmp/opencode/packages/tui"
+
+function info(record: Created) {
+  return {
+    ...record,
+    location: record.location ?? { directory: launch },
+    projectID: "project",
+    cost: 0,
+    tokens: { input: 0, output: 0, reasoning: 0, cache: { read: 0, write: 0 } },
+    time: { created: 0, updated: 0 },
+  }
+}
+
+const existing: Created & { title: string } = {
+  id: "ses_existing",
+  title: "Original session",
+  location: { directory: launch },
+  agent: "build",
+  model: { providerID: "demo", id: "alpha" },
+}
+
+async function start(options: { existing?: boolean; elsewhere?: boolean; newLocation?: "launch" | "inherit" } = {}) {
+  // Fixtures reuse this tab identity; drafts persist across app remounts in the same process.
+  takeDraft("ses_existing")
+  takeDraft(undefined)
+  const scratch = await tmpdir()
+  const chosen = path.join(scratch.path, "empty project")
+  await mkdir(chosen)
+  const elsewhere = path.join(scratch.path, "session folder")
+  await mkdir(elsewhere)
+  const original = options.elsewhere ? { ...existing, location: { directory: elsewhere } } : existing
+  const created: Created[] = []
+  const prompts: { sessionID: string; body: unknown }[] = []
+  const mutations: string[] = []
+  const release = Promise.withResolvers<void>()
+  const setup = await createAppFixture({
+    config: {
+      animations: false,
+      keybinds: { "session.new.setup": "f6", "session.new": "f7" },
+      ...(options.newLocation ? { session: { new_location: options.newLocation } } : {}),
+    },
+    args: options.existing ? { sessionID: "ses_existing" } : {},
+    fetch: async (url, request) => {
+      if (request.method !== "GET" && url.pathname.includes("ses_existing")) mutations.push(url.pathname)
+      if (options.existing && url.pathname === "/api/session" && request.method === "GET")
+        return json({ data: [info(original)], cursor: {} })
+      if (url.pathname === "/api/session/ses_existing") return json({ data: info(original) })
+      if (url.pathname === "/api/session/ses_existing/message")
+        return json({
+          data: [{ id: "msg_original", type: "user", text: "Original transcript line", time: { created: 1 } }],
+          cursor: {},
+        })
+      const location = { directory: url.searchParams.get("location[directory]") ?? launch }
+      if (url.pathname === "/api/agent")
+        return json({ location, data: [{ id: "build", mode: "primary", hidden: false, permissions: [] }] })
+      if (url.pathname === "/api/provider") return json({ location, data: [{ id: "demo", name: "Demo" }] })
+      if (url.pathname === "/api/model")
+        return json({
+          location,
+          data: [
+            { id: "alpha", providerID: "demo", name: "Alpha Model", variants: [], time: { released: 2 }, cost: [] },
+            { id: "beta", providerID: "demo", name: "Beta Model", variants: [], time: { released: 1 }, cost: [] },
+          ],
+        })
+      if (url.pathname === "/api/fs/list") {
+        const target = url.searchParams.get("path") ?? location.directory
+        return json({ location: { directory: target }, data: [] })
+      }
+      if (url.pathname === "/api/session" && request.method === "POST") {
+        const record: Created = await request.json()
+        created.push(record)
+        await release.promise
+        return json({ data: info(record) })
+      }
+      if (/^\/api\/session\/[^/]+\/prompt$/.test(url.pathname)) {
+        prompts.push({ sessionID: url.pathname.split("/")[3] ?? "", body: await request.json() })
+        return json({ data: {} })
+      }
+      if (/^\/api\/session\/[^/]+\/(message|inbox|permission)$/.test(url.pathname))
+        return json({ data: [], cursor: {} })
+      if (/^\/api\/session\/[^/]+\/(agent|model)$/.test(url.pathname)) return new Response(null, { status: 204 })
+      if (/^\/api\/session\/[^/]+$/.test(url.pathname)) {
+        const record = created.find((item) => item.id === url.pathname.split("/")[3])
+        if (!record) return json({ message: "not found" }, { status: 404 })
+        return json({ data: info(record) })
+      }
+      return undefined
+    },
+  })
+  return { setup, scratch, chosen, elsewhere, created, prompts, mutations, release }
+}
+
+/** The app launches in the test process cwd; the setup shows it, left-truncated, rather than the session's folder. */
+function expectLaunchFolder(frame: string) {
+  const row = setupFolder(frame)
+  expect(row).toContain(path.basename(process.cwd()))
+  expect(row).not.toContain("session folder")
+}
+
+/** The folder shown on the setup's Folder row, so the rail's own folder card cannot satisfy the check. */
+function setupFolder(frame: string) {
+  return frame.split("\n").find((line) => /^\W*Folder\s/.test(line.trimStart())) ?? ""
+}
+
+async function chooseFolder(run: Awaited<ReturnType<typeof start>>, frame: () => string) {
+  const setup = run.setup
+  setup.mockInput.pressKey("p", { ctrl: true })
+  await until(() => frame().includes("Choose folder for new session"), "folder picker", 5000, frame)
+  await until(() => setup.renderer.currentFocusedRenderable instanceof InputRenderable, "filter focus")
+  setup.mockInput.pressTab()
+  const pathInput = setup.renderer.currentFocusedRenderable as InputRenderable
+  pathInput.value = run.chosen
+  setup.mockInput.pressEnter()
+  // The launch folder is also empty, so the empty-state text alone does not prove the chosen folder has loaded.
+  await until(
+    () =>
+      frame().includes("No subfolders here") &&
+      frame()
+        .split("\n")
+        .some((line) => line.includes("empty project")),
+    "chosen listing",
+    5000,
+    frame,
+  )
+  setup.mockInput.pressKey("s", { ctrl: true })
+  await until(
+    () => frame().includes("Ready.") && frame().includes(`${path.sep}empty project`),
+    "chosen folder",
+    5000,
+    frame,
+  )
+}
+
+async function until(fn: () => boolean, label: string, timeout = 5000, frame?: () => string) {
+  const begin = Date.now()
