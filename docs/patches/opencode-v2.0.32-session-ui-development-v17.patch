diff --git a/packages/tui/src/routes/session/plan-items.ts b/packages/tui/src/routes/session/plan-items.ts
new file mode 100644
index 0000000000..8567baf896
--- /dev/null
+++ b/packages/tui/src/routes/session/plan-items.ts
@@ -0,0 +1,33 @@
+import type { SessionMessageInfo } from "@opencode/client"
+
+export type PlanItem = { id: string; content: string; status: string }
+
+// Only server-authored snapshots count. Proposed tool inputs and failed calls
+// are not accepted plans; Code Mode publishes the same snapshot on execute.
+export function planItems(messages: SessionMessageInfo[]): PlanItem[] {
+  for (const message of [...messages].reverse()) {
+    if (message.type !== "assistant") continue
+    for (const part of [...message.content].reverse()) {
+      if (part.type !== "tool" || part.state.status !== "completed") continue
+      const snapshot = part.state.metadata?.deliveryPlan
+      if (!snapshot || typeof snapshot !== "object" || Array.isArray(snapshot) || !Array.isArray(snapshot.items))
+        continue
+      if (typeof snapshot.runId !== "string" || !Number.isSafeInteger(snapshot.revision)) continue
+      return snapshot.items.flatMap((item: unknown) => {
+        if (!item || typeof item !== "object") return []
+        const row = item as { id?: unknown; content?: unknown; status?: unknown }
+        if (typeof row.id !== "string" || typeof row.content !== "string" || !row.content.trim()) return []
+        const status =
+          row.status === "done"
+            ? "completed"
+            : row.status === "active"
+              ? "in_progress"
+              : row.status === "failed"
+                ? "failed"
+                : "pending"
+        return [{ id: row.id, content: row.content, status }]
+      })
+    }
+  }
+  return []
+}
diff --git a/packages/tui/src/routes/session/plan-view.tsx b/packages/tui/src/routes/session/plan-view.tsx
new file mode 100644
index 0000000000..4f552077af
--- /dev/null
+++ b/packages/tui/src/routes/session/plan-view.tsx
@@ -0,0 +1,85 @@
+import { For, Show, createMemo, createSignal } from "solid-js"
+import { useTheme } from "../../context/theme"
+import { Locale } from "../../util/locale"
+import { chromeGlyph } from "../../ui/glyphs"
+import type { SessionMessageInfo } from "@opencode/client"
+import { planItems } from "./plan-items"
+
+export const [planGraphVisible, setPlanGraphVisible] = createSignal(false)
+
+export function togglePlanGraph() {
+  setPlanGraphVisible((visible) => !visible)
+}
+
+const STATUS_ORDER = ["completed", "in_progress", "failed", "pending", "cancelled"]
+
+export function PlanView(props: { messages: () => SessionMessageInfo[] }) {
+  const theme = useTheme()
+  const items = createMemo(() => planItems(props.messages()))
+
+  const nodeColor = (status: string) =>
+    status === "failed" ? theme.text.feedback.error.base : status === "completed"
+      ? theme.text.feedback.success.base
+      : status === "in_progress"
+        ? theme.text.action.secondary.base
+        : status === "cancelled"
+          ? theme.text.muted
+          : theme.text.base
+
+  const glyph = (status: string) =>
+    status === "failed" ? "!" : status === "completed" ? "■" : status === "in_progress" ? "◐" : status === "cancelled" ? "×" : "□"
+
+  const counts = createMemo(() => {
+    const tally = new Map<string, number>()
+    for (const item of items()) tally.set(item.status, (tally.get(item.status) ?? 0) + 1)
+    return STATUS_ORDER.filter((status) => tally.has(status)).map(
+      (status) => `${tally.get(status)} ${status.replace("_", " ")}`,
+    )
+  })
+
+  return (
+    <box flexGrow={1} minHeight={0} paddingTop={1} paddingLeft={1} flexDirection="column">
+      <box flexDirection="row" gap={1} flexShrink={0}>
+        <text fg={theme.text.base} attributes={1}>
+          SHIP PLAN
+        </text>
+        <Show when={counts().length > 0}>
+          <text fg={theme.text.muted}>{counts().join(` ${chromeGlyph("·")} `)}</text>
+        </Show>
+      </box>
+      <Show
+        when={items().length > 0}
+        fallback={
+          <box paddingTop={1} flexShrink={0}>
+            <text fg={theme.text.muted}>No plan yet. Ship records its plan here as it works.</text>
+          </box>
+        }
+      >
+        <For each={items()}>
+          {(item, index) => (
+            <>
+              <Show when={index() > 0}>
+                <box paddingLeft={1} flexShrink={0}>
+                  <text fg={theme.border.base}>{chromeGlyph("│")}</text>
+                </box>
+              </Show>
+              <box flexDirection="row" gap={1} flexShrink={0}>
+                <text fg={nodeColor(item.status)}>{chromeGlyph(glyph(item.status))}</text>
+                <text fg={nodeColor(item.status)} wrapMode="word">
+                  {item.content}
+                </text>
+                <Show when={item.status !== "pending" && item.status !== "completed"}>
+                  <text fg={theme.text.muted}>{Locale.titlecase(item.status.replace("_", " "))}</text>
+                </Show>
+              </box>
+            </>
+          )}
+        </For>
+      </Show>
+      <box flexGrow={1} minHeight={0} />
+      <box flexShrink={0}>
+        <text fg={theme.text.muted}>ctrl+x p or /graph returns to chat</text>
+      </box>
+    </box>
+  )
+}
