+        return json({ data: [info(existing)], cursor: {} })
+      if (url.pathname === "/api/session/ses_existing") return json({ data: info(existing) })
+      if (url.pathname === "/api/session/ses_existing/message")
+        return json({
+          data: [{ id: "msg_original", type: "user", text: "Original transcript line", time: { created: 1 } }],
+          cursor: {},
+        })
+      const location = { directory: url.searchParams.get("location[directory]") ?? launch }
+      if (url.pathname === "/api/agent")
+        return json({ location, data: [{ id: "build", mode: "primary", hidden: false, permissions: [] }] })
+      if (url.pathname === "/api/provider") return json({ location, data: [{ id: "demo", name: "Demo" }] })
+      if (url.pathname === "/api/model")
+        return json({
+          location,
+          data: [
+            { id: "alpha", providerID: "demo", name: "Alpha Model", variants: [], time: { released: 2 }, cost: [] },
+            { id: "beta", providerID: "demo", name: "Beta Model", variants: [], time: { released: 1 }, cost: [] },
+          ],
+        })
+      if (url.pathname === "/api/fs/list") {
+        const target = url.searchParams.get("path") ?? location.directory
+        return json({ location: { directory: target }, data: [] })
+      }
+      if (url.pathname === "/api/session" && request.method === "POST") {
+        const record: Created = await request.json()
+        created.push(record)
+        return json({ data: info(record) })
+      }
+      if (/^\/api\/session\/[^/]+\/prompt$/.test(url.pathname)) {
+        prompts.push({ sessionID: url.pathname.split("/")[3] ?? "", body: await request.json() })
+        return json({ data: {} })
+      }
+      if (/^\/api\/session\/[^/]+\/(message|inbox|permission)$/.test(url.pathname))
+        return json({ data: [], cursor: {} })
+      if (/^\/api\/session\/[^/]+\/(agent|model)$/.test(url.pathname)) return new Response(null, { status: 204 })
+      if (/^\/api\/session\/[^/]+$/.test(url.pathname)) {
+        const record = created.find((item) => item.id === url.pathname.split("/")[3])
+        if (!record) return json({ message: "not found" }, { status: 404 })
+        return json({ data: info(record) })
+      }
+      return undefined
+    },
+  })
+  const frame = () => setup.captureCharFrame()
+  await setup.ready
+  await until(() => frame().includes("Original transcript line") && frame().includes("Alpha Model"), "existing", frame, 8000)
+
+  setup.mockInput.pressKey("F6")
+  await until(() => frame().includes("Ready."), "setup", frame)
+  setup.mockInput.pressKey("p", { ctrl: true })
+  await until(() => frame().includes("Choose folder for new session"), "folder picker", frame)
+  await until(() => setup.renderer.currentFocusedRenderable instanceof InputRenderable, "filter focus", frame)
+  setup.mockInput.pressTab()
+  ;(setup.renderer.currentFocusedRenderable as InputRenderable).value = chosen
+  setup.mockInput.pressEnter()
+  await until(() => frame().includes("No subfolders here") && frame().includes("draft project"), "listing", frame)
+  setup.mockInput.pressKey("s", { ctrl: true })
+  await until(() => frame().includes("Ready.") && frame().includes(`${path.sep}draft project`), "chosen", frame)
+  setup.mockInput.pressKey("o", { ctrl: true })
+  await until(
+    () =>
+      setup.renderer.currentFocusedRenderable instanceof InputRenderable &&
+      setup.renderer.currentFocusedRenderable.id !== "new-session-path",
+    "model focus",
+    frame,
+  )
+  await setup.mockInput.typeText("Beta")
+  await until(() => frame().includes("Beta Model"), "beta option", frame)
+  setup.mockInput.pressEnter()
+  await until(() => frame().includes("Ready.") && frame().includes("demo/beta"), "beta chosen", frame)
+  setup.mockInput.pressEnter()
+  await until(() => !frame().includes("Ready.") && !frame().includes("Original transcript line"), "home", frame)
+  await setup.mockInput.typeText("unsent draft ü")
+  await until(() => frame().includes("unsent draft ü") && frame().includes("Beta Model"), "draft on home", frame)
+  return { setup, scratch, chosen, created, prompts, frame }
+}
+
+async function until(fn: () => boolean, label: string, frame?: () => string, timeout = 5000) {
+  const begin = Date.now()
+  while (!fn()) {
+    if (Date.now() - begin > timeout) throw new Error(`timed out waiting for ${label}\n${frame?.() ?? ""}`)
+    await Bun.sleep(10)
+  }
+}
+
+const onSession = (frame: string) => frame.includes("Original transcript line")
+const onDraft = (frame: string, folder: string) =>
+  !onSession(frame) && frame.includes("unsent draft ü") && frame.includes("Beta Model") && frame.includes(folder)
