@@ -0,0 +1,138 @@
+import { TextAttributes, type MouseEvent } from "@opentui/core"
+import { useRenderer } from "@opentui/solid"
+import { createSignal, Show } from "solid-js"
+import path from "path"
+import { useTheme } from "../context/theme"
+import { chromeGlyph } from "../ui/glyphs"
+import { Locale } from "../util/locale"
+import { stringWidth } from "../util/string-width"
+
+const RIGHT_MOUSE_BUTTON = 2
+/** Below this rail width the action row uses short labels so both actions stay on one row. */
+const FULL_ACTION_LABEL_WIDTH = 27
+
+/** Directory-first header of the wide Projects rail: current folder, folder/session actions and model. */
+export function SessionTabsFolderCard(props: {
+  width: number
+  directory?: string
+  model?: string
+  browse?: () => void
+  add?: () => void
+  selectModel?: () => void
+  onMenu?: (event: MouseEvent) => void
+}) {
+  const theme = useTheme()
+  // The overlay is transient, so reading the current width when it renders avoids a permanent resize listener.
+  const renderer = useRenderer()
+  const [pathHovered, setPathHovered] = createSignal(false)
+  // Click pins the full path for terminals or users without hover.
+  const [pathPinned, setPathPinned] = createSignal(false)
+  const inner = () => Math.max(1, props.width - 2)
+  const name = () => {
+    const directory = props.directory ?? ""
+    const base = path.basename(directory) || directory
+    return base.endsWith(path.sep) ? base : `${base}${path.sep}`
+  }
+  const full = () => props.width >= FULL_ACTION_LABEL_WIDTH
+  return (
+    <box id="session-tabs-folder" flexDirection="column" flexShrink={0} position="relative" paddingBottom={1}>
+      <Show when={props.directory}>
+        <box
+          id="session-tabs-folder-path"
+          height={1}
+          paddingLeft={1}
+          flexShrink={0}
+          onMouseOver={() => setPathHovered(true)}
+          onMouseOut={() => setPathHovered(false)}
+          onMouseUp={(event) => {
+            if (event.button !== 0) return
+            event.stopPropagation()
+            setPathPinned((value) => !value)
+          }}
+        >
+          <text fg={theme.text.base} attributes={TextAttributes.BOLD} selectable={false} wrapMode="none">
+            {Locale.takeWidth(name(), inner())}
+          </text>
+        </box>
+      </Show>
+      <Show when={props.browse || props.add}>
+        <box height={1} flexDirection="row" flexShrink={0} gap={1} paddingLeft={1}>
+          <Show when={props.browse}>
+            {(browse) => (
+              <FolderCardButton label={`${chromeGlyph("▤")} ${full() ? "Browse" : "Folder"}`} run={browse()} />
+            )}
+          </Show>
+          <Show when={props.add}>
+            {(add) => (
+              <FolderCardButton label={full() ? "+ New session" : "+ New"} run={add()} onRightClick={props.onMenu} />
+            )}
+          </Show>
+        </box>
+      </Show>
+      <Show when={(pathHovered() || pathPinned()) && props.directory}>
+        {(directory) => (
+          <box
+            position="absolute"
+            top={1}
+            left={0}
+            zIndex={2000}
+            height={1}
+            width={Math.max(1, Math.min(renderer.width, stringWidth(directory()) + 2))}
+            paddingLeft={1}
+            backgroundColor={theme.background.raised.high}
+          >
+            <text fg={theme.text.base} selectable={false} wrapMode="none">
+              {directory()}
+            </text>
+          </box>
+        )}
+      </Show>
+    </box>
+  )
+}
+
+function FolderCardButton(props: {
+  label: string
+  run: () => void
+  onRightClick?: (event: MouseEvent) => void
+}) {
+  const theme = useTheme()
+  const [hovered, setHovered] = createSignal(false)
+  let pressed = false
+  return (
+    <box
+      height={1}
+      flexShrink={0}
+      paddingX={1}
+      backgroundColor={hovered() ? theme.background.raised.max : theme.background.raised.high}
+      onMouseOver={() => setHovered(true)}
+      onMouseOut={() => setHovered(false)}
+      onMouseDown={(event) => {
+        event.stopPropagation()
+        if (event.button === RIGHT_MOUSE_BUTTON) {
+          pressed = false
+          if (!props.onRightClick) return
+          event.preventDefault()
+          props.onRightClick(event)
+          return
+        }
+        pressed = event.button === 0
+      }}
+      onMouseUp={(event) => {
+        event.stopPropagation()
+        if (event.button !== 0 || !pressed) return
+        pressed = false
+        props.run()
+      }}
+      onMouseDragEnd={() => (pressed = false)}
+    >
+      <text
+        fg={theme.text.base}
+        selectable={false}
+        wrapMode="none"
+      >
+        {props.label}
+      </text>
+    </box>
+  )
+}
