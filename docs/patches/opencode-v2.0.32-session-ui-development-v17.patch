+      if (disposed || revision !== focusRevision || engaged() || dialog.stack.length || keymap.mode.current() !== "base" || !remembered || remembered.isDestroyed) return
+      // A route change detaches the old page; its new controls own focus.
+      const current = renderer.currentFocusedRenderable
+      if ((current && !current.isDestroyed && attached(current, renderer.root)) || !attached(remembered, renderer.root)) return
+      remembered.focus()
+    }
+    queueMicrotask(restore)
+    clearTimeout(restoreTimer)
+    restoreTimer = setTimeout(restore, 1)
+  }
+  const focused = () => engaged() && visible() && keymap.mode.current() === "navigation" && dialog.stack.length === 0
+  const focus = () => {
+    if (!visible() || dialog.stack.length || (keymap.mode.current() !== "base" && keymap.mode.current() !== "navigation")) return
+    focusRevision++
+    clearTimeout(restoreTimer)
+    if (!engaged()) {
+      // A rail click can natively focus the rail before onMouseUp runs.
+      // Its onMouseDown capture keeps the page control as the return target.
+      const current = renderer.currentFocusedRenderable
+      if (current && current !== target && !(target && contains(target, current))) previous = current
+      current?.blur()
+      release = keymap.mode.push("navigation")
+      setEngaged(true)
+    }
+    // The active contribution may have focused its own control synchronously.
+    queueMicrotask(() => {
+      if (disposed || !focused()) return
+      const current = renderer.currentFocusedRenderable
+      if (current && target?.getChildren().some((child) => child === current || contains(child, current))) return
+      target?.focus()
+    })
+  }
+  createEffect(() => { if (!visible()) blur() })
+  createEffect(() => { if (focused()) focus() })
+  onCleanup(() => {
+    disposed = true
+    focusRevision++
+    clearTimeout(restoreTimer)
+    release?.()
+  })
+  Keymap.createLayer(() => ({
+    mode: "navigation",
+    priority: 100,
+    commands: [{ bind: "escape", title: "Return to page", run: () => blur() }],
+  }))
+  const capture = () => {
+    if (engaged() || dialog.stack.length || keymap.mode.current() !== "base") return
+    const current = renderer.currentFocusedRenderable
+    if (current && current !== target && !(target && contains(target, current))) previous = current
+  }
+  return { ...state, visible, setVisible, engaged, focused, focus, blur, capture, target: (node: BoxRenderable | undefined) => { target = node } }
+}
+
+export function NavigationProvider(props: ParentProps) {
+  return <Context.Provider value={createNavigationHost()}>{props.children}</Context.Provider>
+}
+
+export function useNavigation() {
+  const value = useContext(Context)
+  if (!value) throw new Error("NavigationProvider is missing")
+  return value
+}
+
+export function useOptionalNavigation() {
+  return useContext(Context)
+}
+
+function contains(parent: Renderable, target: Renderable): boolean {
+  return parent.getChildren().some((child) => child === target || contains(child, target))
+}
+
+function attached(node: Renderable, root: Renderable) {
+  let current: Renderable = node
+  while (current.parent) current = current.parent
+  return current === root
+}
