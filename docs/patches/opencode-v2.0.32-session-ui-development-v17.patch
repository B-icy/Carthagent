+export function removeSessionFolder(folders: SessionFolder[], tabs: SessionTab[], folderID: string) {
+  return {
+    folders: folders.filter((folder) => folder.id !== folderID),
+    tabs: tabs.map((tab) => (tab.folderID === folderID ? { sessionID: tab.sessionID, title: tab.title } : tab)),
