+  // The draft keeps its own row in the rail while another tab is active.
+  await until(() => frame().includes("New session · unsent"), "draft row kept", frame)
+
+  setup.mockInput.pressArrow("up", { meta: true })
+  await until(() => onDraft(frame(), "draft project"), "back to the draft by alt+up", frame)
+
+  setup.mockInput.pressArrow("up", { meta: true })
+  await until(() => onSession(frame()), "session again", frame)
+  setup.mockInput.pressArrow("down", { meta: true })
+  await until(() => onDraft(frame(), "draft project"), "back to the draft by alt+down", frame)
+
+  await Bun.sleep(100)
+  expect(run.created).toEqual([])
+  expect(run.prompts).toEqual([])
+})
