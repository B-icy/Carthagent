new file mode 100644
index 0000000000..0456c72ac4
--- /dev/null
+++ b/packages/tui/src/component/dialog-new-session.tsx
@@ -0,0 +1,346 @@
+import { batch, createEffect, createMemo, createSignal, Match, onCleanup, onMount, Show, Switch } from "solid-js"
+import { InputRenderable } from "@opentui/core"
+import path from "path"
+import type { OpenCodeClient } from "@opencode/client"
+import { useData } from "../context/data"
+import { useLocal } from "../context/local"
+import { useLocation } from "../context/location"
+import { Keymap } from "../context/keymap"
+import { useRoute } from "../context/route"
+import { useTheme } from "../context/theme"
+import type { ModelPreferenceModel } from "../model-preference"
+import { DialogHeader, DialogLayout, useDialog } from "../ui/dialog"
+import { chromeEllipsis, chromeLabel } from "../ui/glyphs"
+import { Locale } from "../util/locale"
+import { stringWidth } from "../util/string-width"
+import { useTerminalDimensions } from "@opentui/solid"
+import { DialogFolderBrowser } from "./dialog-folder-browser"
+import { DialogModel } from "./dialog-model"
+
+/**
+ * `agent` and `variant` are the caller's effective choices captured when setup opened; `variant` is undefined for
+ * the model's default and is only carried when the chosen model is the caller's own.
+ */
+export type NewSessionChoice = { directory: string; agent?: string; model: ModelPreferenceModel; variant?: string }
+
+/**
+ * Folder/model setup shown before a new session's first prompt. It only collects choices: the session
+ * is created by the normal first-message flow, so opening, confirming or cancelling creates nothing.
+ */
+export function DialogNewSession(props: {
+  file: Pick<OpenCodeClient["file"], "list"> & Partial<Pick<OpenCodeClient["file"], "mkdir">>
+  home: string
+  directory: string
+  /** Location the folder check is anchored to; defaults to the checked folder itself. */
+  anchor?: string
+  onStart: (choice: NewSessionChoice) => void
+}) {
+  const dialog = useDialog()
+  const data = useData()
+  const local = useLocal()
+  const theme = useTheme().surface("dialog")
+  const [view, setView] = createSignal<"setup" | "folder" | "model">("setup")
+  const [directory, setDirectory] = createSignal(props.directory)
+  const [draft, setDraft] = createSignal(props.directory)
+  const [field, setField] = createSignal<"path" | "model">("path")
+  const [completion, setCompletion] = createSignal("")
+  let pathInput: InputRenderable | undefined
+  const resolve = (value: string) => path.resolve(props.directory, value === "~" ? props.home : value.startsWith("~/") ? path.join(props.home, value.slice(2)) : value || ".")
+  const dirty = () => resolve(draft()) !== resolve(directory())
+  createEffect(() => {
+    const value = draft()
+    setCompletion("")
+    if (value === props.directory || !value) return
+    const controller = new AbortController()
+    const timer = setTimeout(async () => {
+      const target = resolve(value)
+      const trailing = /[\\/]$/.test(value)
+      const parent = trailing ? target : path.dirname(target)
+      const prefix = trailing ? "" : path.basename(target)
+      const result = await props.file.list({ location: { directory: props.anchor ?? props.directory }, path: parent }, { signal: controller.signal }).catch(() => undefined)
+      if (controller.signal.aborted || !result) return
+      const names = result.data.filter((entry) => entry.type === "directory")
+        .map((entry) => path.basename(entry.path.replace(/[\\/]$/, "")))
+        .filter((name) => name.startsWith(prefix) && (prefix.startsWith(".") || !name.startsWith("."))).sort()
+      if (names[0]) setCompletion(names[0].slice(prefix.length) + path.sep)
+    }, 120)
+    onCleanup(() => { clearTimeout(timer); controller.abort() })
+  })
+  // Snapshot the caller before anything changes route or location; nested views only edit pending choices.
+  const caller = { agent: local.agent.missing() ?? local.agent.current()?.id, selection: local.model.selection() }
+  const [model, setModel] = createSignal<ModelPreferenceModel | undefined>(
+    caller.selection && { providerID: caller.selection.providerID, modelID: caller.selection.modelID },
+  )
+  const [check, setCheck] = createSignal<{ directory: string; error?: string; ready?: boolean }>({
+    directory: props.directory,
+  })
+  let generation = 0
+  let closed = false
+  let controller: AbortController | undefined
+  onCleanup(() => {
+    closed = true
+    generation++
+    controller?.abort()
+  })
+
+  /** `listed` skips the folder check when the caller has just verified the folder exists. */
+  async function validate(target: string, listed = false) {
+    controller?.abort()
+    const attempt = ++generation
+    const signal = (controller = new AbortController()).signal
+    setCheck({ directory: target })
+    const ref = { directory: target }
+    const error = await (
+      listed
+        ? Promise.resolve()
+        : props.file.list({ location: { directory: props.anchor ?? target }, path: target }, { signal })
+    )
+      .then(async () => {
+        if (attempt !== generation) return
+        await data.location.model.sync(ref)
+        await data.location.provider.sync(ref).catch(() => undefined)
+      })
+      .then(
+        () => undefined,
+        (cause: unknown) => (cause instanceof Error ? cause.message : String(cause)),
+      )
+    if (attempt !== generation) return
+    setCheck(error ? { directory: target, error } : { directory: target, ready: true })
+  }
+
+  const catalog = createMemo(() => (check().ready ? (data.location.model.list({ directory: directory() }) ?? []) : []))
+  const info = createMemo(() => {
+    const value = model()
+    return value && catalog().find((item) => item.providerID === value.providerID && item.id === value.modelID)
+  })
+  const provider = createMemo(() => {
+    const value = model()
+    if (!value) return
+    return data.location.provider.list({ directory: directory() })?.find((item) => item.id === value.providerID)?.name
+  })
+  // Last resolved display names for a model; a pending or failed folder check has no catalog, and the selection
+  // itself has not changed, so the label keeps these rather than falling back to raw IDs.
+  const known = new Map<string, { provider?: string; name: string }>()
+  const remembered = (value: ModelPreferenceModel) => known.get(`${value.providerID}/${value.modelID}`)
+  if (caller.selection) {
+    const parsed = local.model.parsed()
+    if (local.model.catalogReady && local.model.available(caller.selection))
+      known.set(`${caller.selection.providerID}/${caller.selection.modelID}`, { provider: parsed.provider, name: parsed.model })
+  }
+  createEffect(() => {
+    const value = model()
+    const found = info()
+    if (value && found) known.set(`${value.providerID}/${value.modelID}`, { provider: provider(), name: found.name })
+  })
+  const blocked = createMemo(() => {
+    const current = check()
+    if (current.error) return `Folder unavailable: ${current.error}`
+    if (!current.ready) return chromeLabel("Checking folder…")
+    if (catalog().length === 0) return "No models are available at this folder"
+    if (!model()) return "Choose a model to continue"
+    if (!info()) return "The selected model is unavailable at this folder; choose another"
+  })
+
+  async function commitPath() {
+    if (!dirty()) return
+    const target = resolve(draft())
+    setDirectory(target)
+    await validate(target)
+  }
+
+  async function chooseModel() {
+    if (dirty()) await commitPath()
+    if (closed || view() !== "setup") return
+    setView("model")
+  }
+
+  async function start() {
+    if (view() !== "setup") return
+    await commitPath()
+    const value = model()
+    if (closed || view() !== "setup" || dirty() || blocked() || !value) return
+    dialog.clear()
+    const own =
+      caller.selection?.providerID === value.providerID && caller.selection.modelID === value.modelID
+        ? { variant: caller.selection.variant }
+        : {}
+    props.onStart({
+      directory: directory(),
+      agent: caller.agent,
+      model: { providerID: value.providerID, modelID: value.modelID },
+      ...own,
+    })
+  }
+
+  Keymap.createLayer(() => ({
+    mode: "modal",
+    priority: 1,
+    enabled: view() === "setup",
+    commands: [
+      { bind: "return", title: "Start new session", group: "New session", run: () => field() === "model" ? chooseModel() : start() },
+      { bind: "ctrl+p", title: "Browse folders", group: "New session", run: () => { setView("folder") } },
+      { bind: "ctrl+o", title: "Choose model", group: "New session", run: chooseModel },
+      { bind: "ctrl+l", title: "Edit folder path", group: "New session", run: () => { setField("path"); pathInput?.focus() } },
+      { bind: "tab,shift+tab", title: "Next field", group: "New session", run: () => { setField(field() === "path" ? "model" : "path") } },
+      { bind: "right,end", title: "Complete path", group: "New session", enabled: () => field() === "path" && !!completion() && pathInput?.cursorOffset === pathInput?.value.length, run: () => {
+        setDraft(draft() + completion())
+        if (pathInput && !pathInput.isDestroyed) { pathInput.value = draft(); pathInput.gotoLineEnd() }
+      } },
+    ],
+  }))
+
+  onMount(() => {
+    dialog.setSize("large")
+    void validate(props.directory)
+  })
+
+  const label = (text: string) => (
+    <text flexShrink={0} width={8} fg={theme.text.muted} wrapMode="none">
+      {text}
+    </text>
+  )
+
+  return (
+    <Switch>
+      <Match when={view() === "folder"}>
+        <DialogFolderBrowser
+          file={props.file}
+          anchor={props.anchor ?? directory()}
+          home={props.home}
+          start={resolve(draft())}
+          title="Choose folder for new session"
+          onConfirm={(value) => {
+            setView("setup")
+            setDraft(value)
+            if (value === directory()) return
+            setDirectory(value)
+            void validate(value, true)
+          }}
+          onCancel={() => setView("setup")}
+        />
+      </Match>
+      <Match when={view() === "model"}>
+        <DialogModel
+          location={{ directory: directory() }}
+          current={model()}
+          onSelect={(value) => {
+            setModel(value)
+            setField("path")
+            setView("setup")
+          }}
+          onCancel={() => setView("setup")}
+        />
+      </Match>
+      <Match when={view() === "setup"}>
+        <Setup />
+      </Match>
+    </Switch>
+  )
+
+  // A component of its own so its resize subscription ends while a nested folder/model view is shown.
+  function Setup() {
+    const dimensions = useTerminalDimensions()
+    onMount(() => {
+      const timer = setTimeout(() => { if (field() === "path" && pathInput && !pathInput.isDestroyed) { pathInput.focus(); pathInput.gotoLineEnd() } }, 1)
+      onCleanup(() => clearTimeout(timer))
+    })
+    // Large dialogs are at most 88 cells wide; subtract the side insets and the label column.
+    const fieldWidth = () => Math.max(10, Math.min(dimensions().width - 2, 88) - 14)
+    const clipped = () => field() !== "path" && stringWidth(draft()) > fieldWidth()
+    return (
+      <DialogLayout
+        header={<DialogHeader title="New session" />}
+        footer={{
+          actions: {
+            secondary: [
+              { title: "Browse", key: "ctrl+p", onTrigger: () => setView("folder") },
+              { title: "Model", key: "ctrl+o", onTrigger: chooseModel },
+            ],
+            primary: [{ title: "Start", key: "enter", disabled: !dirty() && !!blocked(), onTrigger: start }],
+          },
+        }}
+      >
+        <box flexDirection="column" gap={0}>
+          <box flexDirection="row" height={1} onMouseUp={() => setField("path")}>
+            {label("Folder")}
+            <box flexGrow={1} height={1}>
+              <input id="new-session-path" ref={pathInput} flexGrow={1} focused={field() === "path"} value={draft()}
+                placeholder="/path or ~/folder" onInput={setDraft}
+                textColor={theme.text.formfield.base} focusedTextColor={theme.text.formfield.base}
+                backgroundColor={theme.background.formfield.base} focusedBackgroundColor={theme.background.formfield.focused}
+                cursorColor={theme.text.formfield.focused} />
+              {/* An unfocused input silently scrolls to the end of a long path; cover it with the path marked as cut. */}
+              <Show when={clipped()}>
+                <text position="absolute" left={0} top={0} width="100%" height={1} fg={theme.text.formfield.base}
+                  bg={theme.background.formfield.base} wrapMode="none" overflow="hidden" selectable={false}>
+                  {Locale.truncateLeftWidth(draft(), fieldWidth(), chromeEllipsis())}
+                </text>
+              </Show>
+            </box>
+          </box>
+          <Show when={completion() && field() === "path"}>
+            <text fg={theme.text.muted} wrapMode="none" truncate>{`        → ${completion()}  · Right to complete`}</text>
+          </Show>
+          <box height={1} />
+          <box flexDirection="row" height={1} backgroundColor={field() === "model" ? theme.background.raised.high : undefined} onMouseUp={(event) => { if (event.button === 0) void chooseModel() }}>
+            {label("Model")}
+            <text fg={theme.text.base} wrapMode="none" overflow="hidden">
+              {Locale.truncate(modelLabel(), fieldWidth(), chromeEllipsis())}
+            </text>
+          </box>
+          <box height={1} />
+          <text
+            fg={
+              check().error
+                ? theme.text.feedback.error.base
+                : blocked() && check().ready
+                  ? theme.text.feedback.warning.base
+                  : theme.text.muted
+            }
+            wrapMode="word"
+          >
+            {dirty() ? "Enter checks this folder and starts · Ctrl+P browses · Tab next field" : blocked() ?? "Ready. The session is created when you send the first message."}
+          </text>
+        </box>
+      </DialogLayout>
+    )
+  }
+
+  function modelLabel() {
+    const value = model()
+    if (!value) return "None selected"
+    const fallback = check().ready ? undefined : remembered(value)
+    const name = info()?.name ?? fallback?.name ?? value.modelID
+    const suffix = check().ready && !info() ? " (unavailable)" : ""
+    return `${provider() ?? fallback?.provider ?? value.providerID} · ${name} [${value.providerID}/${value.modelID}]${suffix}`
+  }
+}
+
+/**
+ * Applies a confirmed setup to Home: the chosen folder becomes the draft location and the captured agent, model and
+ * variant become Home's pending new-session choice before Home can send. Existing sessions are left untouched; the
+ * first send creates the session, blocking rather than substituting if the choice is unavailable by then.
+ */
+export function useNewSessionStart() {
+  const route = useRoute()
+  const location = useLocation()
+  const data = useData()
+  const local = useLocal()
+  return async (choice: NewSessionChoice) => {
+    const ref = { directory: choice.directory }
+    // Home stays mounted across a Home-to-Home navigation, so its unsent text survives; a session's draft is
+    // stashed under that session by its own prompt.
+    batch(() => {
+      route.navigate({ type: "home", location: ref })
+      location.set(ref)
+      local.newSession.prepare({
+        directory: choice.directory,
+        agent: choice.agent,
+        model: choice.model,
+        variant: choice.variant,
+        retainVariant: "variant" in choice,
+      })
+    })
+    await Promise.all([data.location.agent.sync(ref), data.location.model.sync(ref)])
+  }
+}
