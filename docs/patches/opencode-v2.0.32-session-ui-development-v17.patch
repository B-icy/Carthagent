+  await setup.mockMouse.click(lines[row]!.indexOf("New session") + 2, row)
+  await until(() => onDraft(frame(), "draft project"), "draft reopened by click", frame)
+  expect(run.created).toEqual([])
+
+  setup.mockInput.pressEnter()
+  await until(() => run.prompts.length === 1, "first send", frame)
+  expect(run.created).toHaveLength(1)
+  expect(run.created[0]).toMatchObject({
