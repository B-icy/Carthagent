+import { InputRenderable } from "@opentui/core"
+import { test } from "bun:test"
+import { mkdir } from "node:fs/promises"
+import path from "node:path"
+import { createAppFixture } from "../fixture/app"
+import { tmpdir } from "../fixture/fixture"
+import { json } from "../fixture/tui-client"
+
+async function until(fn: () => boolean, label: string, frame: () => string, timeout = 5000) {
+  const start = Date.now()
+  while (!fn()) {
+    if (Date.now() - start > timeout) throw new Error(`timed out waiting for ${label}\n${frame()}`)
+    await Bun.sleep(10)
+  }
+}
+
+test("the Cloud sign-in cue survives repeated Home folder switches", async () => {
+  await using scratch = await tmpdir()
+  const folders = ["first", "second", "third"].map((name) => path.join(scratch.path, name))
+  await Promise.all(folders.map((folder) => mkdir(folder)))
+  const modelRequests: string[] = []
+  await using setup = await createAppFixture({
+    width: 110,
+    height: 36,
+    config: { animations: false, tabs: { mode: "on" }, keybinds: { "session.tab.directory.browse": "f8" } },
+    fetch: async (url) => {
+      const directory = url.searchParams.get("location[directory]") ?? "/tmp/opencode/packages/tui"
+      const location = { directory, project: { id: "project", directory, canonical: directory } }
+      if (url.pathname === "/api/model") {
+        modelRequests.push(directory)
+        return json({ location, data: [] })
+      }
+      if (url.pathname === "/api/provider") return json({ location, data: [] })
+      if (url.pathname === "/api/fs/list") {
+        const target = url.searchParams.get("path") ?? directory
+        return json({ location: { directory: target, project: location.project }, data: [] })
+      }
+      return undefined
+    },
+  })
+  await setup.ready
+  const frame = () => setup.captureCharFrame()
+  await until(() => frame().includes("Continue with Carthagent Cloud"), "initial cue", frame)
+
+  for (const folder of folders) {
+    setup.mockInput.pressKey("F8")
+    await until(() => frame().includes("Browse folders"), "folder browser", frame)
+    await until(() => setup.renderer.currentFocusedRenderable instanceof InputRenderable, "filter focus", frame)
+    setup.mockInput.pressTab()
+    await until(() => (setup.renderer.currentFocusedRenderable as InputRenderable).placeholder?.startsWith("/path") === true, "path focus", frame)
+    ;(setup.renderer.currentFocusedRenderable as InputRenderable).value = folder
+    setup.mockInput.pressEnter()
+    await until(() => frame().includes("No subfolders here") && frame().includes(path.basename(folder)), "listing", frame)
+    setup.mockInput.pressKey("s", { ctrl: true })
+    await until(() => !frame().includes("Browse folders"), "browser closed", frame)
+    await until(() => modelRequests.includes(folder), `model catalog for ${path.basename(folder)}`, frame)
+    await until(() => frame().includes("Continue with Carthagent Cloud"), `cue after ${path.basename(folder)}`, frame)
+  }
+})
