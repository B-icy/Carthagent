@@ -0,0 +1,94 @@
+import { expect } from "bun:test"
+import { SdkPlugins } from "@opencode/core/plugin/sdk"
+import { Plugin } from "@opencode/plugin/effect"
+import { Context, Deferred, Effect, Fiber, Layer } from "effect"
+import { HttpEffect, HttpRouter, HttpServer } from "effect/http"
+import { tmpdirScoped } from "../../core/test/fixture/tmpdir"
+import { it } from "../../core/test/lib/effect"
+import { createRoutes } from "../src/routes"
+
+it.live("OAuth connect waits for a cold location's plugin method registration", () =>
+  Effect.gen(function* () {
+    const tmp = yield* tmpdirScoped("ctg-auth-startup-")
+    const started = yield* Deferred.make<void>()
+    const release = yield* Deferred.make<void>()
+    let authorizations = 0
+    const context = yield* Layer.build(createRoutes({
+      password: "secret", database: { path: ":memory:" }, models: { fetch: false },
+      fs: { filewatcher: false }, config: { directory: tmp.path, project: false },
+    }).pipe(Layer.provide(HttpServer.layerServices)))
+    const sdk = Context.get(context, SdkPlugins.Service)
+    yield* sdk.register(Plugin.define({
+      id: "slow-cloud-auth",
+      effect: (ctx) => Effect.gen(function* () {
+        yield* Deferred.succeed(started, undefined)
+        yield* Deferred.await(release)
+        yield* ctx.integration.transform(editor => {
+          editor.method.update({
+            integrationID: "carthagent-cloud",
+            method: { id: "carthagent-device", type: "oauth", label: "Continue with Carthagent Cloud" },
+            authorize: () => Effect.sync(() => {
+              authorizations++
+              return { mode: "auto" as const, url: "https://example.invalid/activate", instructions: "Fixture only", callback: Effect.never }
+            }),
+          })
+        })
+      }),
+    }))
+    const handler = Context.get(context, HttpRouter.HttpRouter).asHttpEffect().pipe(HttpEffect.toWebHandlerWith(context))
+    const request = (method: string, route: string, body?: unknown) => Effect.promise(signal => {
+      const url = new URL(route, "http://opencode.local")
+      url.searchParams.set("location[directory]", tmp.path)
+      return handler(new Request(url, {
+        method, signal, headers: { authorization: `Basic ${btoa("opencode:secret")}`, "content-type": "application/json" },
+        ...(body ? { body: JSON.stringify(body) } : {}),
+      }))
+    })
+    yield* request("GET", "/api/provider")
+    yield* Deferred.await(started)
+    let completed = false
+    const connect = yield* request("POST", "/api/integration/carthagent-cloud/connect/oauth", { methodID: "carthagent-device" }).pipe(Effect.tap(() => Effect.sync(() => { completed = true })), Effect.forkScoped)
+    // Hold registration across multiple event-loop turns: no real auth or credentials are involved.
+    yield* Effect.sleep("100 millis")
+    const early = completed
+    yield* Deferred.succeed(release, undefined)
+    const response = yield* Fiber.join(connect)
+    const body = yield* Effect.promise(() => response.text())
+    expect({ status: response.status, body }).toMatchObject({ status: 200 })
+    expect(JSON.parse(body)).toMatchObject({ data: { url: "https://example.invalid/activate" } })
+    expect(early).toBe(false)
+    expect(authorizations).toBe(1)
+  }), 15_000)
+
+it.live("plugin inventory waits for cold activation instead of transiently removing mounted plugins", () =>
+  Effect.gen(function* () {
+    const tmp = yield* tmpdirScoped("ctg-plugin-startup-")
+    const started = yield* Deferred.make<void>()
+    const release = yield* Deferred.make<void>()
+    const context = yield* Layer.build(createRoutes({
+      password: "secret", database: { path: ":memory:" }, models: { fetch: false },
+      fs: { filewatcher: false }, config: { directory: tmp.path, project: false },
+    }).pipe(Layer.provide(HttpServer.layerServices)))
+    yield* Context.get(context, SdkPlugins.Service).register(Plugin.define({
+      id: "slow-inventory", effect: () => Effect.gen(function* () {
+        yield* Deferred.succeed(started, undefined)
+        yield* Deferred.await(release)
+      }),
+    }))
+    const handler = Context.get(context, HttpRouter.HttpRouter).asHttpEffect().pipe(HttpEffect.toWebHandlerWith(context))
+    const request = (route: string) => Effect.promise(signal => {
+      const url = new URL(route, "http://opencode.local")
+      url.searchParams.set("location[directory]", tmp.path)
+      return handler(new Request(url, { signal, headers: { authorization: `Basic ${btoa("opencode:secret")}` } }))
+    })
+    yield* request("/api/provider")
+    yield* Deferred.await(started)
+    let completed = false
+    const inventory = yield* request("/api/plugin").pipe(Effect.tap(() => Effect.sync(() => { completed = true })), Effect.forkScoped)
+    yield* Effect.sleep("100 millis")
+    const early = completed
+    yield* Deferred.succeed(release, undefined)
+    const response = yield* Fiber.join(inventory)
+    expect(response.status).toBe(200)
+    expect(early).toBe(false)
+  }), 15_000)
