@@ -0,0 +1,257 @@
+/** @jsxImportSource @opentui/solid */
+import { MouseButton } from "@opentui/core"
+import { testRender } from "@opentui/solid"
+import { expect, test } from "bun:test"
+import path from "node:path"
+import { createSignal } from "solid-js"
+import { ConfigProvider } from "../../src/config"
+import { EMPTY_SESSION_TAB_STATUS, SessionTabs, type SessionTabsController } from "../../src/component/session-tabs"
+import type { SessionTab } from "../../src/context/session-tabs-model"
+import { Keymap } from "../../src/context/keymap"
+import { ThemeProvider } from "../../src/context/theme"
+import { SESSION_TABS_COMPACT_WIDTH } from "../../src/ui/layout"
+import { DialogProvider } from "../../src/ui/dialog"
+import { ToastProvider } from "../../src/ui/toast"
+import { emptyThemeSource } from "../fixture/fixture"
+import { TestTuiContexts } from "../fixture/tui-environment"
+import { createTuiResolvedConfig } from "../fixture/tui-runtime"
+
+const HOME = path.resolve("/tmp/carthagent/home")
+const PROJECT = path.join(HOME, "work", "project")
+
+async function mount(options: {
+  width: number
+  directory?: string
+  tabs?: SessionTab[]
+  active?: string
+  setup?: (directory?: string) => void
+}) {
+  const counts = { browse: 0, add: 0, model: 0, search: 0, group: 0 }
+  const [active, setActive] = createSignal(options.active ?? "alpha")
+  const [items] = createSignal<SessionTab[]>(
+    options.tabs ?? [
+      { sessionID: "alpha", title: "Alpha work" },
+      { sessionID: "beta", title: "Beta work" },
+      { sessionID: "gamma", title: "Grouped idea" },
+    ],
+  )
+  const controller = {
+    tabs: items,
+    current: active,
+    add: () => counts.add++,
+    search: () => counts.search++,
+    browse: () => counts.browse++,
+    selectModel: () => counts.model++,
+    setup: options.setup,
+    model: () => "DeepSeek V4.1 Flash",
+    directory: () => options.directory ?? PROJECT,
+    select: setActive,
+    close() {},
+    move() {},
+    folders: () => [
+      { id: `dir:${PROJECT}`, kind: "directory", directory: PROJECT } as const,
+      { id: "manual:ideas", kind: "manual", name: "Ideas" } as const,
+    ],
+    folderFor: (sessionID: string) => (sessionID === "gamma" ? "manual:ideas" : `dir:${PROJECT}`),
+    createFolder: () => `manual:group-${++counts.group}`,
+    setFolderCollapsed() {},
+    status: (sessionID: string) =>
+      sessionID === "beta" ? { ...EMPTY_SESSION_TAB_STATUS, busy: true } : EMPTY_SESSION_TAB_STATUS,
+  } satisfies SessionTabsController
+  const app = await testRender(
+    () => (
+      <TestTuiContexts paths={{ home: HOME }}>
+        <ConfigProvider config={createTuiResolvedConfig({ tabs: { indicators: "status" } })}>
+          <Keymap.Provider>
+            <ThemeProvider mode="dark" source={emptyThemeSource}>
+              <ToastProvider>
+                <DialogProvider>
+                  <box width="100%" height="100%" flexDirection="row">
+                    <SessionTabs
+                      controller={controller}
+                      orientation="vertical"
+                      animations={false}
+                      width={options.width}
+                    />
+                    <text>transcript</text>
+                  </box>
+                </DialogProvider>
+              </ToastProvider>
+            </ThemeProvider>
+          </Keymap.Provider>
+        </ConfigProvider>
+      </TestTuiContexts>
+    ),
+    { width: 100, height: 30 },
+  )
+  app.renderer.start()
+  const rail = () =>
+    app
+      .captureCharFrame()
+      .split("\n")
+      .map((line) => line.slice(0, options.width))
+  const row = (text: string) => rail().findIndex((line) => line.includes(text))
+  return { app, counts, active, rail, row }
+}
+
+test("wide rail shows folder and sessions without redundant paths, model or idle labels", async () => {
+  const ui = await mount({ width: 30 })
+  try {
+    await ui.app.waitForFrame((frame) => frame.includes("Alpha work") && frame.includes("New session"))
+    const folder = ui.row(`project${path.sep}`)
+    const actions = ui.row("Browse")
+    const sessions = ui.row("Sessions")
+    const firstGroup = ui.row(`▾ project${path.sep}`)
+    expect(folder).toBeGreaterThanOrEqual(0)
+    expect([folder, actions, sessions, firstGroup]).toEqual(
+      [folder, actions, sessions, firstGroup].toSorted((a, b) => a - b),
+    )
+    expect(new Set([folder, actions, sessions]).size).toBe(3)
+    expect(ui.app.captureCharFrame()).not.toContain("DeepSeek V4.1 Flash")
+    expect(ui.app.captureCharFrame()).not.toContain("Current session")
+    expect(ui.app.captureCharFrame()).not.toContain("Ready")
+    expect(ui.app.captureCharFrame()).toContain("Working")
+    expect(firstGroup).toBeGreaterThan(sessions)
+    expect(ui.rail()[actions]).toContain("New session")
+    expect(ui.rail()[sessions]).toContain("Search")
+    expect(ui.rail()[sessions]).toContain("More")
+    expect(ui.app.captureCharFrame()).not.toContain("+ Folder")
+    expect(ui.rail().filter((line) => line.includes("New session")).length).toBe(1)
+  } finally {
+    ui.app.renderer.destroy()
+  }
+})
+
+test("folder actions are mouse targets that never change the active session", async () => {
+  const ui = await mount({ width: 30 })
+  try {
+    await ui.app.waitForFrame((frame) => frame.includes("Alpha work"))
+    const click = async (text: string) => {
+      const row = ui.row(text)
+      await ui.app.mockMouse.click(ui.rail()[row].indexOf(text), row)
+    }
+    await click("Browse")
+    await click("New session")
+    await click("Search")
+    expect(ui.counts).toMatchObject({ browse: 1, add: 1, model: 0, search: 1 })
+    await click("More")
+    await ui.app.waitForFrame((frame) => frame.includes("New group"))
+    expect(ui.active()).toBe("alpha")
+  } finally {
+    ui.app.renderer.destroy()
+  }
+})
+
+test("filesystem folders and virtual groups are labelled differently", async () => {
+  const ui = await mount({ width: 30 })
+  try {
+    await ui.app.waitForFrame((frame) => frame.includes("Grouped idea"))
+    expect(ui.row(`▾ project${path.sep}`)).toBeGreaterThan(0)
+    const group = ui.rail()[ui.row("Ideas")]
+    expect(group).toContain("# Ideas")
+    expect(group).not.toContain(`Ideas${path.sep}`)
+  } finally {
+    ui.app.renderer.destroy()
+  }
+})
+
+test("active session keeps a marker distinct from hover focus and busy status", async () => {
+  const ui = await mount({ width: 30 })
+  try {
+    await ui.app.waitForFrame((frame) => frame.includes("Beta work"))
+    const marker = () => ui.rail().flatMap((line, index) => (line.startsWith("▎") ? [index] : []))
+    const alpha = ui.row("Alpha work")
+    const beta = ui.row("Beta work")
+    expect(marker()).toContain(alpha)
+    expect(marker()).not.toContain(beta)
+    await ui.app.mockMouse.moveTo(10, beta)
+    await ui.app.renderOnce()
+    expect(marker()).toContain(alpha)
+    expect(marker()).not.toContain(beta)
+    expect(ui.active()).toBe("alpha")
+  } finally {
+    ui.app.renderer.destroy()
+  }
+})
+
+test("long folder paths keep their leaf and the full path is inspectable on hover or click", async () => {
+  const directory = path.join(HOME, "clients", "very-long-organisation-name", "deeply", "nested", "final-leaf")
+  const ui = await mount({ width: 30, directory })
+  try {
+    await ui.app.waitForFrame((frame) => frame.includes(`final-leaf${path.sep}`))
+    const location = ui.row(`final-leaf${path.sep}`)
+    expect(location).toBeGreaterThanOrEqual(0)
+    expect(ui.rail()[location].trimEnd().endsWith(`final-leaf${path.sep}`)).toBe(true)
+    expect(ui.app.captureCharFrame()).not.toContain(directory)
+    await ui.app.mockMouse.moveTo(4, location)
+    await ui.app.waitForFrame((frame) => frame.includes(directory))
+    await ui.app.mockMouse.moveTo(60, 20)
+    await ui.app.waitForFrame((frame) => !frame.includes(directory))
+    await ui.app.mockMouse.click(4, location)
+    await ui.app.mockMouse.moveTo(60, 20)
+    await ui.app.waitForFrame((frame) => frame.includes(directory))
+    expect(ui.active()).toBe("alpha")
+  } finally {
+    ui.app.renderer.destroy()
+  }
+})
+
+test("global and project New session entries open the same setup with their own folders", async () => {
+  const setups: (string | undefined)[] = []
+  const ui = await mount({ width: 30, setup: (directory) => setups.push(directory) })
+  try {
+    await ui.app.waitForFrame((frame) => frame.includes("Alpha work"))
+    const global = ui.row("New session")
+    await ui.app.mockMouse.click(ui.rail()[global].indexOf("New session"), global)
+    expect(setups).toEqual([undefined])
+
+    const heading = ui.row(`▾ project${path.sep}`)
+    await ui.app.mockMouse.click(4, heading, MouseButton.RIGHT)
+    await ui.app.waitForFrame((frame) => frame.includes("New session here"))
+    const lines = ui.app.captureCharFrame().split("\n")
+    const item = lines.findIndex((line) => line.includes("New session here"))
+    await ui.app.mockMouse.click(lines[item].indexOf("New session here") + 1, item)
+    expect(setups).toEqual([undefined, PROJECT])
+    expect(ui.counts.add).toBe(0)
+    expect(ui.active()).toBe("alpha")
+  } finally {
+    ui.app.renderer.destroy()
+  }
+})
+
+test("fresh Home exposes folder actions while empty groups stay under management", async () => {
+  const ui = await mount({ width: 30, tabs: [], active: "" })
+  try {
+    await ui.app.waitForFrame((frame) => frame.includes("Browse") && frame.includes("No open sessions"))
+    expect(ui.row(`project${path.sep}`)).toBeGreaterThanOrEqual(0)
+    expect(ui.row("New session")).toBeGreaterThanOrEqual(0)
+    expect(ui.app.captureCharFrame()).not.toContain("Ideas")
+    const more = ui.row("More")
+    await ui.app.mockMouse.click(ui.rail()[more].indexOf("More"), more)
+    await ui.app.waitForFrame(frame => frame.includes("Show empty groups"))
+    const lines = ui.app.captureCharFrame().split("\n")
+    const entry = lines.findIndex(line => line.includes("Show empty groups"))
+    await ui.app.mockMouse.click(lines[entry].indexOf("Show empty groups"), entry)
+    await ui.app.waitForFrame(frame => frame.includes("# Ideas"))
+  } finally {
+    ui.app.renderer.destroy()
+  }
+})
+
+test("compact rail exposes search, Browse and model controls", async () => {
+  const ui = await mount({ width: SESSION_TABS_COMPACT_WIDTH })
+  try {
+    await ui.app.waitForFrame((frame) => frame.split("\n")[3]?.slice(0, SESSION_TABS_COMPACT_WIDTH).trim() === "◇")
+    expect(
+      ui
+        .rail()
+        .slice(1, 4)
+        .map((line) => line.trim()),
+    ).toEqual(["⌕", "▤", "◇"])
+    await ui.app.mockMouse.click(2, 3)
+    expect(ui.counts.model).toBe(1)
+    expect(ui.active()).toBe("alpha")
+  } finally {
+    ui.app.renderer.destroy()
+  }
+})
