+import { InputRenderable } from "@opentui/core"
+import { expect, test } from "bun:test"
+import { mkdir } from "node:fs/promises"
+import path from "node:path"
+import { takeDraft } from "../../src/component/prompt/draft-stash"
+import { createAppFixture } from "../fixture/app"
+import { tmpdir } from "../fixture/fixture"
+import { json } from "../fixture/tui-client"
+
+type Selection = { providerID: string; id: string; variant?: string }
+type Created = { id?: string; location?: { directory: string }; agent?: string; model?: Selection }
+type Entry = { id: string; name: string; variants: string[] }
+
+const launch = "/tmp/opencode/packages/tui"
+const alpha: Entry = { id: "alpha", name: "Alpha Model", variants: ["low", "high"] }
+const beta: Entry = { id: "beta", name: "Beta Model", variants: ["high"] }
+const gamma: Entry = { id: "gamma", name: "Gamma Model", variants: [] }
+
+function info(record: Created) {
+  return {
+    ...record,
+    location: record.location ?? { directory: launch },
+    projectID: "project",
+    cost: 0,
+    tokens: { input: 0, output: 0, reasoning: 0, cache: { read: 0, write: 0 } },
+    time: { created: 0, updated: 0 },
+  }
+}
+
+/**
+ * Real app with two primary agents (Ship listed first), a durable Quick session and a global variant preference that
+ * differs from the session's, so a lost agent or variant shows up as Ship or the preferred variant.
+ */
+async function start(
+  options: {
+    session?: Selection
+    catalog?: (directory: string) => Entry[]
+    agents?: (directory: string) => string[]
+  } = {},
+) {
+  // Fixtures reuse this tab identity; drafts persist across app remounts in the same process.
+  takeDraft("ses_existing")
+  takeDraft(undefined)
+  const scratch = await tmpdir()
+  const chosen = path.join(scratch.path, "empty project")
+  await mkdir(chosen)
+  const state = path.join(scratch.path, "state")
+  await mkdir(state)
+  const preferences = JSON.stringify({ recent: [], favorite: [], variant: { "demo/alpha": "high" } })
+  await Bun.write(path.join(state, "model.json"), preferences)
+  const original: Created & { title: string } = {
+    id: "ses_existing",
+    title: "Original session",
+    location: { directory: launch },
+    agent: "lite",
+    model: options.session ?? { providerID: "demo", id: "alpha", variant: "low" },
+  }
+  const created: Created[] = []
+  const prompts: { sessionID: string; body: unknown }[] = []
+  const mutations: string[] = []
+  const modelRequests: string[] = []
+  const removed = new Set<string>()
+  let modelGate: Promise<void> | undefined
+  const setup = await createAppFixture({
+    state,
+    config: {
+      animations: false,
+      keybinds: { "session.new": "f7", "model.list": "f8" },
+    },
+    args: { sessionID: "ses_existing" },
+    fetch: async (url, request) => {
+      if (request.method !== "GET" && url.pathname.includes("ses_existing")) mutations.push(url.pathname)
+      if (url.pathname === "/api/session" && request.method === "GET")
+        return json({ data: [info(original)], cursor: {} })
+      if (url.pathname === "/api/session/ses_existing") return json({ data: info(original) })
+      if (url.pathname === "/api/session/ses_existing/message")
+        return json({
+          data: [{ id: "msg_original", type: "user", text: "Original transcript line", time: { created: 1 } }],
+          cursor: {},
+        })
+      const location = { directory: url.searchParams.get("location[directory]") ?? launch }
+      if (url.pathname === "/api/agent")
+        return json({
+          location,
+          data: (options.agents?.(location.directory) ?? ["ship", "lite"]).map((id) => ({
+            id,
+            mode: "primary",
+            hidden: false,
+            permissions: [],
+          })),
+        })
+      if (url.pathname === "/api/provider") return json({ location, data: [{ id: "demo", name: "Demo" }] })
+      if (url.pathname === "/api/model") {
+        modelRequests.push(location.directory)
+        await modelGate
+        const entries = (options.catalog ?? (() => [alpha, beta, gamma]))(location.directory).filter(
+          (entry) => !removed.has(entry.id),
+        )
+        return json({
+          location,
+          data: entries.map((entry, index) => ({
+            id: entry.id,
+            providerID: "demo",
+            name: entry.name,
+            variants: entry.variants.map((id) => ({ id })),
+            time: { released: 10 - index },
+            cost: [],
+          })),
+        })
+      }
+      if (url.pathname === "/api/fs/list") {
+        const target = url.searchParams.get("path") ?? location.directory
+        return json({ location: { directory: target }, data: [] })
+      }
+      if (url.pathname === "/api/session" && request.method === "POST") {
+        const record: Created = await request.json()
+        created.push(record)
+        return json({ data: info(record) })
+      }
+      if (/^\/api\/session\/[^/]+\/prompt$/.test(url.pathname)) {
+        prompts.push({ sessionID: url.pathname.split("/")[3] ?? "", body: await request.json() })
+        return json({ data: {} })
+      }
+      if (/^\/api\/session\/[^/]+\/(message|inbox|permission)$/.test(url.pathname))
+        return json({ data: [], cursor: {} })
+      if (/^\/api\/session\/[^/]+\/(agent|model)$/.test(url.pathname)) return new Response(null, { status: 204 })
+      if (/^\/api\/session\/[^/]+$/.test(url.pathname)) {
+        const record = created.find((item) => item.id === url.pathname.split("/")[3])
+        if (!record) return json({ message: "not found" }, { status: 404 })
+        return json({ data: info(record) })
+      }
+      return undefined
+    },
+  })
+  const frame = () => setup.captureCharFrame()
+  return {
+    setup,
+    scratch,
+    chosen,
+    state,
+    preferences,
+    created,
+    prompts,
+    mutations,
+    modelRequests,
+    removed,
+    frame,
+    /** Holds every later catalog response until the returned release is called. */
+    holdCatalog() {
+      const held = Promise.withResolvers<void>()
+      modelGate = held.promise
+      return () => {
+        modelGate = undefined
+        held.resolve()
+      }
+    },
+    /** Announces a catalog change at `directory`, as the server does when a provider's models change. */
+    catalogChanged(directory: string) {
+      setup.events.emit({
+        id: `evt_${crypto.randomUUID()}`,
+        created: 0,
+        type: "model.updated",
+        data: {},
+        location: { directory },
+      } as never)
+    },
+  }
+}
+
+type Run = Awaited<ReturnType<typeof start>>
+
+async function until(fn: () => boolean, label: string, frame?: () => string, timeout = 5000) {
+  const begin = Date.now()
+  while (!fn()) {
+    if (Date.now() - begin > timeout) throw new Error(`timed out waiting for ${label}\n${frame?.() ?? ""}`)
+    await Bun.sleep(10)
+  }
+}
