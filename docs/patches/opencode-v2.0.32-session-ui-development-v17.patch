+import { expect, test } from "bun:test"
+import { createAppFixture } from "./fixture/app"
+import { json } from "./fixture/tui-client"
+
+const location = { directory: "/project", project: { id: "project", directory: "/project", canonical: "/project" } }
+
+for (const width of [60, 110]) {
+  test(`fresh home names Cloud and connection picker recommends it at ${width} columns`, async () => {
+    await using setup = await createAppFixture({
+      width, height: 36,
+      config: { animations: false, keybinds: { "provider.connect": "f6" } },
+      fetch: async (url) => {
+        if (url.pathname === "/api/location") return json(location)
+        if (url.pathname === "/api/model") return json({ location, data: [] })
+        if (url.pathname === "/api/integration") return json({ location, data: [
+          { id: "openai", name: "Codex / OpenAI", connections: [], methods: [{ type: "key" }] },
+          { id: "carthagent-cloud", name: "Carthagent Cloud", connections: [], methods: [{ type: "oauth", id: "carthagent-device", label: "Continue with Carthagent Cloud" }] },
+        ] })
+        return undefined
+      },
+    })
+    await setup.ready
+    await setup.waitForFrame((frame) => frame.includes("Continue with Carthagent Cloud"))
+    expect(setup.captureCharFrame()).toContain("/login")
+    setup.mockInput.pressKey("F6")
+    await setup.waitForFrame((frame) => frame.includes("Recommended") && frame.includes("Codex / OpenAI"))
+    const frame = setup.captureCharFrame()
+    expect(frame.indexOf("Recommended")).toBeLessThan(frame.indexOf("Popular"))
+    expect(frame.indexOf("Carthagent Cloud")).toBeLessThan(frame.indexOf("Codex / OpenAI"))
+  })
+}
