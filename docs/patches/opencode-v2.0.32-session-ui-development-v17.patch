+test("owned navigation registrations validate, replace safely, and cannot select another owner's pane", () => {
+  const persisted: unknown[] = []
+  let reveals = 0
+  const state = createNavigationState({ persist: (value) => persisted.push(value), reveal: () => { reveals++ } })
+  const pane = { name: "voyages", title: "Voyages", render: () => null }
+  for (const name of ["projects", "Projects", "", "a b"]) expect(() => state.register("one", { ...pane, name })).toThrow()
+  for (const title of ["", "  ", "bad\nlabel"]) expect(() => state.register("one", { ...pane, title })).toThrow()
+  const old = state.register("one", pane)
+  expect(state.select("two", "voyages")).toBe(false)
+  expect(reveals).toBe(0)
+  expect(state.select("one", "voyages")).toBe(true)
+  const replacement = state.register("one", pane)
+  old()
+  expect(state.current()?.owner).toBe("one")
+  expect(state.panes()).toHaveLength(1)
+  replacement()
+  replacement()
+  expect(state.current()).toBeUndefined()
+  expect(state.panes()).toHaveLength(0)
+  expect(persisted.at(-1)).toBeUndefined()
+})
