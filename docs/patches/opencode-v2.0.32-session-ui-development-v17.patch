+  | { id: string; kind: "directory"; directory: string; collapsed?: boolean }
+
+export const DIRECTORY_FOLDER_PREFIX = "dir:"
+export const directoryFolderID = (directory: string) => `${DIRECTORY_FOLDER_PREFIX}${directory}`
+
+export function openSessionFolder(folders: SessionFolder[], folder: SessionFolder): SessionFolder[] {
+  return folders.some((item) => item.id === folder.id) ? folders : [...folders, folder]
+}
+
+export function setSessionFolderCollapsed(folders: SessionFolder[], folderID: string, collapsed: boolean) {
+  return folders.map((folder) => (folder.id === folderID ? { ...folder, collapsed } : folder))
