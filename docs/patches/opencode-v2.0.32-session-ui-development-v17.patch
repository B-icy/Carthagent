+type Item = { path: string; type: "file" | "directory" }
+type File = Parameters<typeof createFolderBrowser>[0]["file"]
+
+const anchor = { directory: path.resolve("/anchor") }
+const home = path.resolve("/home/user")
+
+function listing(directory: string, data: Item[]) {
+  return { location: { directory, project: { id: "proj_test", directory, canonical: directory } }, data }
+}
+
+// Tree of absolute directory -> children; listings are returned relative to the anchor location like the server does.
+function tree(directories: Record<string, Item[]>) {
+  const native = Object.fromEntries(Object.entries(directories).map(([key, items]) => [path.resolve(key), items]))
+  const calls: { location: unknown; path: unknown }[] = []
+  const file = {
+    list: async (input) => {
+      calls.push({ location: input?.location, path: input?.path })
+      const target = String(input?.path)
+      const children = native[target]
+      if (!children) throw Object.assign(new Error(`Directory not found: ${target}`), { _tag: "FileNotFoundError" })
+      return listing(
+        anchor.directory,
+        children.map((item) => ({
+          ...item,
+          path: path.relative(anchor.directory, path.join(target, item.path)) + (item.type === "directory" ? "/" : ""),
+        })),
+      )
+    },
+  } as File
+  return { file, calls }
+}
+
+function deferred() {
+  const pending = [] as {
+    path: string
+    signal?: AbortSignal
+    resolve: (value: unknown) => void
+    reject: (error: unknown) => void
+  }[]
+  const file = {
+    list: (input, options) =>
+      new Promise((resolve, reject) =>
+        pending.push({
+          path: String(input?.path),
+          signal: options?.signal,
+          resolve: resolve as (value: unknown) => void,
+          reject,
+        }),
+      ),
+  } as File
+  return { file, pending }
+}
+
+function setup(file: File) {
+  return createRoot((dispose) => ({ browser: createFolderBrowser({ file, location: () => anchor, home }), dispose }))
+}
+
+const dir = (name: string): Item => ({ path: name, type: "directory" })
+
+// Folders "/a", "/b", "/c", "/x" each contain one child; targets in `failing` reject like a transport failure.
+function traversal(failing: Set<string>) {
+  const calls: string[] = []
+  const file = {
+    list: async (input) => {
+      const target = String(input?.path)
+      calls.push(target)
+      if ([...failing].some((value) => path.resolve(value) === target)) throw new Error(`boom ${target}`)
+      return listing(target, [dir(`${path.basename(target)}-child/`)])
+    },
+  } as File
+  return { file, calls }
+}
