+++ b/packages/tui/src/util/combining-input.ts
@@ -0,0 +1,30 @@
+import { TextareaRenderable, type KeyEvent } from "@opentui/core"
+
+const MARKS = /^\p{M}+$/u
+const graphemes = new Intl.Segmenter(undefined, { granularity: "grapheme" })
+let installed = false
+
+// The native edit buffer (OpenTUI 0.5.17) stores a combining mark inserted on its own but leaves the
+// cursor before it, so the next typed character lands between the base and its mark. Pasted text is
+// unaffected because base and mark arrive in one insert, so typed marks are re-inserted the same way.
+export function installCombiningMarkInput() {
+  if (installed) return
+  installed = true
+  const handleKeyPress = TextareaRenderable.prototype.handleKeyPress
+  TextareaRenderable.prototype.handleKeyPress = function (key: KeyEvent) {
+    if (key.ctrl || key.meta || key.super || key.hyper || !MARKS.test(key.sequence)) return handleKeyPress.call(this, key)
+    return insertCombiningMark(this, key.sequence) || handleKeyPress.call(this, key)
+  }
+}
+
+export function insertCombiningMark(editor: TextareaRenderable, mark: string) {
+  if (editor.hasSelection()) return false
+  const offset = editor.cursorOffset
+  const before = editor.getTextRange(editor.editBuffer.getLineStartOffset(editor.logicalCursor.row), offset)
+  const previous = Array.from(graphemes.segment(before)).at(-1)?.segment
+  if (!previous || previous === "\t") return false
+  if (editor.extmarks.getVirtual().some((extmark) => extmark.start < offset && offset <= extmark.end)) return false
+  editor.deleteCharBackward()
+  editor.insertText(previous + mark)
+  return true
+}
