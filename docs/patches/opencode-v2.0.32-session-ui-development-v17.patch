+    state: state ?? root.path, width: 120, height: 24,
+    args: session ? { sessionID: sessions[0]!.id } : {},
+    config: { animations: false, plugins: [plugin], keybinds, tabs: { enabled: true, layout: "vertical" }, session: { sidebar: "hide" } },
+    fetch(url, request) {
+      if (request.method !== "GET" && !url.pathname.endsWith("/environment") && !url.pathname.endsWith("/model")) mutations.push(url.pathname)
+      if (url.pathname === "/api/agent") return json({ location, data: [{ id: "build", mode: "primary", hidden: false, permissions: [] }] })
+      if (url.pathname === "/api/model") return json({ location, data: [{ id: "model", providerID: "fixture", name: "Model", variants: [] }] })
+      if (url.pathname === "/api/provider") return json({ location, data: [{ id: "fixture", name: "Fixture" }] })
+      if (url.pathname === "/api/session") return json({ data: session ? sessions : [], cursor: {} })
+      const current = sessions.find((s) => url.pathname === `/api/session/${s.id}`)
+      if (current) return json({ data: current })
+      if (/\/message$/.test(url.pathname)) return json({ data: [], cursor: {} })
+      if (/\/inbox$/.test(url.pathname)) return json({ data: [] })
+      return undefined
+    },
+  })
+  return { ...setup, mutations, state: state ?? root.path, async [Symbol.asyncDispose]() { await setup[Symbol.asyncDispose](); await root[Symbol.asyncDispose]() } }
+}
+
+type Fixture = Awaited<ReturnType<typeof fixture>>
+async function waitForFolder(setup: Fixture, expanded: boolean) {
+  const deadline = Date.now() + 5_000
+  while (!!setup.renderer.root.findDescendantById("project-row-ses_navigation_0") !== expanded) {
+    if (Date.now() >= deadline) throw new Error(`Folder did not ${expanded ? "expand" : "collapse"}:\n${setup.captureCharFrame()}`)
+    await Bun.sleep(10)
+  }
+}
+async function ready(setup: Fixture) {
+  await setup.ready
+  // Plugin loading is asynchronous I/O, not frame-driven work.
+  const deadline = Date.now() + 10_000
+  while (!setup.captureCharFrame().includes("Projects") || !setup.captureCharFrame().includes("Voyages")) {
+    if (Date.now() >= deadline) throw new Error(`Navigation plugin failed to load:\n${setup.captureCharFrame()}\n${JSON.stringify(setup.logs)}`)
+    await Bun.sleep(10)
+  }
+  await setup.waitFor(() => setup.renderer.currentFocusedEditor instanceof TextareaRenderable)
+}
+function node(setup: Fixture, id: string) {
+  const item = setup.renderer.root.findDescendantById(id)
+  if (!item) throw new Error(`Missing ${id}`)
+  return item
+}
+function descendants(node: Renderable): Renderable[] { return node.getChildren().flatMap((child) => [child, ...descendants(child)]) }
