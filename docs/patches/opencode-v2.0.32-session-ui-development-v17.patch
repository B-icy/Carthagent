+  setup.mockInput.pressKey("p", { ctrl: true })
+  await until(() => run.frame().includes("Choose folder for new session"), "folder picker", run.frame)
+  await until(() => setup.renderer.currentFocusedRenderable instanceof InputRenderable, "filter focus")
+  setup.mockInput.pressTab()
+  const input = setup.renderer.currentFocusedRenderable as InputRenderable
+  input.value = run.chosen
+  setup.mockInput.pressEnter()
+  await until(
+    () =>
+      run.frame().includes("No subfolders here") &&
+      run
+        .frame()
+        .split("\n")
+        .some((line) => line.includes("empty project")),
+    "chosen listing",
+    run.frame,
+  )
+  setup.mockInput.pressKey("s", { ctrl: true })
+  await until(
+    () => run.frame().includes("Ready.") && run.frame().includes(`${path.sep}empty project`),
+    "chosen",
+    run.frame,
+  )
+}
+
+async function chooseSetupModel(run: Run, name: string, id: string) {
+  run.setup.mockInput.pressKey("o", { ctrl: true })
+  await until(() => run.setup.renderer.currentFocusedRenderable instanceof InputRenderable && run.setup.renderer.currentFocusedRenderable.id !== "new-session-path", "model focus")
+  await run.setup.mockInput.typeText(name)
+  await until(() => run.frame().includes(`${name} Model`), `${name} option`, run.frame)
+  run.setup.mockInput.pressEnter()
+  await until(() => run.frame().includes("Ready.") && run.frame().includes(`demo/${id}`), `${name} chosen`, run.frame)
+}
+
+async function confirm(run: Run) {
+  run.setup.mockInput.pressEnter()
+  await until(
+    () => !run.frame().includes("Ready.") && !run.frame().includes("Original transcript line"),
+    "home",
+    run.frame,
+  )
