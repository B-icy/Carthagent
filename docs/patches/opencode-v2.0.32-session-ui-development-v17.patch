diff --git a/packages/tui/test/fixture/plugin/navigation/tui.tsx b/packages/tui/test/fixture/plugin/navigation/tui.tsx
new file mode 100644
index 0000000000..dacde3adb6
--- /dev/null
+++ b/packages/tui/test/fixture/plugin/navigation/tui.tsx
@@ -0,0 +1,67 @@
+import { Plugin, usePlugin } from "@opencode/plugin/tui"
+import type { NavigationInput } from "@opencode/plugin/tui/context"
+import { createSignal } from "solid-js"
+import type { InputRenderable } from "@opentui/core"
+
+export default Plugin.define({
+  id: "fixture.navigation",
+  setup(context) {
+    const render = (input: NavigationInput) => <Pane {...input} />
+    let unregister = context.ui.navigation.register({ name: "voyages", title: "Voyages", render })
+    context.ui.router.register({ name: "detail", render: () => <Detail /> })
+    context.ui.router.register({ name: "select-detail", render: () => <SelectDetail /> })
+    context.keymap.layer(() => ({
+      mode: "global",
+      commands: [
+        { bind: "f6", run: () => { context.ui.navigation.select("voyages") } },
+        { bind: "f7", run: () => context.ui.router.navigate({ type: "plugin", name: "detail", data: { sessionID: "ses_navigation_0" } }) },
+        { bind: "f5", run: () => { context.ui.navigation.select("projects") } },
+        { bind: "f8", run: () => { void context.ui.dialog.prompt({ title: "Navigation dialog guard", value: "Unsaved fixture" }) } },
+        { bind: "f9", run: () => unregister() },
+        { bind: "f10", run: () => { unregister = context.ui.navigation.register({ name: "voyages", title: "Voyages", render }) } },
+        { bind: "f11", run: () => { unregister(); unregister = context.ui.navigation.register({ name: "voyages", title: "Voyages", render: () => { throw new Error("navigation fixture crash") } }) } },
+      ],
+    }))
+  },
+})
+
+function Pane(input: NavigationInput) {
+  const context = usePlugin()
+  const [selected, setSelected] = createSignal(0)
+  const options = Array.from({ length: 8 }, (_, value) => ({ name: `Action ${value}`, description: "Read-only detail", value }))
+  return <box id="fixture-voyages" height="100%">
+    <text id="fixture-voyage-selection" height={1} flexShrink={0}>Voyage selection {selected()}</text>
+    <text id="fixture-voyage-scope" height={1} flexShrink={0} wrapMode="none">{`${input.width}:${input.compact}:${input.active}:${input.focused}:${input.sessionID ?? "home"}:${context.ui.navigation.current()}`}</text>
+    <text id="fixture-voyage-focus" height={1} flexShrink={0} onMouseUp={input.focus}>Focus voyages</text>
+    <select id="fixture-voyage-actions" height={2} flexShrink={0} options={options} selectedIndex={selected()} focused={input.active && input.focused} onChange={(index) => setSelected(index)} onSelect={(index) => {
+      if (!input.active || !input.focused || context.keymap.mode.current() !== "navigation") return
+      if (index !== 7) return context.ui.router.navigate({ type: "plugin", name: "detail" })
+      input.blur()
+      context.ui.router.navigate({ type: "plugin", name: "select-detail", data: { sessionID: "ses_navigation_0" } })
+    }} />
+    <scrollbox id="fixture-voyage-scroll" flexGrow={1} minHeight={0}>
+      {Array.from({ length: 60 }, (_, index) => <text height={1} flexShrink={0}>Voyage row {index}</text>)}
+    </scrollbox>
+  </box>
+}
+
+function Detail() {
+  const context = usePlugin()
+  const [arrows, setArrows] = createSignal(0)
+  context.keymap.layer(() => ({ commands: [{ bind: "down", run: () => { setArrows((value) => value + 1) } }] }))
+  let editor: InputRenderable
+  return <box>
+    <text id="fixture-detail">Voyage detail page arrows {arrows()}</text>
+    <input id="fixture-page-input" ref={(value) => { editor = value }} onMouseDown={() => editor.focus()} />
+  </box>
+}
+
+function SelectDetail() {
+  const context = usePlugin()
+  const [selected, setSelected] = createSignal(0)
+  const options = Array.from({ length: 4 }, (_, value) => ({ name: `Detail ${value}`, description: "", value }))
+  return <box>
+    <text id="fixture-select-detail">Select detail {selected()}</text>
+    <select id="fixture-select-detail-actions" height={4} options={options} focused={context.keymap.mode.current() === "base"} onChange={(index) => setSelected(index)} />
+  </box>
+}
