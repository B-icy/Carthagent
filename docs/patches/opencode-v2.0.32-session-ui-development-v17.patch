+    model: { providerID: "demo", id: "beta" },
+  })
+  expect(JSON.stringify(run.prompts[0]?.body)).toContain("unsent draft ü")
+
+  // A sent draft is no longer parked: cycling only visits the two real tabs.
+  setup.mockInput.pressArrow("down", { meta: true })
+  await until(() => onSession(frame()), "original session", frame)
+  expect(frame()).not.toContain("· unsent")
+  setup.mockInput.pressArrow("down", { meta: true })
+  await until(() => !onSession(frame()), "new session tab", frame)
+  setup.mockInput.pressArrow("down", { meta: true })
+  await until(() => onSession(frame()), "wrapped to the original session", frame)
+  expect(frame()).not.toContain("· unsent")
+  expect(run.created).toHaveLength(1)
+})
+
+test("closing the last real tab reopens the parked draft in its own folder with its model", async () => {
+  const run = await start()
+  await using _scratch = run.scratch
+  await using setup = run.setup
+  const frame = run.frame
+
+  setup.mockInput.pressArrow("down", { meta: true })
+  await until(() => onSession(frame()) && frame().includes("New session · unsent"), "parked", frame)
+  setup.mockInput.pressKey("x", { ctrl: true })
+  setup.mockInput.pressKey("w")
+  await until(() => !onSession(frame()), "session tab closed", frame)
+  await until(() => onDraft(frame(), "draft project"), "draft restored in its folder", frame)
+  expect(run.created).toEqual([])
