--- /dev/null
+++ b/packages/tui/test/mouse-workflow-routes.test.tsx
@@ -0,0 +1,177 @@
+import { expect, test } from "bun:test"
+import { InputRenderable, MouseButton, TextareaRenderable } from "@opentui/core"
+import { createAppFixture } from "./fixture/app"
+import { json } from "./fixture/tui-client"
+import { takeDraft } from "../src/component/prompt/draft-stash"
+
+const location = {
+  directory: "/tmp/opencode/packages/tui",
+  project: { id: "project", directory: "/tmp/opencode", canonical: "/tmp/opencode" },
+}
+
+async function launch(options: { width?: number; tabs?: boolean } = {}) {
+  const prompts: string[] = []
+  const sessions: { id: string }[] = []
+  const setup = await createAppFixture({
+    width: options.width ?? 120,
+    height: 30,
+    config: {
+      animations: false,
+      ...(options.tabs ? { tabs: { enabled: true, layout: "vertical" as const }, session: { sidebar: "hide" as const } } : {}),
+    },
+    fetch: async (url, request) => {
+      if (url.pathname === "/api/agent")
+        return json({ location, data: [{ id: "build", mode: "primary", hidden: false, permissions: [] }] })
+      if (url.pathname === "/api/provider") return json({ location, data: [{ id: "demo", name: "Demo" }] })
+      if (url.pathname === "/api/model")
+        return json({ location, data: [{ id: "model", providerID: "demo", name: "Demo Model", variants: [], cost: [], time: { released: 0 } }] })
+      if (url.pathname === "/api/session" && request.method === "POST") {
+        const record = await request.json()
+        sessions.push(record)
+        return json({ data: info(record) })
+      }
+      if (url.pathname === "/api/session") return json({ data: sessions.map(info), cursor: {} })
+      if (/^\/api\/session\/[^/]+\/prompt$/.test(url.pathname)) {
+        prompts.push(url.pathname.split("/")[3] ?? "")
+        return json({ data: {} })
+      }
+      if (/^\/api\/session\/[^/]+\/(message|inbox|permission)$/.test(url.pathname)) return json({ data: [], cursor: {} })
+      if (/^\/api\/session\/[^/]+\/(agent|model)$/.test(url.pathname)) return new Response(null, { status: 204 })
+      if (/^\/api\/session\/[^/]+$/.test(url.pathname)) {
+        const record = sessions.find((item) => item.id === url.pathname.split("/")[3])
+        if (!record) return json({ message: "not found" }, { status: 404 })
+        return json({ data: info(record) })
+      }
+      return undefined
+    },
+  })
+  return { setup, prompts }
+}
+
+function info(record: { id: string; location?: { directory: string } }) {
+  return {
+    ...record,
+    title: "Session",
+    location: record.location ?? { directory: location.directory },
+    projectID: "project",
+    cost: 0,
+    tokens: { input: 0, output: 0, reasoning: 0, cache: { read: 0, write: 0 } },
+    time: { created: 0, updated: 0 },
+  }
+}
+
+type Setup = Awaited<ReturnType<typeof launch>>["setup"]
+
+function find(setup: Setup, id: string) {
+  return setup.renderer.root.findDescendantById(id)
+}
+
+async function click(setup: Setup, id: string) {
+  const node = find(setup, id)
+  if (!node) throw new Error(`Missing ${id}:\n${setup.captureCharFrame()}`)
+  await setup.mockMouse.click(node.x, node.y)
+}
+
+// Rail layout changes settle over several frames on a busy runner, so poll state on a wall-clock deadline.
+async function until(setup: Setup, predicate: () => boolean, label = "") {
+  const deadline = Date.now() + 5_000
+  while (!predicate()) {
+    if (Date.now() >= deadline) throw new Error(`Condition not met ${label}:\n${setup.captureCharFrame()}`)
+    await Bun.sleep(10)
+  }
+}
+
+async function ready(setup: Setup) {
+  takeDraft(undefined)
+  await setup.ready
+  await setup.waitForFrame((frame) => frame.includes("Demo Model"))
+  await setup.waitFor(() => setup.renderer.currentFocusedEditor instanceof TextareaRenderable)
+}
+
+test("Send appears only with a draft and submits once through the guarded prompt path", async () => {
+  const run = await launch()
+  await using setup = run.setup
+  await ready(setup)
+  expect(find(setup, "prompt-send")).toBeUndefined()
+
+  await setup.mockInput.typeText("hello")
+  await setup.waitForFrame((frame) => frame.includes("hello") && frame.includes("Send"))
+  const send = find(setup, "prompt-send")!
+  // Press and release on the control; a second release without a new press must not resubmit.
+  await setup.mockMouse.pressDown(send.x, send.y)
+  await setup.mockMouse.release(send.x, send.y)
+  await setup.mockMouse.release(send.x, send.y)
+  await setup.waitFor(() => run.prompts.length === 1)
+  await setup.waitFor(() => !find(setup, "prompt-send"))
+  await Bun.sleep(50)
+  expect(run.prompts).toHaveLength(1)
+})
+
+test("a release on Send without a press there does nothing", async () => {
+  const run = await launch()
+  await using setup = run.setup
+  await ready(setup)
+  await setup.mockInput.typeText("draft")
+  await setup.waitFor(() => !!find(setup, "prompt-send"))
+  const send = find(setup, "prompt-send")!
+  await setup.mockMouse.pressDown(2, 2)
+  await setup.mockMouse.release(send.x, send.y)
+  await Bun.sleep(50)
+  expect(run.prompts).toEqual([])
+  expect(setup.captureCharFrame()).toContain("draft")
+})
+
+test("the composer model badge opens the model picker", async () => {
+  const run = await launch()
+  await using setup = run.setup
+  await ready(setup)
+  await click(setup, "prompt-model-badge")
+  await setup.waitForFrame(
+    (frame) => frame.includes("Select model") && setup.renderer.currentFocusedRenderable instanceof InputRenderable,
+  )
+})
+
+test("the footer commands hint opens the palette, which reaches Settings and Help", async () => {
+  const run = await launch()
+  await using setup = run.setup
+  await ready(setup)
+  await setup.waitFor(() => !!find(setup, "prompt-footer-commands"))
+  await click(setup, "prompt-footer-commands")
