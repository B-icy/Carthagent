+  const lines = frame().split("\n")
+  // The rail's draft row, not the folder card's "+ New session" action above the Sessions header.
+  const header = lines.findIndex((line) => line.includes("Sessions"))
+  const row = lines.findIndex((line, index) => index > header && line.includes("New session"))
