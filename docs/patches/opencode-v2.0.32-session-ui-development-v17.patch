+// The Carthagent launcher owns this profile's lifecycle. Rediscover its endpoint
+// after replacement without starting an upstream service or retaining old auth.
+function carthagentService(file: string, initial: Endpoint): Effect.Effect<{
+  reconnect: () => Effect.Effect<Endpoint, Error>
+  restart?: undefined
+}, Error> {
+  return Effect.tryPromise({
+    try: async () => {
+      const read = async () => {
+        const info = JSON.parse(await fs.readFile(file, "utf8"))
+        const url = new URL(info.url)
+        if (url.protocol !== "http:" || url.hostname !== "127.0.0.1" || url.username || url.password
+          || typeof info.password !== "string" || !info.password || !Number.isSafeInteger(info.pid)
+          || info.version !== OPENCODE_VERSION || info.runtimeIdentity?.kind !== "ctg-owned")
+          throw new Error("Carthagent service registration is incompatible")
+        return info
+      }
+      const original = await read()
+      if (new URL(original.url).href !== new URL(initial.url).href
+        || initial.auth?.type !== "basic" || original.password !== initial.auth.password)
+        throw new Error("Carthagent service registration changed during attachment")
+      const identity = JSON.stringify(original.runtimeIdentity)
+      return {
+        reconnect: () => Effect.tryPromise({
+          try: async (signal) => {
+            const info = await read()
+            if (JSON.stringify(info.runtimeIdentity) !== identity)
+              throw new Error("Carthagent runtime changed; relaunch this terminal")
+            const endpoint: Endpoint = { url: info.url, auth: { type: "basic", username: "opencode", password: info.password } }
+            const client = OpenCode.make({ baseUrl: endpoint.url, headers: Service.headers(endpoint) })
+            const health = await client.server.info({ signal: AbortSignal.any([signal, AbortSignal.timeout(5_000)]) })
+            if (health.version !== OPENCODE_VERSION || health.pid !== info.pid)
+              throw new Error("Carthagent replacement service identity did not validate")
+            return endpoint
+          },
+          catch: () => new Error("Carthagent workspace service is unavailable; waiting for its launcher"),
+        }),
+      }
+    },
+    catch: () => new Error("Could not bind the Carthagent workspace service registration"),
+  })
+}
