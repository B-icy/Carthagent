diff --git a/packages/cli/test/carthagent-reconnect.test.ts b/packages/cli/test/carthagent-reconnect.test.ts
new file mode 100644
index 0000000000..7c2b9da160
--- /dev/null
+++ b/packages/cli/test/carthagent-reconnect.test.ts
@@ -0,0 +1,53 @@
+import { expect, test } from "bun:test"
+import { Effect } from "effect"
+import fs from "node:fs/promises"
+import os from "node:os"
+import path from "node:path"
+import { OPENCODE_VERSION } from "../src/version"
+import { ServerConnection } from "../src/services/server-connection"
+
+test("an explicitly attached Carthagent terminal discovers its replacement authenticated service", async () => {
+  const root = await fs.mkdtemp(path.join(os.tmpdir(), "ctg-reconnect-"))
+  const file = path.join(root, "service.json")
+  const previousFile = process.env.CTG_TUI_SERVICE_FILE
+  const previousPassword = process.env.OPENCODE_PASSWORD
+  const service = (password: string) => Bun.serve({ hostname: "127.0.0.1", port: 0, fetch(request) {
+    if (request.headers.get("authorization") !== `Basic ${Buffer.from(`opencode:${password}`).toString("base64")}`)
+      return new Response(null, { status: 401 })
+    return Response.json({ version: OPENCODE_VERSION, pid: process.pid, urls: [] })
+  } })
+  const before = service("before")
+  const after = service("after")
+  const identity = { kind: "ctg-owned", binaryPath: "/fixture/runtime", binarySha256: "a".repeat(64) }
+  const register = (url: string, password: string, runtimeIdentity = identity) => fs.writeFile(file,
+    JSON.stringify({ url, password, pid: process.pid, version: OPENCODE_VERSION, runtimeIdentity }))
+  try {
+    process.env.CTG_TUI_SERVICE_FILE = file
+    process.env.OPENCODE_PASSWORD = "before"
+    await register(before.url.toString(), "before")
+    const resolved = await Effect.runPromise(ServerConnection.resolve({ server: before.url.toString() }) as Effect.Effect<ServerConnection.Resolved>)
+    expect(resolved.service).toBeDefined()
+    if (!resolved.service) throw new Error("Missing profile reconnect capability")
+    expect(resolved.service.restart).toBeUndefined()
+    if (resolved.service.restart) throw new Error("Profile rediscovery must not own lifecycle")
+    await before.stop(true)
+    await register(after.url.toString(), "after")
+    const next = await Effect.runPromise(resolved.service.reconnect())
+    expect(next.url).toBe(after.url.toString())
+    expect(next.auth).toEqual({ type: "basic", username: "opencode", password: "after" })
+    await register(after.url.toString(), "wrong")
+    await expect(Effect.runPromise(resolved.service.reconnect())).rejects.toThrow()
+    await register(after.url.toString(), "after", { ...identity, binarySha256: "b".repeat(64) })
+    await expect(Effect.runPromise(resolved.service.reconnect())).rejects.toThrow()
+    await fs.rm(file)
+    await expect(Effect.runPromise(resolved.service.reconnect())).rejects.toThrow()
+  } finally {
+    if (previousFile === undefined) delete process.env.CTG_TUI_SERVICE_FILE
+    else process.env.CTG_TUI_SERVICE_FILE = previousFile
+    if (previousPassword === undefined) delete process.env.OPENCODE_PASSWORD
+    else process.env.OPENCODE_PASSWORD = previousPassword
+    await before.stop(true)
+    await after.stop(true)
+    await fs.rm(root, { recursive: true, force: true })
+  }
+})
