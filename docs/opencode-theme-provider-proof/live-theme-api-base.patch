--- /dev/null
+++ b/packages/tui/test/plugin-theme.test.tsx
@@ -0,0 +1,54 @@
+import { expect, test } from "bun:test"
+import { createPluginContext, type Registry, type usePluginHost } from "../src/plugin/api"
+
+function setup() {
+  let selected = "opencode"
+  let mode: "dark" | "light" = "dark"
+  const available = new Set(["opencode", "custom"])
+  const host = {
+    app: {},
+    client: {},
+    keymap: {},
+    shortcuts: {},
+    keymapState: {},
+    sessionTabs: {},
+    themes: {
+      get selected() {
+        return selected
+      },
+      mode: () => mode,
+      has: (name: string) => available.has(name),
+      supportsThemeMode: (name: string, requested: "dark" | "light") => requested === "dark" || name === "custom",
+      set(name: string) {
+        if (!available.has(name)) return false
+        selected = name
+        return true
+      },
+      setMode(requested: "dark" | "light") {
+        mode = requested
+        return true
+      },
+    },
+  } as unknown as ReturnType<typeof usePluginHost>
+  const registry: Registry = { has: () => false, set() {}, remove() {}, active: () => true }
+  const theme = createPluginContext({ host, id: "test", options: undefined, owned: [], registry }).ui.theme
+  return { theme, current: () => ({ selected, mode }) }
+}
+
+test("plugin theme setter applies available theme and mode live through the host service", () => {
+  const harness = setup()
+  expect(harness.theme.current()).toEqual({ name: "opencode", mode: "dark" })
+  expect(harness.theme.set({ name: "custom", mode: "light" })).toBe(true)
+  expect(harness.theme.current()).toEqual({ name: "custom", mode: "light" })
+  expect(harness.current()).toEqual({ selected: "custom", mode: "light" })
+})
+
+test("plugin theme setter rejects unknown themes and unsupported modes without partial changes", () => {
+  const harness = setup()
+  expect(harness.theme.set({ name: "missing", mode: "dark" })).toBe(false)
+  expect(harness.theme.set({ name: "custom", mode: "light" })).toBe(true)
+  expect(harness.theme.set({ name: "opencode", mode: "light" })).toBe(false)
+  expect(harness.theme.current()).toEqual({ name: "custom", mode: "light" })
+  expect(harness.theme.set({ name: "opencode" })).toBe(true)
+  expect(harness.theme.current()).toEqual({ name: "opencode", mode: "light" })
+})
