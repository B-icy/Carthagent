{
  "name": "carthagent",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "description": "Evidence-driven software delivery, from plan to proof",
  "keywords": [
    "carthagent",
    "ai-agent",
    "software-delivery",
    "evidence-driven-delivery"
  ],
  "bin": {
    "ctg": "./bin/ctg.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/B-icy/Carthagent"
  },
  "homepage": "https://github.com/B-icy/Carthagent#readme",
  "bugs": "https://github.com/B-icy/Carthagent/issues",
  "files": [
    "bin",
    "docs",
    "extensions",
    "guidance",
    "lib",
    "prompts",
    "public",
    "scenarios/**/*.json",
    "scenarios/**/*.md",
    "scenarios/**/*.py",
    "scenarios/**/*.txt",
    "skills",
    "tests/*.mjs",
    "tests/*.py",
    "tools",
    "vendor",
    "evaluate.mjs",
    "metadata.json",
    "server.mjs"
  ],
  "scripts": {
    "dev": "node server.mjs",
    "start": "node server.mjs",
    "ctg": "node bin/ctg.mjs",
    "check": "node tools/check-syntax.mjs",
    "typecheck": "tsc --noEmit --skipLibCheck --target ES2023 --module NodeNext --moduleResolution NodeNext --types node extensions/delivery.ts extensions/experiential.ts types/pi-coding-agent.d.ts",
    "lint": "eslint . && npm run typecheck",
    "quality": "npm run lint && npm run build && npm test",
    "test:browser": "node tools/test-webdriver.mjs",
    "build": "npm run check && npm run typecheck",
    "test": "node --test tests/*.test.mjs",
    "test:python": "node tools/test-python.mjs"
  },
  "dependencies": {
    "express": "^5.2.1",
    "jsdom": "^30.0.1",
    "jiti": "^2.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.3.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "typescript": "^5.9.2"
  }
}
