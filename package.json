{
  "name": "carthagent",
  "version": "1.0.3",
  "private": true,
  "workspaces": [
    "plugins/carthagent"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "description": "Evidence-driven software delivery, from plan to proof",
  "keywords": [
    "carthagent",
    "ai-agent",
    "software-delivery",
    "evidence-driven-delivery"
  ],
  "bin": {
    "ctg": "./bin/ctg.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/B-icy/Carthagent"
  },
  "homepage": "https://github.com/B-icy/Carthagent#readme",
  "bugs": "https://github.com/B-icy/Carthagent/issues",
  "files": [
    "bin",
    "docs",
    "script/ctg/build-owned-runtime.sh",
    "extensions",
    "guidance",
    "lib",
    "plugins",
    "!plugins/**/node_modules/**",
    "themes",
    "prompts",
    "public",
    "scenarios/**/*.json",
    "scenarios/**/*.md",
    "scenarios/**/*.py",
    "scenarios/**/*.txt",
    "skills",
    "tests/*.mjs",
    "tests/*.py",
    "tests/fixtures/archive-plugin",
    "tests/fixtures/native-discovery-plugin/server.ts",
    "tools",
    "vendor",
    "evaluate.mjs",
    "metadata.json",
    "server.mjs"
  ],
  "scripts": {
    "dev": "node server.mjs",
    "start": "node server.mjs",
    "ctg": "node bin/ctg.mjs",
    "check": "node tools/check-syntax.mjs",
    "typecheck": "npm run typecheck:legacy && npm run typecheck:native",
    "typecheck:legacy": "tsc --noEmit --skipLibCheck --target ES2023 --module NodeNext --moduleResolution NodeNext --types node extensions/delivery.ts extensions/experiential.ts extensions/subscriptions.ts extensions/codegraph.ts types/pi-coding-agent.d.ts",
    "typecheck:native": "tsc -p plugins/carthagent/tsconfig.json",
    "lint": "eslint . && npm run typecheck",
    "quality": "npm run lint && npm run build && npm test",
    "test:browser": "node tools/test-webdriver.mjs",
    "test:native-host": "node tools/test-native-host.mjs",
    "test:native-product": "node tools/test-native-product.mjs",
    "test:native-tasks": "node tools/test-native-tasks.mjs",
    "test:native-review": "node tools/test-native-review.mjs",
    "test:native-report": "node tools/test-native-report.mjs",
    "test:native-runtime": "node tools/test-native-runtime.mjs",
    "test:native-performance": "node tools/test-native-performance.mjs",
    "test:native-terminal-performance": "python3 tools/test-native-terminal-performance.py",
    "test:native-package": "node tools/test-native-package.mjs",
    "test:native-controls": "node tools/test-native-controls.mjs",
    "test:owned-host-controls": "node tools/test-owned-host-controls.mjs",
    "test:owned-visual-clear-env": "python3 tools/test-owned-visual-clear-env.py",
    "test:native-terminal-semantics": "python3 tools/native-terminal-semantics.py",
    "test:native-glyph-pty": "node tools/test-native-glyph-pty.mjs",
    "test:native-outcomes": "node tools/test-native-outcomes.mjs",
    "test:native-pty": "node tools/test-native-pty.mjs",
    "test:owned-opencode": "node tools/test-owned-opencode-runtime.mjs",
    "build": "npm run check && npm run typecheck",
    "test": "node --test tests/*.test.mjs",
    "test:python": "node tools/test-python.mjs",
    "test:native-slash-commands": "node tools/test-native-slash-commands.mjs"
  },
  "dependencies": {
    "@opencode/cli": "2.0.32",
    "@opencode/client": "2.0.32",
    "@opencode/plugin": "2.0.32",
    "@opencode/theme": "2.0.32",
    "@opentui/core": "0.5.17",
    "@opentui/solid": "0.5.17",
    "express": "^5.2.1",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "solid-js": "1.9.12",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "0.25.10",
    "web-tree-sitter-legacy": "npm:web-tree-sitter@0.22.6"
  },
  "overrides": {
    "seroval": "1.6.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.3.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.57.0"
  },
  "allowScripts": {
    "@opencode/cli@2.0.32": true
  }
}
